# Entorno de MANTENIMIENTO de una instalación. Solo para --migrar-seguridad en una ventana de
# mantenimiento, con el servicio detenido. No lo usa el servicio zuni@.service.
# Copiar a /etc/zuni/institucion-a-migracion.env: propietario root:root, permisos 600.
# Retirar o vaciar la contraseña cuando termine el mantenimiento.
ASPNETCORE_ENVIRONMENT=Production
# Deben coincidir EXACTAMENTE con el entorno de ejecución (mismas claves e instalación).
Zuni__InstallationId=institucion-a
DataProtection__KeysPath=/var/lib/zuni/institucion-a/dataprotection
SeguridadClinica__ClavesPath=/var/lib/zuni/institucion-a/seguridad/claves.json
SeguridadClinica__BitacoraPath=/var/lib/zuni/institucion-a/auditoria/bitacora.jsonl
# Usuario PostgreSQL de MIGRACIÓN (propietario de las tablas).
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=5432;Database=zuni_institucion_a;Username=zuni_institucion_a_migrador;Password=REEMPLAZAR;SSL Mode=Disable"
