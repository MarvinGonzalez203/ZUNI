PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=zuni_institucion_a
# El respaldo usa el usuario de ejecución (tiene SELECT sobre todas las tablas).
PGUSER=zuni_institucion_a_app
PGPASSFILE=/var/lib/zuni/institucion-a/backup.pgpass
# El .pgpass real contiene host:puerto:base:usuario:contraseña,
# pertenece al usuario del servicio y tiene permisos 600.
