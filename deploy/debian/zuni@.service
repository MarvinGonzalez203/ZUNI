[Unit]
Description=ZUNI - instalacion %i
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=zuni-%i
Group=zuni-%i
WorkingDirectory=/opt/zuni/%i/current
ExecStart=/usr/bin/dotnet /opt/zuni/%i/current/Zuni.dll
EnvironmentFile=/etc/zuni/%i.env
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zuni/%i

[Install]
WantedBy=multi-user.target
