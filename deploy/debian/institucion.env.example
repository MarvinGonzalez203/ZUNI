# Reemplazar valores en el servidor. Archivo real root:root, permisos 600.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5101
Zuni__InstallationId=institucion-a
Zuni__ProxyInverso=true
AllowedHosts=zuni.lat
DataProtection__KeysPath=/var/lib/zuni/institucion-a/keys
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=5432;Database=zuni_institucion_a;Username=zuni_institucion_a;Password=REEMPLAZAR;SSL Mode=Disable"
