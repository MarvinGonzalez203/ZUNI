# Entorno de EJECUCIÓN de una instalación (servicio zuni@institucion-a).
# Copiar a /etc/zuni/institucion-a.env en el servidor: propietario root:root, permisos 600.
# No contiene secretos reales: reemplazar cada marcador en el servidor, nunca en el repositorio.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5101
# Identificador único de la instalación. Separa cookie, Data Protection y cifrado clínico.
# No cambiarlo después de la puesta en marcha: los datos cifrados dejarían de poder leerse.
Zuni__InstallationId=institucion-a
Zuni__ProxyInverso=true
AllowedHosts=zuni.lat
# Datos persistentes aislados bajo /var/lib/zuni/<instalación>/ (única ruta escribible del servicio).
DataProtection__KeysPath=/var/lib/zuni/institucion-a/dataprotection
SeguridadClinica__ClavesPath=/var/lib/zuni/institucion-a/seguridad/claves.json
SeguridadClinica__BitacoraPath=/var/lib/zuni/institucion-a/auditoria/bitacora.jsonl
# Usuario PostgreSQL de EJECUCIÓN (restringido). Nunca usar aquí el usuario de migraciones.
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=5432;Database=zuni_institucion_a;Username=zuni_institucion_a_app;Password=REEMPLAZAR;SSL Mode=Disable"
