@model Zuni.Models.Atencion.MiSolicitudConsulta
@{ViewData["Title"]="Mi solicitud de atención";}
<header class="dash-profile-heading"><div><h1>@Idioma.Texto("Mi solicitud de atención")</h1><p>@Idioma.Texto("Consulta tu estado y lo que necesitas para solicitar una cita.")</p></div></header>
<section class="dash-card mb-4">
@if(Model.Solicitud is {}s){<h2>@Idioma.Texto("Estado:") @Idioma.Texto(Convert.ToString(s.Estado))</h2><p>@Idioma.Texto("Registrada el") @Zuni.Services.Agenda.AgendaReglas.Local(s.FechaSolicitudUtc).ToString("dd/MM/yyyy HH:mm") (Guatemala).</p><p>@(s.Estado==Zuni.Models.Atencion.EstadoSolicitudAtencion.Pendiente?Idioma.Texto("La institución está revisando la asignación de tu solicitud."):s.Estado==Zuni.Models.Atencion.EstadoSolicitudAtencion.Asignada?Idioma.Texto("La solicitud está asignada para atención."):Idioma.Texto("Esta solicitud está cerrada. Puedes iniciar una nueva cuando necesites acompañamiento."))</p>}
else{<h2>@Idioma.Texto("Aún no tienes una solicitud registrada")</h2><p>@Idioma.Texto("Un vínculo administrativo con un psicólogo no sustituye la solicitud y el consentimiento de atención.")</p>}
<p>@Idioma.Texto("Profesional vinculado:") <strong>@(Model.Psicologo??Idioma.Texto("Pendiente de asignación"))</strong></p>
<h2>@Idioma.Texto("Antes de reservar")</h2><ul><li>@Idioma.Texto("Perfil:") @(Model.PerfilCompleto?"completo":Idioma.Texto("completa tus datos en Mi cuenta")).</li><li>@Idioma.Texto("Mayoría de edad:") @(Model.EdadVerificada?"verificada":Idioma.Texto("pendiente de revisión institucional")).</li><li>@Idioma.Texto("Asignación:") @(Model.Psicologo is null?Idioma.Texto("requiere un psicólogo vinculado y disponible"):Idioma.Texto("tienes un psicólogo vinculado; su disponibilidad se consulta en Citas")).</li></ul>
<div class="d-flex flex-wrap gap-3"><a asp-controller="MiCuenta" asp-action="Editar" class="dash-button">@Idioma.Texto("Revisar mis datos")</a><a asp-controller="MayoriaEdad" asp-action="Index" class="btn btn-outline-secondary">@Idioma.Texto("Verificación de edad")</a><a asp-action="SolicitarAtencion" class="btn btn-outline-secondary">@(Model.Solicitud is null||Model.Solicitud.Estado==Zuni.Models.Atencion.EstadoSolicitudAtencion.Cerrada?Idioma.Texto("Solicitar atención"):"Consultar solicitud activa")</a><a asp-action="Citas" class="btn btn-outline-secondary">@Idioma.Texto("Volver a mis citas")</a></div></section>
