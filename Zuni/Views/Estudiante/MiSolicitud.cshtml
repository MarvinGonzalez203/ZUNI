@model Zuni.Models.Atencion.MiSolicitudConsulta
@{ViewData["Title"]="Mi solicitud de atención";}
<header class="dash-profile-heading"><div><h1>Mi solicitud de atención</h1><p>Consulta tu estado y lo que necesitas para solicitar una cita.</p></div></header>
<section class="dash-card mb-4">
@if(Model.Solicitud is {}s){<h2>Estado: @s.Estado</h2><p>Registrada el @Zuni.Services.Agenda.AgendaReglas.Local(s.FechaSolicitudUtc).ToString("dd/MM/yyyy HH:mm") (Guatemala).</p><p>@(s.Estado==Zuni.Models.Atencion.EstadoSolicitudAtencion.Pendiente?"La institución está revisando la asignación de tu solicitud.":s.Estado==Zuni.Models.Atencion.EstadoSolicitudAtencion.Asignada?"La solicitud está asignada para atención.":"Esta solicitud está cerrada. Puedes iniciar una nueva cuando necesites acompañamiento.")</p>}
else{<h2>Aún no tienes una solicitud registrada</h2><p>Un vínculo administrativo con un psicólogo no sustituye la solicitud y el consentimiento de atención.</p>}
<p>Profesional vinculado: <strong>@(Model.Psicologo??"Pendiente de asignación")</strong></p>
<h2>Antes de reservar</h2><ul><li>Perfil: @(Model.PerfilCompleto?"completo":"completa tus datos en Mi cuenta").</li><li>Mayoría de edad: @(Model.EdadVerificada?"verificada":"pendiente de revisión institucional").</li><li>Asignación: @(Model.Psicologo is null?"requiere un psicólogo vinculado y disponible":"tienes un psicólogo vinculado; su disponibilidad se consulta en Citas").</li></ul>
<div class="d-flex flex-wrap gap-3"><a asp-controller="MiCuenta" asp-action="Editar" class="dash-button">Revisar mis datos</a><a asp-controller="MayoriaEdad" asp-action="Index" class="btn btn-outline-secondary">Verificación de edad</a><a asp-action="SolicitarAtencion" class="btn btn-outline-secondary">@(Model.Solicitud is null||Model.Solicitud.Estado==Zuni.Models.Atencion.EstadoSolicitudAtencion.Cerrada?"Solicitar atención":"Consultar solicitud activa")</a><a asp-action="Citas" class="btn btn-outline-secondary">Volver a mis citas</a></div></section>
