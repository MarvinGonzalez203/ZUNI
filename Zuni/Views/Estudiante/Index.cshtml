@model EstudianteDashboardViewModel
@{
    ViewData["Title"] = "Tablero";
    ViewData["DashboardName"] = Model.Nombre;
    var primero = Model.Nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Estudiante";
    var nombre = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(primero.ToLower());
    var perfilController = Model.PerfilCompleto ? "Estudiante" : "Perfil";
    var perfilAction = Model.PerfilCompleto ? "MiPerfil" : "Completar";
}
<header class="dash-welcome">
    <div class="dash-welcome-copy">
        <span class="dash-eyebrow">BIENVENIDO A TU ESPACIO</span>
        <h1>Hola, @nombre<span class="dash-greeting-dot">.</span></h1>
        <p>Este es tu espacio en ZUNI. Consulta tu información y accede a los servicios disponibles.</p>
        <div class="dash-welcome-actions">
            <a class="dash-button" asp-controller="@perfilController" asp-action="@perfilAction">@(Model.PerfilCompleto ? "Ver mi perfil" : "Completar mi perfil") <partial name="_DashboardIcon" model='@("arrow")' /></a>
            <span class="dash-profile-status">Perfil: @(Model.PerfilCompleto ? "Completo" : "Incompleto")</span>
        </div>
    </div>
    <div class="dash-welcome-art" aria-hidden="true"><div class="dash-glass-orbit"></div><div class="dash-glass-orbit orbit-small"></div><img src="~/images/zuni-logo-transparent.png" alt="" /><span>Conecta contigo.</span></div>
</header>

<div class="dash-section-heading"><h2>Tu espacio, de un vistazo</h2><span>Todo en un solo lugar</span></div>
<section class="dash-summary-grid" aria-label="Resumen de servicios">
    <a class="dash-card dash-summary dash-summary-profile dash-card-link" asp-controller="Estudiante" asp-action="MiPerfil" aria-label="Ver mi perfil">
        <div class="dash-summary-top"><span class="dash-icon-tile"><partial name="_DashboardIcon" model='@("user")' /></span><span class="dash-eyebrow">MI PERFIL</span></div>
        <h3>@(Model.PerfilCompleto ? "Completo" : "Incompleto")</h3>
        <p>@(Model.PerfilCompleto ? "Tus datos básicos están completos." : "Completa tus datos académicos y de contacto.")</p>
        <span class="dash-text-link">Ver perfil <partial name="_DashboardIcon" model='@("arrow")' /></span>
    </a>
    @foreach (var item in new[] { ("clipboard", "EVALUACIONES", "Desde aquí podrás realizar tus evaluaciones.", "Evaluaciones"), ("results", "RESULTADOS", "Disponibles cuando se integre este módulo.", "Resultados"), ("calendar", "CITAS", "Podrás consultar o solicitar tus citas.", "Citas") })
    {
        <a class="dash-card dash-summary dash-card-link" asp-controller="Estudiante" asp-action="@item.Item4" aria-label="@item.Item4">
            <div class="dash-summary-top"><span class="dash-icon-tile"><partial name="_DashboardIcon" model="item.Item1" /></span><span class="dash-eyebrow">@item.Item2</span></div>
            <h3>Próximamente</h3><p>@item.Item3</p><span class="dash-module-label">En preparación</span>
        </a>
    }
</section>

<section class="dash-card dash-evaluations" aria-labelledby="evaluaciones-title">
    <div class="dash-section-heading"><div><h2 id="evaluaciones-title">Resumen de mis evaluaciones</h2><p>Un espacio para conocer tu recorrido.</p></div><span class="dash-badge">Próximamente</span></div>
    <div class="dash-chart-placeholder">
        <div class="dash-empty-symbol" aria-hidden="true"><span></span><span></span><partial name="_DashboardIcon" model='@("spark")' /></div>
        <h3>Tu recorrido comienza contigo</h3>
        <p>Tus resultados aparecerán aquí cuando completes tus evaluaciones.</p>
        <small>Este módulo estará disponible próximamente.</small>
    </div>
</section>

<div class="dash-section-heading"><h2>Tu información</h2><a class="dash-text-link" asp-action="MiPerfil">Ver mi perfil <partial name="_DashboardIcon" model='@("arrow")' /></a></div>
<partial name="_DatosPerfil" model="Model.DatosPerfil" />

<div class="dash-section-heading"><h2>Servicios para tu bienestar</h2><span>A tu ritmo</span></div>
<section class="dash-services" aria-label="Próximos servicios">
    @foreach (var item in new[] { ("clipboard", "Evaluaciones", "Un espacio para realizar las evaluaciones que se habiliten para ti.", "Evaluaciones"), ("results", "Resultados", "Consulta tus resultados cuando el módulo esté disponible.", "Resultados"), ("calendar", "Citas psicológicas", "Solicita y consulta citas cuando se integre el servicio.", "Citas") })
    {
        <a class="dash-card dash-service dash-card-link" asp-controller="Estudiante" asp-action="@item.Item4"><span class="dash-icon-tile"><partial name="_DashboardIcon" model="item.Item1" /></span><h3>@item.Item2</h3><p>@item.Item3</p><span class="dash-badge">Próximamente</span></a>
    }
</section>
