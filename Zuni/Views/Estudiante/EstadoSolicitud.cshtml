@model Zuni.Models.Atencion.EstadoSolicitudViewModel
@using Zuni.Models.Atencion
@{ ViewData["Title"] = "Solicitud de atención"; }
<header class="dash-profile-heading"><div><span class="dash-eyebrow">@Idioma.Texto("TU ACOMPAÑAMIENTO")</span><h1>@Idioma.Texto("Solicitud de atención")</h1><p>@Idioma.Texto("Tu solicitud ya está registrada. No necesitas enviar otra.")</p></div></header>
<section class="dash-card" aria-labelledby="estado-title">
    <div class="dash-summary-top"><span class="dash-icon-tile"><partial name="_DashboardIcon" model='@("shield")' /></span><h2 id="estado-title">@Idioma.Texto("Estado de tu solicitud")</h2></div>
    <p class="mt-3">@Idioma.Texto("Estado:") <strong class="dash-badge">@Idioma.Texto(Convert.ToString(Model.Estado))</strong></p>
    <p>@Idioma.Texto("Fecha de solicitud (UTC):") <time datetime="@Model.FechaSolicitudUtc.ToString("O")">@Model.FechaSolicitudUtc.ToString("dd/MM/yyyy HH:mm")</time></p>
    <p>@(Model.Estado == EstadoSolicitudAtencion.Pendiente ? Idioma.Texto("Tu solicitud está pendiente de asignación.") : Idioma.Texto("Tu solicitud fue asignada para atención."))</p>
    <div class="d-flex flex-wrap gap-3 mt-4">
        <a class="dash-button" asp-controller="Estudiante" asp-action="Index">@Idioma.Texto("Volver al tablero")</a>
        <a class="dash-button" asp-controller="MiCuenta" asp-action="Index">@Idioma.Texto("Mi cuenta")</a>
    </div>
</section>
