@model IReadOnlyList<Zuni.Models.Evaluaciones.ResultadoEstudianteViewModel>
@{ViewData["Title"]="Mis resultados";}
<h1>Mis resultados</h1><p>Solo se muestran resultados de tu cuenta autorizados para publicación.</p>
@if(Model.Count==0){<section class="dash-card"><p>Todavía no tienes evaluaciones finalizadas.</p></section>}
@foreach(var r in Model){<article class="dash-card mb-3"><h2>@r.Titulo</h2>@if(r.EsDemostracion){<p class="dash-badge">Demostración · sin interpretación clínica</p>}<p>Finalizada: @r.FechaFinalizacionUtc?.ToString("dd/MM/yyyy HH:mm") UTC</p>@if(r.Publicado){@if(r.Puntuacion.HasValue){<p>Puntuación: @r.Puntuacion</p>}<p>@r.Observaciones</p>}else{<p>Resultado pendiente de publicación</p>}</article>}
