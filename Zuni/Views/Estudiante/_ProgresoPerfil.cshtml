@model MiPerfilViewModel
<section class="dash-card student-progress" aria-labelledby="progreso-title">
    <div class="dash-section-heading">
        <h2 id="progreso-title">@(Model.CamposCompletados == Model.TotalCamposRequeridos ? "Datos requeridos completos" : "Datos requeridos pendientes")</h2>
        <span class="dash-badge">@Model.PorcentajeAvance% completado</span>
    </div>
    <label for="datos-progreso">@Model.CamposCompletados de @Model.TotalCamposRequeridos datos requeridos</label>
    <progress id="datos-progreso" value="@Model.CamposCompletados" max="@Model.TotalCamposRequeridos" aria-describedby="datos-progreso-ayuda">@Model.PorcentajeAvance%</progress>
    <p id="datos-progreso-ayuda">Este porcentaje indica únicamente si registraste tu carné, teléfono y carrera. Los datos opcionales no afectan el avance.</p>
    @if (Model.CamposRequeridosFaltantes.Count > 0)
    {
        <h3>Datos que faltan</h3>
        <ul>@foreach (var campo in Model.CamposRequeridosFaltantes) { <li>@campo</li> }</ul>
        <a class="dash-button" asp-controller="MiCuenta" asp-action="Editar">Completar mis datos</a>
    }
    @if (Model.CamposOpcionalesFaltantes.Count > 0)
    {
        <details class="student-optional">
            <summary>Datos opcionales pendientes (@Model.CamposOpcionalesFaltantes.Count)</summary>
            <ul>@foreach (var campo in Model.CamposOpcionalesFaltantes) { <li>@campo</li> }</ul>
            <a class="dash-text-link" asp-controller="MiCuenta" asp-action="Editar">Editar mis datos</a>
        </details>
    }
</section>
