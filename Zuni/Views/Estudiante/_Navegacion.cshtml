@{
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var enBigFive = ViewContext.RouteData.Values["controller"]?.ToString() == "BigFive";
}
<nav class="dash-nav" aria-label="Navegación del estudiante">
    <span class="dash-nav-label">MI ESPACIO</span>
    <a class="dash-nav-link @(accion == "Index" && !enBigFive ? "is-active" : "")" asp-controller="Estudiante" asp-action="Index" aria-current="@(accion == "Index" && !enBigFive ? "page" : null)"><partial name="_DashboardIcon" model='@("grid")' /><span>Tablero</span></a>
    <a class="dash-nav-link" asp-controller="MiCuenta" asp-action="Index"><partial name="_DashboardIcon" model='@("user")' /><span>Mi cuenta</span></a>
    <span class="dash-nav-label dash-nav-label-spaced">SERVICIOS</span>
    <a class="dash-nav-link @(accion == "SolicitarAtencion" ? "is-active" : "")" asp-controller="Estudiante" asp-action="SolicitarAtencion" aria-current="@(accion == "SolicitarAtencion" ? "page" : null)"><partial name="_DashboardIcon" model='@("shield")' /><span>@await Component.InvokeAsync("EtiquetaSolicitud")</span></a>
    @foreach (var item in new[] { ("clipboard", "Evaluaciones"), ("results", "Resultados"), ("calendar", "Citas") })
    {
        var activo = accion == item.Item2 || (enBigFive && item.Item2 == "Evaluaciones");
        <a class="dash-nav-link @(activo ? "is-active" : "")" asp-controller="Estudiante" asp-action="@item.Item2" aria-current="@(activo ? "page" : null)"><partial name="_DashboardIcon" model="item.Item1" /><span>@item.Item2<small>@(item.Item2 == "Evaluaciones" ? "Big Five · opcional" : "Próximamente")</small></span></a>
    }
</nav>
