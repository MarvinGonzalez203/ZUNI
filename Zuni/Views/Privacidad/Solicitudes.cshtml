@model IReadOnlyList<Zuni.Models.Privacidad.SolicitudDerechoDatos>
@{ ViewData["Title"] = "Solicitudes sobre datos personales"; var pagina = (int)ViewData["Pagina"]!; var paginas = (int)ViewData["Paginas"]!; }
<h1>Solicitudes sobre datos personales</h1>
@foreach (var tipo in new[] { "Success", "Error" }) { if (TempData[tipo] is string m) { <p class="dash-notice" role="status">@m</p> } }
<section class="dash-card p-4"><p>Este trámite no permite abrir expedientes ni consultar notas profesionales. Verifica la petición y registra la respuesta o el procedimiento acordado.</p>
<div class="table-responsive"><table class="table"><thead><tr><th>Comprobante</th><th>Tipo</th><th>Estado</th><th>Acción</th></tr></thead><tbody>
@foreach (var s in Model) { <tr><td>@s.Id</td><td>@s.Tipo</td><td>@s.Estado</td><td><a asp-action="Responder" asp-route-id="@s.Id">Consultar y responder</a></td></tr> }
</tbody></table></div><p>Página @pagina de @paginas</p>
@if (pagina > 1) { <a asp-action="Solicitudes" asp-route-pagina="@(pagina - 1)">Anterior</a> }
@if (pagina < paginas) { <a asp-action="Solicitudes" asp-route-pagina="@(pagina + 1)">Siguiente</a> }</section>
