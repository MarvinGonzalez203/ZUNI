@model IReadOnlyList<Zuni.Models.Privacidad.SolicitudDerechoDatos>
@{ ViewData["Title"] = "Solicitudes sobre datos personales"; var pagina = (int)ViewData["Pagina"]!; var paginas = (int)ViewData["Paginas"]!; }
<h1>@Idioma.Texto("Solicitudes sobre datos personales")</h1>
@foreach (var tipo in new[] { "Success", "Error" }) { if (TempData[tipo] is string m) { <p class="dash-notice" role="status">@Idioma.Texto(m)</p> } }
<section class="dash-card p-4"><p>@Idioma.Texto("Este trámite no permite abrir expedientes ni consultar notas profesionales. Verifica la petición y registra la respuesta o el procedimiento acordado.")</p>
<div class="table-responsive"><table class="table"><thead><tr><th>@Idioma.Texto("Comprobante")</th><th>@Idioma.Texto("Tipo")</th><th>@Idioma.Texto("Estado")</th><th>@Idioma.Texto("Acción")</th></tr></thead><tbody>
@foreach (var s in Model) { <tr><td>@s.Id</td><td>@Idioma.Texto(Convert.ToString(s.Tipo))</td><td>@Idioma.Texto(Convert.ToString(s.Estado))</td><td><a asp-action="Responder" asp-route-id="@s.Id">@Idioma.Texto("Consultar y responder")</a></td></tr> }
</tbody></table></div><p>@Idioma.Texto("Página") @pagina @Idioma.Texto("de") @paginas</p>
@if (pagina > 1) { <a asp-action="Solicitudes" asp-route-pagina="@(pagina - 1)">@Idioma.Texto("Anterior")</a> }
@if (pagina < paginas) { <a asp-action="Solicitudes" asp-route-pagina="@(pagina + 1)">@Idioma.Texto("Siguiente")</a> }</section>
