@model Zuni.Models.Agenda.LugarCitaInput
@{ViewData["Title"]="Lugar de atención presencial";}
<header class="dash-profile-heading"><div><h1>@Idioma.Texto("Lugar de atención presencial")</h1><p>@Model.Estudiante · @Zuni.Services.Agenda.AgendaReglas.Local(Model.InicioUtc).ToString("dd/MM/yyyy HH:mm") (Guatemala)</p></div></header>
<form method="post" class="dash-card"><input asp-for="CitaId" type="hidden"/><input asp-for="Revision" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><label asp-for="DireccionAtencion" class="form-label"></label><textarea asp-for="DireccionAtencion" class="form-control mb-3" rows="3" maxlength="500" required></textarea><p>@Idioma.Texto("Indica dirección, edificio, consultorio y referencias necesarias para llegar. El estudiante recibirá una notificación con el lugar.")</p><div class="zuni-action-row"><button class="dash-button" name="ConfirmarCita" value="false">@Idioma.Texto("Guardar ubicación")</button>@if(Model.Estado==Zuni.Models.Agenda.EstadoCita.Solicitada){<button class="btn btn-outline-primary" name="ConfirmarCita" value="true">@Idioma.Texto("Guardar lugar y confirmar cita")</button>}<a asp-controller="Psicologo" asp-action="Agenda" class="btn btn-outline-secondary">@Idioma.Texto("Volver a mi agenda")</a></div></form>
