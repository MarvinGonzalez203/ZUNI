@model Zuni.Models.BigFive.EstadoBigFiveViewModel
@using Zuni.Resources
@using Zuni.Services.BigFive
@{ ViewData["Title"] = "Big Five"; }
@section Styles { <link rel="stylesheet" href="~/css/bigfive-apoyo.css" asp-append-version="true" /> }
<div class="bf-module">
<header class="dash-profile-heading"><div><span class="dash-eyebrow">@Idioma.Texto("PARTICIPACIÓN VOLUNTARIA")</span><h1>@Idioma.Texto("Big Five")</h1><p>@Idioma.Texto("Herramienta opcional de apoyo · 50 afirmaciones ·") @Ipip50.Version</p></div></header>
<partial name="_Limitaciones" />
@if (TempData["BigFiveError"] is string error) { <p class="dash-notice" role="alert">@Idioma.Texto(error)</p> }
@if (TempData["BigFiveSuccess"] is string success) { <p class="dash-notice" role="status">@Idioma.Texto(success)</p> }
@if (Model.Id is Guid id)
{
    <section class="dash-card">
        @if (Model.FechaRetiroConsentimientoUtc != null)
        {
            <h2>@Idioma.Texto("Participación retirada")</h2><p>@Idioma.Texto("El cuestionario y la consulta del resumen están suspendidos desde") @Model.FechaRetiroConsentimientoUtc?.ToString("dd/MM/yyyy HH:mm") UTC.</p>
            <p>@Idioma.Texto("Los datos registrados no se borran automáticamente. Tu solicitud y atención permanecen independientes.")</p>
        }
        else if (Model.FechaFinalizacionUtc != null)
        {
            <h2>@Idioma.Texto("Cuestionario completado")</h2>
            <dl><dt>@Idioma.Texto("Fecha (UTC)")</dt><dd>@Model.FechaFinalizacionUtc?.ToString("dd/MM/yyyy HH:mm")</dd><dt>@Idioma.Texto("Versión")</dt><dd>@Model.VersionInstrumento</dd><dt>@Idioma.Texto("Comprobante")</dt><dd class="text-break">@id</dd></dl>
            <p>@Idioma.Texto("Las respuestas están cerradas. El resumen solo podrá consultarlo el psicólogo autorizado.")</p>
        }
        else if (Model.PuedeResponder)
        {
            <h2>@Idioma.Texto("Tu avance")</h2><p>@Idioma.Texto("Puedes guardar tus respuestas y continuar más tarde.")</p>
            <a class="dash-button" asp-action="Cuestionario" asp-route-id="@id">@Idioma.Texto("Continuar cuestionario")</a>
        }
        else { <h2>@Idioma.Texto("Participación no disponible para responder")</h2><p>@Idioma.Texto("Necesitas que la solicitud asociada siga activa. No se creará otra participación automáticamente.")</p> }
        <details class="bf-details"><summary>@Idioma.Texto("Consentimiento que aceptaste")</summary><p>@Idioma.Texto("Fecha:") @Model.FechaConsentimientoUtc?.ToString("dd/MM/yyyy HH:mm") UTC.</p><p>@Model.TextoConsentimiento</p></details>
        @if (Model.FechaRetiroConsentimientoUtc == null)
        {
            <details class="bf-details"><summary>@Idioma.Texto("Retirar participación Big Five")</summary>
                <p>@Idioma.Texto("Se impedirán nuevas respuestas y la consulta del resumen. No cancela tu atención y no elimina automáticamente datos ya registrados.")</p>
                <form asp-action="Retirar" method="post"><input type="hidden" name="id" value="@id" /><button type="submit" class="dash-button">@Idioma.Texto("Confirmar retiro del consentimiento")</button></form>
            </details>
        }
    </section>
}
else if (!Model.MayoriaEdadVerificada)
{
    <section class="dash-card"><h2>@Idioma.Texto("Verificación de mayoría de edad pendiente")</h2><p>@Idioma.Texto("La institución debe revisar tu documento antes de participar. Big Five continúa siendo opcional.")</p><a class="dash-button" asp-controller="MayoriaEdad" asp-action="Index">@Idioma.Texto("Consultar mi verificación")</a></section>
}
else if (!Model.TieneSolicitudActiva)
{
    <section class="dash-card"><h2>@Idioma.Texto("Primero, tu solicitud de atención")</h2><p>@Idioma.Texto("Para participar necesitas una solicitud activa. No necesitas tener psicólogo asignado. Completar Big Five nunca es requisito para recibir atención.")</p><a class="dash-button" asp-controller="Estudiante" asp-action="SolicitarAtencion">@Idioma.Texto("Solicitar atención")</a></section>
}
else
{
    <section class="dash-card"><h2>@Idioma.Texto("Antes de comenzar")</h2><p>@ConsentimientoBigFive.Texto</p><p>@Idioma.Texto("Consentimiento:") @ConsentimientoBigFive.Version</p>
        <form asp-action="Aceptar" method="post" class="bf-consent-form">
            <label><input type="checkbox" name="MayorDeEdad" value="true" required /> @Idioma.Texto("Confirmo que tengo 18 años o más.")</label>
            <label><input type="checkbox" name="Acepto" value="true" required /> @Idioma.Texto("Leí y acepto voluntariamente el consentimiento específico Big Five.")</label>
            <button type="submit" class="dash-button">@Idioma.Texto("Aceptar y comenzar")</button>
        </form>
    </section>
}
<a class="dash-text-link bf-back" asp-controller="Estudiante" asp-action="Evaluaciones">@Idioma.Texto("Volver a evaluaciones")</a>
</div>
