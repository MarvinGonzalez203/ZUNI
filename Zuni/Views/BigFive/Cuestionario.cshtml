@model Zuni.Models.BigFive.CuestionarioBigFiveViewModel
@using Zuni.Services.BigFive
@{ ViewData["Title"] = "Cuestionario Big Five"; var items = Ipip50.Orden(Model.Id); }
@section Styles { <link rel="stylesheet" href="~/css/bigfive-apoyo.css" asp-append-version="true" /> }
<div class="bf-module">
<header class="dash-profile-heading"><div><h1>Cuestionario Big Five</h1><p>@Ipip50.Version · Responde según cómo eres habitualmente.</p></div></header>
<partial name="_Limitaciones" />
@if (TempData["BigFiveSuccess"] is string success) { <p class="dash-notice" role="status">@success</p> }
<p>1 = nada, 2 = poco, 3 = en parte, 4 = bastante, 5 = mucho.</p>
<form asp-action="Guardar" method="post" id="bigfive-form">
    <input type="hidden" name="Id" value="@Model.Id" /><input type="hidden" name="Revision" value="@Model.Revision" />
    <div class="bf-progress"><p id="bf-avance" aria-live="polite">@Model.Respuestas.Count de 50 respuestas guardadas</p><progress id="bf-progress" max="50" value="@Model.Respuestas.Count" aria-label="Preguntas respondidas"></progress><p id="bf-pagina" aria-live="polite"></p></div>
    @for (var page = 0; page < 5; page++)
    {
        <section class="bf-page" aria-label="Bloque @(page + 1)">
        @foreach (var item in items.Skip(page * 10).Take(10))
        {
            var itemId = item.Id.ToString("D");
            var valor = Model.Respuestas.GetValueOrDefault(itemId);
            <fieldset class="dash-card bf-question">
                <legend>@(items.ToList().IndexOf(item) + 1). @item.Texto</legend>
                <label class="visually-hidden" for="item-@itemId">Cuánto te describe esta afirmación</label>
                <select id="item-@itemId" name="Respuestas[@itemId]" class="form-select">
                    <option value="">Elige una respuesta</option>
                    @for (var score = 1; score <= 5; score++)
                    {
                        <option value="@score" selected="@(valor == score)">@score — @(score == 1 ? "Nada" : score == 2 ? "Poco" : score == 3 ? "En parte" : score == 4 ? "Bastante" : "Mucho")</option>
                    }
                </select>
            </fieldset>
        }
        </section>
    }
    <div class="bf-actions"><button type="button" id="bf-anterior" class="dash-button" hidden>Anterior</button><button type="button" id="bf-siguiente" class="dash-button" hidden>Siguiente</button><button type="submit" class="dash-button">Guardar avance</button></div>
    <p id="bf-save-status" role="status">Guarda antes de salir. No se guarda automáticamente.</p>
</form>
@if (Model.Respuestas.Count == 50)
{
    <section class="dash-card">
        <h2>Finalizar respuestas guardadas</h2><p>Al finalizar no podrás cambiar respuestas. Si editaste una respuesta, guarda primero.</p>
        <form asp-action="Finalizar" method="post" id="bf-finalizar">
            <input type="hidden" name="Id" value="@Model.Id" /><input type="hidden" name="Revision" value="@Model.Revision" />
            <label class="bf-confirm"><input type="checkbox" name="Confirmado" value="true" required /> Confirmo que deseo finalizar las 50 respuestas guardadas.</label>
            <button type="submit" class="dash-button">Confirmar y finalizar</button>
        </form>
    </section>
}
<a class="dash-text-link bf-back" asp-action="Index">Información y retiro del consentimiento</a>
</div>
@section Scripts { <script src="~/js/bigfive-apoyo.js" asp-append-version="true"></script> }
