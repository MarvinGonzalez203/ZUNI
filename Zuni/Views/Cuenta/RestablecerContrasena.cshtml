@model ResetPasswordViewModel
@{ ViewData["Title"] = "Nueva contraseña"; Layout = "_AuthLayout"; }

<div class="auth-icon mb-4">✓</div>
<h1 class="h2 fw-bold mb-2">Crea una contraseña nueva</h1>
<p class="text-secondary mb-4">Elige una contraseña de al menos 8 caracteres.</p>
<form method="post" novalidate>
    <input asp-for="Email" type="hidden" /><input asp-for="Token" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
    <div class="form-floating mb-3"><input asp-for="Password" class="form-control" placeholder="Nueva contraseña" autocomplete="new-password" /><label asp-for="Password"></label><span asp-validation-for="Password" class="text-danger small"></span></div>
    <div class="form-floating mb-4"><input asp-for="ConfirmPassword" class="form-control" placeholder="Confirmar" autocomplete="new-password" /><label asp-for="ConfirmPassword"></label><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
    <button class="btn btn-zuni w-100 btn-lg" type="submit">Actualizar contraseña</button>
</form>
