@model Zuni.Models.Institucion.ConfiguracionInstitucion
@{ ViewData["Title"] = "Solicitar una cuenta"; Layout = "_AuthLayout"; ViewData["Institucion"] = Model; }
<h1>@Idioma.Texto("Solicitar una cuenta")</h1>
<p class="fw-semibold">@Model.Nombre</p>
@if (ViewData["PrivacidadPendiente"] is true) { <p>@Idioma.Texto("La institución debe publicar su política de privacidad antes de habilitar el registro. Contacta al responsable institucional.")</p> }
else { <p>@Idioma.Texto("Esta institución utiliza cuentas creadas por el Administrador. Contacta al responsable institucional para solicitar tu acceso.")</p> }
@if (!string.IsNullOrWhiteSpace(Model.CorreoSoporte))
{
    <p>@Idioma.Texto("Contacto institucional:") <a href="mailto:@Model.CorreoSoporte">@Model.CorreoSoporte</a></p>
}
<a asp-action="IniciarSesion" class="btn btn-zuni">@Idioma.Texto("Volver a iniciar sesión")</a>
