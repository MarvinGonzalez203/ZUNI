@model LoginViewModel
@{ ViewData["Title"] = "Iniciar sesión"; Layout = "_AuthLayout"; }

<a asp-controller="Home" asp-action="Index" class="auth-back">← Volver al inicio</a>
<h1 class="h2 fw-bold mb-2">Bienvenido de nuevo</h1>
<p class="text-secondary mb-4">Ingresa tus datos para continuar en ZUNI.</p>
<form method="post" novalidate class="auth-form-fields">
    <input asp-for="ReturnUrl" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <div class="form-floating mb-3">
        <input asp-for="Email" class="form-control" placeholder="nombre@correo.com" autocomplete="email" />
        <label asp-for="Email"></label><span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="mb-2">
        <div class="form-floating password-field">
            <input asp-for="Password" class="form-control" placeholder="Contraseña" autocomplete="current-password" />
            <label asp-for="Password"></label>
            <button type="button" class="password-toggle" data-password-toggle aria-label="Mostrar contraseña" aria-pressed="false"><span aria-hidden="true">◉</span></button>
        </div>
        <span asp-validation-for="Password" class="text-danger small validation-message"></span>
    </div>
    <div class="auth-options d-flex justify-content-between align-items-center mb-4">
        <div class="form-check"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label"></label></div>
        <a asp-action="RecuperarContrasena" class="link-success small fw-semibold">¿Olvidaste tu contraseña?</a>
    </div>
    <button class="btn btn-zuni w-100 btn-lg" type="submit">Iniciar sesión</button>
</form>
<p class="text-center text-secondary mt-4 mb-0">¿Aún no tienes cuenta? <a asp-action="Registro" class="link-success fw-semibold">Crear cuenta</a></p>
