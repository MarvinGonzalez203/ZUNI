@model CambiarContrasenaObligatoriaViewModel
@{
    ViewData["Title"] = "Cambia tu contraseña";
    Layout = "_AuthLayout";
}
<h1 class="h2 fw-bold mb-2">Cambia tu contraseña</h1>
<p class="text-secondary mb-4">Antes de continuar, elige una contraseña nueva de entre 8 y 100 caracteres, distinta de la actual.</p>
<form asp-action="CambiarContrasenaObligatoria" method="post" class="auth-form-fields">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
    <div class="mb-3">
        <div class="form-floating"><input asp-for="PasswordActual" class="form-control" placeholder="Contraseña actual" autocomplete="current-password" /><label asp-for="PasswordActual"></label></div>
        <span asp-validation-for="PasswordActual" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <div class="form-floating"><input asp-for="Password" class="form-control" placeholder="Nueva contraseña" autocomplete="new-password" maxlength="100" /><label asp-for="Password"></label></div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
    <div class="mb-4">
        <div class="form-floating"><input asp-for="ConfirmPassword" class="form-control" placeholder="Confirmar nueva contraseña" autocomplete="new-password" maxlength="100" /><label asp-for="ConfirmPassword"></label></div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-zuni w-100 btn-lg">Actualizar contraseña</button>
</form>
<form asp-action="CerrarSesion" method="post" class="mt-3">
    <button type="submit" class="btn btn-outline-dark w-100">Cerrar sesión</button>
</form>
