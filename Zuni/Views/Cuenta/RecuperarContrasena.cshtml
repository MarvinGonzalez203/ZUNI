@model ForgotPasswordViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{ ViewData["Title"] = "Recuperar contraseña"; Layout = "_AuthLayout"; }

<a asp-action="IniciarSesion" class="d-inline-flex text-secondary text-decoration-none small mb-4">@Idioma.Texto("← Volver a iniciar sesión")</a>
<div class="auth-icon mb-4">✉</div>
<h1 class="h2 fw-bold mb-2">@Idioma.Texto("Recupera tu contraseña")</h1>
@if (!HostEnvironment.IsDevelopment())
{
    <p class="text-secondary mb-4">@Idioma.Texto("Si necesitas recuperar el acceso, contacta al administrador del sistema.")</p>
}
else
{
<p class="text-secondary mb-4">@Idioma.Texto("Modo desarrollo: genera un enlace de recuperación de prueba. No se envía correo.")</p>
@if (ViewBag.Sent == true)
{
    <div class="alert alert-info">@Idioma.Texto("Solicitud procesada en modo desarrollo. No se ha enviado ningún correo.")</div>
    @if (ViewBag.ResetUrl is not null)
    {
        <div class="alert alert-warning small"><strong>@Idioma.Texto("Modo desarrollo:")</strong> @Idioma.Texto("el envío de correo aún no está configurado.") <a href="@ViewBag.ResetUrl" class="alert-link">@Idioma.Texto("Usar enlace de recuperación")</a>.</div>
    }
}
else
{
    <form method="post" novalidate>
        <div class="form-floating mb-4"><input asp-for="Email" class="form-control" placeholder="@Idioma.Texto("Correo")" autocomplete="email" /><label asp-for="Email"></label><span asp-validation-for="Email" class="text-danger small"></span></div>
        <button class="btn btn-zuni w-100 btn-lg" type="submit">@Idioma.Texto("Generar enlace de prueba")</button>
    </form>
}
}
