@{
    Layout = "_Layout";
    ViewData["BodyClass"] = "auth-page";
}
<div class="auth-shell row g-0 overflow-hidden">
    <aside class="col-lg-5 auth-brand d-none d-lg-flex flex-column justify-content-between p-5 text-white">
        <span class="auth-liquid auth-liquid-one" aria-hidden="true"></span>
        <span class="auth-liquid auth-liquid-two" aria-hidden="true"></span>
        <div class="auth-network" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="auth-brand-spacer" aria-hidden="true"></div>
        <div class="auth-brand-copy">
            <span class="auth-eyebrow">Tu espacio, a tu manera</span>
            <h2>Todo comienza con una cuenta segura.</h2>
            <p>Accede a tus herramientas y mantén tu información disponible cuando la necesites.</p>
            <div class="auth-trust"><span>Privado</span><span>Humano</span><span>Seguro</span></div>
        </div>
        <small class="auth-copyright">© @DateTime.Now.Year ZUNI</small>
    </aside>
    <div class="col-lg-7 auth-panel p-4 p-md-5 d-flex align-items-center">
        <div class="auth-form mx-auto w-100">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("PageScripts", required: false)
}
