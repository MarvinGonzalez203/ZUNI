@model List<Zuni.Models.Pruebas.Prueba>
@{ ViewData["Title"] = "Pruebas"; }
<header class="dash-welcome"><div><span class="dash-eyebrow">DIRECTOR</span><h1>Catálogo de pruebas</h1><p>Prepara instrumentos y asignaciones. El catálogo no contiene respuestas ni historias clínicas.</p></div></header>
<partial name="_Mensaje" />
<section class="dash-card p-4">
    <a class="btn btn-primary mb-3" asp-action="Crear">Crear prueba</a>
    @if (Model.Count == 0) { <p>Aún no hay pruebas. Crea un borrador para comenzar.</p> }
    else
    {
        <div class="table-responsive"><table class="table"><thead><tr><th>Nombre</th><th>Idioma</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
        @foreach (var p in Model)
        {
            <tr><td>@p.Nombre</td><td>@p.Idioma</td><td>@(p.Activa ? "Activa" : "Inactiva")</td><td><a asp-action="Detalle" asp-route-id="@p.Id">Ver prueba</a> · <a asp-action="Asignar" asp-route-id="@p.Id">Asignaciones</a></td></tr>
        }
        </tbody></table></div>
    }
</section>
