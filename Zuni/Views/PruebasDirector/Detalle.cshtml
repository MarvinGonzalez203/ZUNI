@model Zuni.Models.Pruebas.DetallePruebaViewModel
@{ ViewData["Title"] = Model.Prueba.Nombre; var p = Model.Prueba; }
<header class="dash-welcome"><div><a asp-action="Index">← Catálogo</a><h1>@p.Nombre</h1><p>@(p.Activa ? "Activa" : "Inactiva") · @p.Idioma · @Model.Asignaciones asignaciones</p></div></header>
<partial name="_Mensaje" />
@if(p.Subtitulo is not null){<p class="small">@p.Subtitulo</p>}
<section class="dash-card p-4 mb-3">
    <h2>Propósito</h2><p class="text-break" style="white-space:pre-wrap">@p.Descripcion</p>
    <h2>Instrucciones</h2><p class="text-break" style="white-space:pre-wrap">@p.Instrucciones</p>
    <p><strong>Fuente:</strong> @p.Fuente</p>
    <p>La activación habilita asignaciones; la revisión profesional de la pertinencia del instrumento corresponde al equipo responsable.</p>
    <div class="d-flex gap-2 flex-wrap">
        @if (!p.Activa && Model.Asignaciones == 0) { <a class="btn btn-outline-primary" asp-action="Editar" asp-route-id="@p.Id">Editar contenido</a> }
        <a class="btn btn-outline-primary" asp-action="Asignar" asp-route-id="@p.Id">Asignaciones</a>
        <form asp-action="Estado" method="post"><input type="hidden" name="id" value="@p.Id" /><input type="hidden" name="revision" value="@p.Revision" /><input type="hidden" name="activar" value="@((!p.Activa).ToString())" /><button class="btn btn-primary">@(p.Activa ? "Desactivar prueba" : "Activar prueba")</button></form>
    </div>
    @if (Model.Asignaciones > 0) { <p class="mt-3">El contenido se conserva porque ya hay asignaciones. Crea una nueva prueba si necesitas una versión diferente.</p> }
</section>
<section class="dash-card p-4"><h2>Dimensiones y preguntas</h2>
    @if (p.Preguntas.Count == 0) { <p>Este borrador todavía no tiene preguntas.</p> }
    @foreach (var d in p.Dimensiones.OrderBy(x => x.Nombre))
    {
        <h3>@d.Nombre</h3>
        @foreach (var q in p.Preguntas.Where(x => x.DimensionId == d.Id).OrderBy(x => x.Orden))
        {
            <div class="border rounded p-3 mb-3"><h4 class="h6">@q.Orden. @q.Texto</h4><ol>
                @foreach (var o in q.Opciones.OrderBy(x => x.Orden)) { <li>@o.Texto <span class="text-muted">(valor: @o.Valor)</span></li> }
            </ol></div>
        }
    }
</section>
