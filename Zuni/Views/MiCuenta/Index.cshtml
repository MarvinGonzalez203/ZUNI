@model Zuni.Models.MiCuenta.MiCuentaViewModel
@{
    ViewData["Title"] = "Mi cuenta";
    string Mostrar(string? valor) => string.IsNullOrWhiteSpace(valor) ? "Pendiente" : valor;
}
<header class="dash-profile-heading"><div><span class="dash-eyebrow">@Idioma.Texto("TU INFORMACIÓN")</span><h1>@Idioma.Texto("Mi cuenta")</h1><p>@Idioma.Texto("Consulta tus datos y mantén tu información actualizada.")</p></div><a class="dash-button" asp-action="Editar">@Idioma.Texto("Editar mis datos") <partial name="_DashboardIcon" model='@("arrow")' /></a></header>
<section class="dash-card dash-account-card" aria-labelledby="datos-generales">
    <h2 id="datos-generales">@Idioma.Texto("Datos generales")</h2>
    <dl class="dash-account-details">
        <div><dt>@Idioma.Texto("Nombre completo")</dt><dd>@Model.NombreCompleto</dd></div>
        <div><dt>@Idioma.Texto("Correo electrónico")</dt><dd>@Mostrar(Model.Email)</dd></div>
        @if (Model.Roles.Contains("Administrador")) { <div><dt>@Idioma.Texto("Teléfono")</dt><dd>@Mostrar(Model.Telefono)</dd></div> }
        <div><dt>@Idioma.Texto("Roles actuales · Solo lectura")</dt><dd>@(Model.Roles.Count == 0 ? "Sin rol asignado" : string.Join(", ", Model.Roles.Select(r=>Idioma.Texto(r))))</dd></div>
        <div><dt>@Idioma.Texto("Estado de la cuenta · Solo lectura")</dt><dd>@(Model.Activo ? Idioma.Texto("Activo") : Idioma.Texto("Inactivo"))</dd></div>
    </dl>
</section>
@if (Model.EsEstudiante && !Model.PerfilCompleto)
{
    <aside class="dash-notice dash-profile-notice"><p>@Idioma.Texto("Debes completar tus datos estudiantiles.")</p><a class="dash-button" asp-action="Editar">@Idioma.Texto("Completar mis datos")</a></aside>
}
@if (Model.EsEstudiante && Model.Estudiante is { } p)
{
    <div class="dash-detail-grid">
        <section class="dash-card" aria-labelledby="datos-academicos">
            <h2 id="datos-academicos">@Idioma.Texto("Datos académicos")</h2>
            <dl class="dash-details">
                <div><dt>@Idioma.Texto("Carné · Solo lectura")</dt><dd>@Mostrar(Zuni.Helpers.CarneHelper.Formatear(p.Carne))</dd></div>
                <div><dt>@Idioma.Texto("Carrera")</dt><dd>@Mostrar(p.Carrera)</dd></div>
                <div><dt>@Idioma.Texto("Semestre")</dt><dd>@Mostrar(p.Semestre)</dd></div>
                <div><dt>@Idioma.Texto("Ciclo académico")</dt><dd>@Mostrar(p.CicloAcademico)</dd></div>
            </dl>
        </section>
        <section class="dash-card" aria-labelledby="datos-contacto">
            <h2 id="datos-contacto">@Idioma.Texto("Datos de contacto")</h2>
            <dl class="dash-details">
                <div><dt>@Idioma.Texto("Teléfono")</dt><dd>@Mostrar(p.Telefono)</dd></div>
                <div><dt>@Idioma.Texto("Nombre del contacto de emergencia")</dt><dd>@Mostrar(p.NombreContactoEmergencia)</dd></div>
                <div><dt>@Idioma.Texto("Teléfono de emergencia")</dt><dd>@Mostrar(p.TelefonoContactoEmergencia)</dd></div>
                <div><dt>@Idioma.Texto("Relación del contacto")</dt><dd>@Mostrar(p.RelacionContactoEmergencia)</dd></div>
            </dl>
        </section>
    </div>
}
