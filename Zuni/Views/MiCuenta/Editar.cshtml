@model Zuni.Models.MiCuenta.EditarMiCuentaViewModel
@{
    ViewData["Title"] = "Editar datos";
}
<header class="dash-profile-heading"><div><span class="dash-eyebrow">@Idioma.Texto("MI CUENTA")</span><h1>@Idioma.Texto("Editar mis datos")</h1><p>@(Model.PuedeEditarContacto ? Idioma.Texto("Mantén tu nombre, correo y teléfono actualizados. Al cambiar el correo deberás iniciar sesión nuevamente.") : Idioma.Texto("Mantén tu nombre y datos de contacto actualizados."))</p></div></header>
@if (TempData["Error"] is string error)
{
    <div class="dash-notice" role="alert">@Idioma.Texto(error)</div>
}
<form asp-action="Editar" method="post" class="dash-card">
    <input asp-for="Revision" type="hidden" />
    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
    <div class="mb-4">
        <label asp-for="NombreCompleto" class="form-label">@Idioma.Texto("Nombre completo")</label>
        <input asp-for="NombreCompleto" class="form-control" autocomplete="name" maxlength="100" required aria-describedby="nombre-error" />
        <span asp-validation-for="NombreCompleto" id="nombre-error" class="text-danger small"></span>
    </div>
    @if (Model.PuedeEditarContacto)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-6"><label asp-for="Correo" zuni-required="true" class="form-label">@Idioma.Texto("Correo electrónico")</label><input asp-for="Correo" class="form-control" type="email" required maxlength="254" autocomplete="email" /><span asp-validation-for="Correo" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Telefono" class="form-label">@Idioma.Texto("Teléfono (opcional)")</label><input asp-for="Telefono" class="form-control" type="tel" pattern="[0-9]{8}" maxlength="8" autocomplete="tel" inputmode="numeric" /><span asp-validation-for="Telefono" class="text-danger small"></span></div>
        </div>
    }
    @if (Model.PuedeEditarEstudiante)
    {
        <fieldset>
            <legend class="h5 mb-3">@Idioma.Texto("Datos académicos y de contacto")</legend>
            @if (Model.SolicitarCarne)
            {
                <fieldset class="mb-3">
                    <legend class="h6">@Idioma.Texto("Carné institucional · Configuración inicial")</legend>
                    <div class="row g-2">
                        <div class="col-4"><label zuni-required="true" asp-for="CarneParte1" class="form-label">@Idioma.Texto("Primer bloque")</label><input asp-for="CarneParte1" class="form-control" inputmode="numeric" minlength="4" maxlength="4" pattern="[0-9]{4}" placeholder="0000" required /></div>
                        <div class="col-3"><label zuni-required="true" asp-for="CarneParte2" class="form-label">@Idioma.Texto("Segundo bloque")</label><input asp-for="CarneParte2" class="form-control" inputmode="numeric" minlength="2" maxlength="2" pattern="[0-9]{2}" placeholder="00" required /></div>
                        <div class="col-5"><label zuni-required="true" asp-for="CarneParte3" class="form-label">@Idioma.Texto("Tercer bloque")</label><input asp-for="CarneParte3" class="form-control" inputmode="numeric" minlength="2" maxlength="6" pattern="[0-9]{2,6}" placeholder="00 a 000000" required /></div>
                    </div>
                    <span asp-validation-for="CarneParte1" class="text-danger small"></span>
                    <p class="small text-secondary mt-2">@Zuni.Helpers.CarneHelper.MensajeFormato @Idioma.Texto("Una vez registrado no podrás cambiarlo aquí.")</p>
                </fieldset>
            }
            else
            {
                <p>@Idioma.Texto("Carné · Solo lectura:") <strong>@Zuni.Helpers.CarneHelper.Formatear(Model.Estudiante?.Carne)</strong></p>
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Estudiante!.Telefono" class="form-label">@Idioma.Texto("Teléfono personal")</label>
                    <input asp-for="Estudiante!.Telefono" required class="form-control" type="tel" inputmode="numeric" pattern="[0-9]{8}" maxlength="8" autocomplete="tel" />
                    <span asp-validation-for="Estudiante!.Telefono" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Estudiante!.Carrera" class="form-label">@Idioma.Texto("Carrera")</label>
                    <select asp-for="Estudiante!.Carrera" asp-items="Model.Carreras" required class="form-select"><option value="">@Idioma.Texto("Selecciona tu carrera...")</option></select>
                    <span asp-validation-for="Estudiante!.Carrera" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Estudiante!.Semestre" class="form-label">@Idioma.Texto("Semestre")</label>
                    <select asp-for="Estudiante!.Semestre" class="form-select"><option value="">@Idioma.Texto("Seleccione...")</option>@for (var semestre = 1; semestre <= 10; semestre++) { <option value="@semestre">@semestre</option> }</select>
                    <span asp-validation-for="Estudiante!.Semestre" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Estudiante!.CicloAcademico" class="form-label">@Idioma.Texto("Ciclo académico")</label>
                    <select asp-for="Estudiante!.CicloAcademico" class="form-select"><option value="">@Idioma.Texto("Seleccione...")</option><option value="1">1</option><option value="2">2</option></select>
                    <span asp-validation-for="Estudiante!.CicloAcademico" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Estudiante!.NombreContactoEmergencia" class="form-label">@Idioma.Texto("Nombre del contacto de emergencia")</label>
                    <input asp-for="Estudiante!.NombreContactoEmergencia" required class="form-control" maxlength="150" />
                    <span asp-validation-for="Estudiante!.NombreContactoEmergencia" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Estudiante!.TelefonoContactoEmergencia" class="form-label">@Idioma.Texto("Teléfono de emergencia")</label>
                    <input asp-for="Estudiante!.TelefonoContactoEmergencia" required class="form-control" type="tel" inputmode="numeric" pattern="[0-9]{8}" maxlength="8" />
                    <span asp-validation-for="Estudiante!.TelefonoContactoEmergencia" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Estudiante!.RelacionContactoEmergencia" class="form-label">@Idioma.Texto("Relación del contacto")</label>
                    <input asp-for="Estudiante!.RelacionContactoEmergencia" required class="form-control" maxlength="60" />
                    <span asp-validation-for="Estudiante!.RelacionContactoEmergencia" class="text-danger small"></span>
                </div>
            </div>
        </fieldset>
    }
    <div class="d-flex flex-wrap gap-3 align-items-center mt-4">
        <button class="dash-button" type="submit">@Idioma.Texto("Guardar cambios")</button>
        <a class="dash-text-link" asp-action="Index">@Idioma.Texto("Cancelar")</a>
    </div>
</form>
