@model CompletarPerfilEstudianteViewModel
@{
    ViewData["Title"] = "Editar perfil";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["DashboardRole"] = "Estudiante";
    ViewData["DashboardController"] = "Estudiante";
    ViewData["DashboardNavigation"] = "~/Views/Estudiante/_Navegacion.cshtml";
}
@section Styles { <link rel="stylesheet" href="~/css/estudiante.css" asp-append-version="true" /> }

<a asp-controller="Estudiante" asp-action="MiPerfil" class="dash-text-link">← Volver a mi perfil</a>
<section class="dash-card student-profile-editor" aria-labelledby="editar-perfil-title">
<h1 id="editar-perfil-title" class="h2 fw-bold mb-2">Completa o edita tu perfil</h1>
<p class="text-secondary mb-4">Para completar tu perfil necesitas carné, teléfono y carrera. Semestre, ciclo académico y los datos del contacto de emergencia son opcionales. El nombre y correo se conservan en tu cuenta.</p>

<form id="student-profile-form" asp-controller="Perfil" asp-action="Completar" method="post" asp-antiforgery="true" novalidate class="student-profile-form">
    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert" tabindex="-1"></div>

    @if (Model.SolicitarCarne)
    {
        <fieldset class="carne-fieldset mb-3">
            <legend>Carné</legend>
            <div class="carne-segmented">
                <input asp-for="CarneParte1" required class="form-control" aria-label="Primer bloque del carné" placeholder="0000" type="text" inputmode="numeric" maxlength="4" pattern="[0-9]{4}" autocomplete="off" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                <span aria-hidden="true">−</span>
                <input asp-for="CarneParte2" required class="form-control" aria-label="Segundo bloque del carné" placeholder="00" type="text" inputmode="numeric" maxlength="2" pattern="[0-9]{2}" autocomplete="off" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                <span aria-hidden="true">−</span>
                <input asp-for="CarneParte3" required class="form-control" aria-label="Tercer bloque del carné" placeholder="0000" type="text" inputmode="numeric" maxlength="5" pattern="[0-9]{4,5}" autocomplete="off" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
            </div>
            <div class="carne-validation">
                <span asp-validation-for="CarneParte1" class="text-danger small validation-message"></span>
                <span asp-validation-for="CarneParte2" class="text-danger small validation-message"></span>
                <span asp-validation-for="CarneParte3" class="text-danger small validation-message"></span>
            </div>
        </fieldset>
    }

    @if (Model.SolicitarTelefono)
    {
        <div class="form-floating mb-3">
            <input asp-for="Telefono" required class="form-control" placeholder="Teléfono personal" type="tel" autocomplete="tel" inputmode="numeric" maxlength="8" pattern="[0-9]{8}" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
            <label asp-for="Telefono"></label>
            <span asp-validation-for="Telefono" class="text-danger small validation-message"></span>
        </div>
    }

    <div class="form-floating mb-3">
        <input asp-for="Carrera" required maxlength="150" class="form-control" placeholder="Carrera" autocomplete="organization-title" />
        <label asp-for="Carrera"></label>
        <span asp-validation-for="Carrera" class="text-danger small validation-message"></span>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="form-floating">
                <select asp-for="Semestre" class="form-select">
                    <option value="">Seleccione...</option>
                    @for (var semestre = 1; semestre <= 10; semestre++)
                    {
                        <option value="@semestre">@semestre</option>
                    }
                </select>
                <label asp-for="Semestre"></label>
            </div>
            <span asp-validation-for="Semestre" class="text-danger small validation-message"></span>
        </div>
        <div class="col-md-6">
            <div class="form-floating">
                <select asp-for="CicloAcademico" class="form-select">
                    <option value="">Seleccione...</option>
                    <option value="1">1</option>
                    <option value="2">2</option>
                </select>
                <label asp-for="CicloAcademico"></label>
            </div>
            <span asp-validation-for="CicloAcademico" class="text-danger small validation-message"></span>
        </div>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="NombreContactoEmergencia" maxlength="150" class="form-control" placeholder="Nombre del contacto de emergencia" autocomplete="name" />
        <label asp-for="NombreContactoEmergencia"></label>
        <span asp-validation-for="NombreContactoEmergencia" class="text-danger small validation-message"></span>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="TelefonoContactoEmergencia" class="form-control" placeholder="Teléfono de emergencia" type="tel" inputmode="numeric" maxlength="8" pattern="[0-9]{8}" autocomplete="tel" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                <label asp-for="TelefonoContactoEmergencia"></label>
            </div>
            <span asp-validation-for="TelefonoContactoEmergencia" class="text-danger small validation-message"></span>
        </div>
        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="RelacionContactoEmergencia" maxlength="60" class="form-control" placeholder="Relación con el estudiante" />
                <label asp-for="RelacionContactoEmergencia"></label>
            </div>
            <span asp-validation-for="RelacionContactoEmergencia" class="text-danger small validation-message"></span>
        </div>
    </div>

    <p id="profile-save-status" role="status" aria-live="polite">Los cambios se guardan al presionar Guardar perfil.</p>
    <div class="student-action-links">
    <button class="dash-button" type="submit">
        Guardar perfil
    </button>
    <a class="dash-text-link" asp-controller="Estudiante" asp-action="MiPerfil">Cancelar</a>
    </div>
</form>
</section>
@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/estudiante-perfil.js" asp-append-version="true"></script>
}
