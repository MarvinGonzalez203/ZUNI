@{ViewData["Title"]="Administración de ZUNI";}
<header class="dash-profile-heading"><div><span class="dash-eyebrow">@Idioma.Texto("SUPERADMIN")</span><h1>@Idioma.Texto("Administración de ZUNI")</h1><p>@Idioma.Texto("Acceso del proveedor, separado de los roles de atención educativa.")</p></div></header>
<div class="guide-grid"><article class="dash-card"><h2>@Idioma.Texto("Tarifas y periodos")</h2><p>@Idioma.Texto("Administra los precios del servicio para las instituciones educativas.")</p><div class="zuni-action-row"><a class="dash-button" asp-controller="Tarifas" asp-action="Editar">@Idioma.Texto("Editar precios")</a><a class="btn btn-outline-secondary" asp-controller="Tarifas" asp-action="Index">@Idioma.Texto("Ver tarifas")</a></div></article><article class="dash-card"><h2>@Idioma.Texto("Gestión comercial y privacidad")</h2><p>@Idioma.Texto("Esta cuenta se utiliza exclusivamente para los servicios de ZUNI. No permite consultar alumnos, citas, pruebas respondidas, expedientes ni reportes de las instituciones.")</p></article></div>
