@model Zuni.Models.Comercial.CentrosComercialesViewModel
@{ViewData["Title"]="Administración de ZUNI";}
<header class="dash-profile-heading"><div><span class="dash-eyebrow">@Idioma.Texto("SUPERADMIN")</span><h1>@Idioma.Texto("Administración de ZUNI")</h1><p>@Idioma.Texto("Gestiona el servicio de los centros educativos desde un espacio comercial independiente.")</p></div></header>
<div class="dash-summary-grid"><article class="dash-card"><span class="dash-eyebrow">@Idioma.Texto("Centros registrados")</span><p class="display-6">@Model.Total</p></article><article class="dash-card"><span class="dash-eyebrow">@Idioma.Texto("Contratos vigentes")</span><p class="display-6">@Model.Vigentes</p></article><article class="dash-card"><span class="dash-eyebrow">@Idioma.Texto("Vencen en 30 días")</span><p class="display-6">@Model.ProximosAVencer</p></article></div>
<section class="commercial-grid my-4">
<article class="dash-card commercial-card"><partial name="_DashboardIcon" model='@("home")'/><h2>@Idioma.Texto("Centros educativos")</h2><p>@Idioma.Texto("Consulta planes, fechas y estados. Registra renovaciones, ampliaciones o cancelaciones sin acceder a información de estudiantes.")</p><a class="dash-button" asp-action="Centros">@Idioma.Texto("Administrar centros")</a></article>
<article class="dash-card commercial-card"><partial name="_DashboardIcon" model='@("clipboard")'/><h2>@Idioma.Texto("Tarifas y periodos")</h2><p>@Idioma.Texto("Administra los precios del servicio para las instituciones educativas.")</p><div class="zuni-action-row"><a class="dash-button" asp-controller="Tarifas" asp-action="Editar">@Idioma.Texto("Editar precios")</a><a class="btn btn-outline-secondary" asp-controller="Tarifas" asp-action="Index">@Idioma.Texto("Ver tarifas")</a></div></article>
<article class="dash-card commercial-card"><partial name="_DashboardIcon" model='@("book")'/><h2>@Idioma.Texto("Guías y funciones")</h2><p>@Idioma.Texto("Encuentra instrucciones por rol, temas sugeridos y los pasos para utilizar cada función.")</p><a class="dash-button" asp-action="Guias">@Idioma.Texto("Buscar una función")</a></article>
<article class="dash-card commercial-card"><partial name="_DashboardIcon" model='@("shield")'/><h2>@Idioma.Texto("Gestión comercial y privacidad")</h2><p>@Idioma.Texto("Esta cuenta se utiliza exclusivamente para los servicios de ZUNI. No permite consultar alumnos, citas, pruebas respondidas, expedientes ni reportes de las instituciones.")</p><a class="dash-button" asp-controller="Privacidad" asp-action="Index">@Idioma.Texto("Transparencia y protección de datos")</a></article>
</section>
<section><h2 class="h4">@Idioma.Texto("Vigencias próximas")</h2><partial name="_Centros" model="Model" /></section>
