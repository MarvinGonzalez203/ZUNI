@model Zuni.Models.Comercial.EditarCentroInput
@{ViewData["Title"]="Contrato del centro educativo";}
<header class="dash-profile-heading"><div><h1>@Idioma.Texto("Contrato del centro educativo")</h1><p>@Idioma.Texto("Actualiza la vigencia, el plan o el estado. Los cambios quedan registrados en la auditoría comercial.")</p></div></header>
<form method="post" class="dash-card commercial-form">
<input asp-for="Id" type="hidden"/><input asp-for="Revision" type="hidden"/>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" maxlength="150" required/></div>
<div><label asp-for="CorreoContacto" class="form-label"></label><input asp-for="CorreoContacto" class="form-control" type="email" maxlength="254"/></div>
<div class="form-grid"><div><label asp-for="MesesPlan" class="form-label"></label><select asp-for="MesesPlan" class="form-select">@foreach(var n in new[]{1,3,6,12}){<option value="@n">@Idioma.Texto("{0} meses",n)</option>}</select></div><div><label asp-for="ImporteGtq" class="form-label"></label><input asp-for="ImporteGtq" class="form-control" type="number" min="0" max="9999999999.99" step="0.01" required/></div></div>
<div class="form-grid"><div><label asp-for="Inicio" class="form-label"></label><input asp-for="Inicio" type="date" class="form-control" min="2000-01-01" max="2200-12-31" required/></div><div><label asp-for="Fin" class="form-label"></label><input asp-for="Fin" type="date" class="form-control" min="2000-01-01" max="2200-12-31" required/></div></div>
<div><span>@Idioma.Texto("Ampliar desde la fecha final actual:")</span><div class="zuni-action-row mt-2">@foreach(var n in new[]{1,3,6,12}){<button type="button" data-extend-months="@n" class="btn btn-outline-secondary">+ @Idioma.Texto("{0} meses",n)</button>}</div><small>@Idioma.Texto("Revisa la nueva fecha y el importe antes de guardar. Ampliar no cambia el estado automáticamente.")</small></div>
<div><label asp-for="Estado" class="form-label"></label><select asp-for="Estado" class="form-select">@foreach(var e in Enum.GetValues<Zuni.Models.Comercial.EstadoContrato>()){<option value="@e">@Idioma.Texto(e.ToString())</option>}</select></div>
<label><input asp-for="EsDemostracion"/> @Idioma.Texto("Datos de demostración")</label>
<div><label asp-for="NotaComercial" class="form-label"></label><textarea asp-for="NotaComercial" class="form-control" rows="3" maxlength="1000"></textarea><small>@Idioma.Texto("Solo información comercial. No registres nombres de estudiantes, motivos de atención ni notas profesionales.")</small></div>
<div class="zuni-action-row"><button type="submit" class="dash-button">@Idioma.Texto("Guardar contrato")</button><a asp-action="Centros" class="btn btn-outline-secondary">@Idioma.Texto("Volver a centros")</a></div>
</form>
@section Scripts{<script src="~/js/centros.js" asp-append-version="true"></script>}
