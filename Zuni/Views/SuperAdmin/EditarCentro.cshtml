@model Zuni.Models.Comercial.EditarCentroInput
@inject Zuni.Data.ApplicationDbContext Db
@inject TimeProvider Reloj
@{ViewData["Title"]="Contrato del centro educativo";var tarifas=await Zuni.Services.Institucion.TarifasService.Obtener(Db,Context.RequestAborted);var hoy=Zuni.Services.Agenda.AgendaReglas.Hoy(Reloj.GetUtcNow().UtcDateTime);}
<header class="dash-profile-heading"><div><h1>@Idioma.Texto("Contrato del centro educativo")</h1><p>@Idioma.Texto("Actualiza la vigencia, el plan o el estado. Los cambios quedan registrados en la auditoría comercial.")</p></div></header>
@if(Model.Id is {} centroId){<p><a class="btn btn-outline-secondary" asp-action="PdfCentro" asp-route-id="@centroId">@Idioma.Texto("Descargar contrato PDF")</a></p>}
<form method="post" class="dash-card commercial-form" data-contract-plan data-today="@hoy.ToString("yyyy-MM-dd")" data-prices="@System.Text.Json.JsonSerializer.Serialize(new Dictionary<int,decimal>{{1,tarifas.Mensual},{3,tarifas.Trimestral},{6,tarifas.Semestral},{12,tarifas.Anual}})">
<input asp-for="Id" type="hidden"/><input asp-for="Revision" type="hidden"/>
<input asp-for="Renovar" type="hidden"/>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" maxlength="150" required/></div>
<div><label asp-for="CorreoContacto" class="form-label"></label><input asp-for="CorreoContacto" class="form-control" type="email" maxlength="254"/></div>
<div class="form-grid"><div><label asp-for="MesesPlan" class="form-label"></label><select asp-for="MesesPlan" class="form-select">@foreach(var n in new[]{1,3,6,12}){<option value="@n">@Idioma.Texto("{0} meses",n)</option>}</select></div><div><label asp-for="ImporteGtq" class="form-label"></label><input asp-for="ImporteGtq" class="form-control" type="number" step="0.01" readonly required/></div></div>
<div class="form-grid"><div><label asp-for="Inicio" class="form-label"></label><input asp-for="Inicio" type="date" class="form-control" readonly required/></div><div><label asp-for="Fin" class="form-label"></label><input asp-for="Fin" type="date" class="form-control" readonly required/></div></div>
<div><p>@Idioma.Texto("Al crear, cambiar el plan o renovar, la vigencia se calcula desde hoy y el importe corresponde a las tarifas configuradas. El último día está incluido. Editar solo los datos del centro conserva su contrato actual.")</p>@if(Model.Id is not null){<button type="button" data-renew-contract class="btn btn-outline-secondary">@Idioma.Texto("Renovar el periodo seleccionado desde hoy")</button>}</div>
<div><label asp-for="Estado" class="form-label"></label><select asp-for="Estado" class="form-select">@foreach(var e in Enum.GetValues<Zuni.Models.Comercial.EstadoContrato>()){<option value="@e">@Idioma.Texto(e.ToString())</option>}</select></div>
<label><input asp-for="EsDemostracion"/> @Idioma.Texto("Datos de demostración")</label>
<div><label asp-for="NotaComercial" class="form-label"></label><textarea asp-for="NotaComercial" class="form-control" rows="3" maxlength="1000"></textarea><small>@Idioma.Texto("Solo información comercial. No registres nombres de estudiantes, motivos de atención ni notas profesionales.")</small></div>
<div class="zuni-action-row"><button type="submit" class="dash-button">@Idioma.Texto("Guardar contrato")</button><a asp-action="Centros" class="btn btn-outline-secondary">@Idioma.Texto("Volver a centros")</a></div>
</form>
@section Scripts{<script src="~/js/centros.js" asp-append-version="true"></script>}
