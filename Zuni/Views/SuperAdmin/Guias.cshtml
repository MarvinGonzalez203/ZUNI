@model IReadOnlyList<Zuni.Resources.GuiaUso>
@{ViewData["Title"]="Guías y funciones";}
<header class="dash-profile-heading"><div><h1>@Idioma.Texto("Guías y funciones")</h1><p>@Idioma.Texto("Busca por tema o rol. Las instrucciones describen las funciones disponibles sin otorgar acceso a datos de otras cuentas.")</p></div></header>
<form method="get" class="dash-card guide-search mb-4" role="search"><label>@Idioma.Texto("Buscar funciones o pasos")<span class="d-flex gap-2 align-items-center"><svg class="dash-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10" cy="10" r="7"/><path d="m15 15 6 6"/></svg><input type="search" name="q" value="@ViewData["Busqueda"]" class="form-control" list="guia-sugerencias" maxlength="80" placeholder="@Idioma.Texto("Por ejemplo: renovar contrato, privacidad o cuestionario")"/></span></label><label>@Idioma.Texto("Rol")<select name="rol" class="form-select"><option value="">@Idioma.Texto("Todos los roles")</option>@foreach(var rol in new[]{"General","SuperAdmin","Administrador","Director","Psicologo","Estudiante"}){<option value="@rol" selected="@(ViewData["FiltroRol"] as string==rol)">@Idioma.Texto(rol)</option>}</select></label><button class="dash-button" type="submit">@Idioma.Texto("Buscar")</button><a asp-action="Guias" class="btn btn-outline-secondary">@Idioma.Texto("Mostrar todos")</a><datalist id="guia-sugerencias">@foreach(var guia in Zuni.Resources.GuiasUso.Todas){<option value="@Idioma.Texto(guia.Titulo)"></option>}</datalist></form>
@if(Model.Count==0){<p class="dash-notice">@Idioma.Texto("No encontramos ese tema. Prueba con otra palabra o muestra todos los roles.")</p>}
<div class="commercial-grid">@foreach(var guia in Model){<article class="dash-card commercial-card commercial-help"><partial name="_DashboardIcon" model="guia.Icono"/><span class="commercial-badge">@Idioma.Texto(guia.Rol)</span><h2>@Idioma.Texto(guia.Titulo)</h2><p>@Idioma.Texto(guia.Resumen)</p><ol>@foreach(var paso in guia.Pasos){<li>@Idioma.Texto(paso)</li>}</ol><div class="guide-place"><strong>@Idioma.Texto("DÓNDE PULSAR")</strong><p>@Idioma.Texto(guia.Donde)</p></div></article>}</div>
