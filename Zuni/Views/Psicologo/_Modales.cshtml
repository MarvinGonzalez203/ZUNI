<div class="modal fade" id="disponibilidad-modal" tabindex="-1" aria-labelledby="disponibilidad-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content rounded-4">
        <div class="modal-header"><h2 id="disponibilidad-title" class="modal-title h5">@Idioma.Texto("Disponibilidad del profesional")</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Idioma.Texto("Cerrar")"></button></div>
        <div class="modal-body"><p class="small text-secondary">@Idioma.Texto("Espacios que el estudiante podrá elegir al solicitar su cita.")</p>
            <form id="disponibilidad-form" autocomplete="off">
                <label for="disponibilidad-fecha" class="form-label">@Idioma.Texto("Fecha")</label><input id="disponibilidad-fecha" type="date" class="form-control mb-3" />
                <div class="row g-3 mb-3"><div class="col-6"><label for="disponibilidad-inicio" class="form-label">@Idioma.Texto("Desde")</label><input id="disponibilidad-inicio" type="time" class="form-control" /></div><div class="col-6"><label for="disponibilidad-fin" class="form-label">@Idioma.Texto("Hasta")</label><input id="disponibilidad-fin" type="time" class="form-control" /></div></div>
                <label for="disponibilidad-duracion" class="form-label">@Idioma.Texto("Duración de la cita (minutos)")</label><input id="disponibilidad-duracion" type="number" min="1" class="form-control mb-3" placeholder="@Idioma.Texto("Por definir")" />
                <label for="disponibilidad-modalidad" class="form-label">@Idioma.Texto("Modalidad")</label><select id="disponibilidad-modalidad" class="form-select"><option value="">@Idioma.Texto("Seleccionar")</option><option>@Idioma.Texto("Presencial")</option><option>@Idioma.Texto("Virtual")</option></select>
            </form>
            <p class="small text-secondary mt-3 mb-0">@Idioma.Texto("Vista previa. La disponibilidad y sus reglas se definirán con la institución.")</p>
        </div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Idioma.Texto("Cerrar")</button><button type="button" class="btn btn-zuni" disabled>@Idioma.Texto("Guardar disponibilidad")</button></div>
    </div></div>
</div>

<div class="modal fade" id="cita-modal" tabindex="-1" aria-labelledby="cita-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content rounded-4">
        <div class="modal-header"><h2 id="cita-title" class="modal-title h5">@Idioma.Texto("Detalle de cita")</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Idioma.Texto("Cerrar")"></button></div>
        <div class="modal-body"><dl><dt>@Idioma.Texto("Estudiante")</dt><dd>@Idioma.Texto("Sin vincular")</dd><dt>@Idioma.Texto("Fecha, hora y modalidad")</dt><dd>@Idioma.Texto("Sin asignar")</dd><dt>@Idioma.Texto("Estado")</dt><dd>@Idioma.Texto("Sin cita seleccionada")</dd></dl>
            <form autocomplete="off"><label for="cita-nueva-fecha" class="form-label">@Idioma.Texto("Nuevo horario disponible")</label><select id="cita-nueva-fecha" class="form-select mb-3" disabled><option>@Idioma.Texto("Sin horarios disponibles")</option></select><label for="cita-motivo" class="form-label">@Idioma.Texto("Motivo de cancelación o reprogramación")</label><textarea id="cita-motivo" class="form-control" rows="2" placeholder="@Idioma.Texto("Motivo administrativo")"></textarea></form>
            <p class="small text-secondary mt-3 mb-0">@Idioma.Texto("Las acciones estarán disponibles al vincular una cita.")</p>
        </div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" disabled>@Idioma.Texto("Confirmar")</button><button type="button" class="btn btn-outline-secondary" disabled>@Idioma.Texto("Reprogramar")</button><button type="button" class="btn btn-outline-secondary" disabled>@Idioma.Texto("Cancelar cita")</button><button type="button" class="btn btn-zuni" disabled>@Idioma.Texto("Completar cita")</button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Idioma.Texto("Cerrar")</button></div>
    </div></div>
</div>

<div class="modal fade" id="revision-modal" tabindex="-1" aria-labelledby="revision-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content rounded-4">
        <div class="modal-header"><h2 id="revision-title" class="modal-title h5">@Idioma.Texto("Revisión del resultado")</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Idioma.Texto("Cerrar")"></button></div>
        <div class="modal-body"><p class="small text-secondary">@Idioma.Texto("Sin estudiante ni resultado vinculados. Prueba el formato con texto ficticio.")</p>
            <form autocomplete="off"><label for="revision-interpretacion" class="form-label">@Idioma.Texto("Interpretación del profesional")</label><textarea id="revision-interpretacion" class="form-control mb-3" rows="4" placeholder="@Idioma.Texto("Contextualización de las dimensiones y puntuaciones")"></textarea><label for="revision-recomendaciones" class="form-label">@Idioma.Texto("Recomendaciones")</label><textarea id="revision-recomendaciones" class="form-control mb-3" rows="3" placeholder="@Idioma.Texto("Orientaciones del profesional")"></textarea><div class="form-check"><input id="revision-revisado" type="checkbox" class="form-check-input" /><label for="revision-revisado" class="form-check-label">@Idioma.Texto("Marcar el resultado como revisado")</label></div></form>
            <p class="small text-secondary mt-3 mb-0">@Idioma.Texto("Vista previa. No se guardan cambios ni se modifica el estado del resultado.")</p>
        </div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Idioma.Texto("Cerrar")</button><button type="button" class="btn btn-zuni" disabled>@Idioma.Texto("Guardar revisión")</button></div>
    </div></div>
</div>

<div class="modal fade" id="atencion-modal" tabindex="-1" aria-labelledby="atencion-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content rounded-4">
        <div class="modal-header"><h2 id="atencion-title" class="modal-title h5">@Idioma.Texto("Reseña de cita finalizada")</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Idioma.Texto("Cerrar")"></button></div>
        <div class="modal-body"><p class="small text-secondary">@Idioma.Texto("Sin cita vinculada. Usa únicamente texto ficticio para probar el formato.")</p>
            <form autocomplete="off"><label for="atencion-resena" class="form-label">@Idioma.Texto("Reseña de la atención")</label><textarea id="atencion-resena" class="form-control mb-3" rows="3" placeholder="@Idioma.Texto("Aspectos abordados en la sesión")"></textarea><label for="atencion-interpretacion" class="form-label">@Idioma.Texto("Interpretación del profesional")</label><textarea id="atencion-interpretacion" class="form-control mb-3" rows="3"></textarea><label for="atencion-recomendaciones" class="form-label">@Idioma.Texto("Recomendaciones")</label><textarea id="atencion-recomendaciones" class="form-control mb-3" rows="3"></textarea><label for="atencion-seguimiento" class="form-label">@Idioma.Texto("Acuerdos y próximo seguimiento")</label><textarea id="atencion-seguimiento" class="form-control" rows="2"></textarea></form>
            <p class="small text-secondary mt-3 mb-0">@Idioma.Texto("Vista previa sin guardado. El acceso a estas notas requerirá permisos específicos.")</p>
        </div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Idioma.Texto("Cerrar")</button><button type="button" class="btn btn-zuni" disabled>@Idioma.Texto("Guardar atención")</button></div>
    </div></div>
</div>

<div class="modal fade" id="historial-modal" tabindex="-1" aria-labelledby="historial-detalle-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content rounded-4">
        <div class="modal-header"><h2 id="historial-detalle-title" class="modal-title h5">@Idioma.Texto("Detalle de atención")</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Idioma.Texto("Cerrar")"></button></div>
        <div class="modal-body"><p class="small text-secondary">@Idioma.Texto("Sin atención seleccionada.")</p><dl><dt>@Idioma.Texto("Estudiante, fecha y profesional")</dt><dd>—</dd><dt>@Idioma.Texto("Modalidad")</dt><dd>—</dd><dt>@Idioma.Texto("Reseña de la atención")</dt><dd>—</dd><dt>@Idioma.Texto("Interpretación")</dt><dd>—</dd><dt>@Idioma.Texto("Recomendaciones")</dt><dd>—</dd><dt>@Idioma.Texto("Acuerdos y seguimiento")</dt><dd>—</dd></dl></div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Idioma.Texto("Cerrar")</button></div>
    </div></div>
</div>
