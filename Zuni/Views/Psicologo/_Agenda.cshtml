<section id="agenda" class="dash-card" aria-labelledby="agenda-title">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h2 id="agenda-title" class="h4 mb-0">@Idioma.Texto("Agenda y citas")</h2>
                    <button class="btn btn-zuni btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#disponibilidad-modal">@Idioma.Texto("Definir disponibilidad")</button>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-sm-6"><label for="agenda-fecha" class="form-label small">@Idioma.Texto("Fecha")</label><input id="agenda-fecha" type="date" class="form-control" /></div>
                    <div class="col-sm-6"><label for="agenda-estado" class="form-label small">@Idioma.Texto("Estado")</label><select id="agenda-estado" class="form-select"><option>@Idioma.Texto("Todas las citas")</option><option>@Idioma.Texto("Solicitada")</option><option>@Idioma.Texto("Confirmada")</option><option>@Idioma.Texto("Completada")</option><option>@Idioma.Texto("Cancelada")</option><option>@Idioma.Texto("Reprogramada")</option></select></div>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle"><caption>@Idioma.Texto("Citas del período seleccionado")</caption><thead><tr><th scope="col">@Idioma.Texto("Fecha y hora")</th><th scope="col">@Idioma.Texto("Estudiante")</th><th scope="col">@Idioma.Texto("Modalidad")</th><th scope="col">@Idioma.Texto("Estado")</th></tr></thead><tbody><tr><td colspan="4" class="text-center text-secondary py-4">@Idioma.Texto("No hay citas programadas.")</td></tr></tbody></table>
                </div>
                <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#cita-modal">@Idioma.Texto("Ver formato de cita")</button>
            </section>
