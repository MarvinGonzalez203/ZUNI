<section id="agenda" class="dash-card" aria-labelledby="agenda-title">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h2 id="agenda-title" class="h4 mb-0">Agenda y citas</h2>
                    <button class="btn btn-zuni btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#disponibilidad-modal">Definir disponibilidad</button>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-sm-6"><label for="agenda-fecha" class="form-label small">Fecha</label><input id="agenda-fecha" type="date" class="form-control" /></div>
                    <div class="col-sm-6"><label for="agenda-estado" class="form-label small">Estado</label><select id="agenda-estado" class="form-select"><option>Todas las citas</option><option>Solicitada</option><option>Confirmada</option><option>Completada</option><option>Cancelada</option><option>Reprogramada</option></select></div>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle"><caption>Citas del período seleccionado</caption><thead><tr><th scope="col">Fecha y hora</th><th scope="col">Estudiante</th><th scope="col">Modalidad</th><th scope="col">Estado</th></tr></thead><tbody><tr><td colspan="4" class="text-center text-secondary py-4">No hay citas programadas.</td></tr></tbody></table>
                </div>
                <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#cita-modal">Ver formato de cita</button>
            </section>
