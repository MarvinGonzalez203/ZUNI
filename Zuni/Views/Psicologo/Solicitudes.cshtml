@model IReadOnlyList<Zuni.Models.Atencion.SolicitudPsicologoResumen>
@{var expedientes=ViewData["SoloExpedientes"] is true;ViewData["Title"]=expedientes?"Expedientes disponibles":"Solicitudes asignadas";}
<header class="dash-profile-heading"><div><h1>@ViewData["Title"]</h1><p>@Idioma.Texto("Solicitudes de estudiantes con asignación vigente a tu cuenta.")</p></div></header>
<section class="dash-card">@if(Model.Count==0){<p>@Idioma.Texto("No hay") @(expedientes?Idioma.Texto("expedientes disponibles"):Idioma.Texto("solicitudes asignadas")) @Idioma.Texto("en este momento.")</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>@Idioma.Texto("Estudiante")</th><th>@Idioma.Texto("Carné")</th><th>@Idioma.Texto("Solicitud")</th><th>@Idioma.Texto("Estado")</th><th>@Idioma.Texto("Acción")</th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.Estudiante</td><td>@Zuni.Helpers.CarneHelper.Formatear(s.Carne)</td><td>@Zuni.Services.Agenda.AgendaReglas.Local(s.FechaUtc).ToString("dd/MM/yyyy HH:mm")</td><td>@Idioma.Texto(Convert.ToString(s.Estado))</td><td>@if(s.PuedeConsultarExpediente){<a class="dash-button" asp-action="Expediente" asp-route-solicitudId="@s.Id">@Idioma.Texto("Ver expediente de este estudiante")</a>}else{<span>@Idioma.Texto("Expediente o consentimiento pendiente.")</span>}</td></tr>}</tbody></table></div>}</section>
