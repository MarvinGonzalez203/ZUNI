@model IReadOnlyList<Zuni.Models.Atencion.SolicitudPsicologoResumen>
@{var expedientes=ViewData["SoloExpedientes"] is true;ViewData["Title"]=expedientes?"Expedientes disponibles":"Solicitudes asignadas";}
<header class="dash-profile-heading"><div><h1>@ViewData["Title"]</h1><p>Solicitudes de estudiantes con asignación vigente a tu cuenta.</p></div></header>
<section class="dash-card">@if(Model.Count==0){<p>No hay @(expedientes?"expedientes disponibles":"solicitudes asignadas") en este momento.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Estudiante</th><th>Carné</th><th>Solicitud</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.Estudiante</td><td>@Zuni.Helpers.CarneHelper.Formatear(s.Carne)</td><td>@Zuni.Services.Agenda.AgendaReglas.Local(s.FechaUtc).ToString("dd/MM/yyyy HH:mm")</td><td>@s.Estado</td><td>@if(s.PuedeConsultarExpediente){<a class="dash-button" asp-action="Expediente" asp-route-solicitudId="@s.Id">Ver expediente de este estudiante</a>}else{<span>Expediente o consentimiento pendiente.</span>}</td></tr>}</tbody></table></div>}</section>
