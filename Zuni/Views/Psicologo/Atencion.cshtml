@{
    ViewData["Title"] = "Atención";
}
<header class="dash-profile-heading"><div><span class="dash-eyebrow">@Idioma.Texto("ACOMPAÑAMIENTO ESTUDIANTIL")</span><h1>@Idioma.Texto("Atención")</h1></div></header>
<section class="dash-card"><h2>@Idioma.Texto("Atención de estudiantes asignados")</h2><p>@Idioma.Texto("La ficha inicial de acompañamiento se consulta desde tus estudiantes con asignación vigente. El registro de cada atención se completa desde la Agenda al finalizar la cita, con notas profesionales privadas separadas de lo que se comparte con el estudiante.")</p><a class="dash-button" asp-action="Estudiantes">@Idioma.Texto("Ver estudiantes")</a></section>
