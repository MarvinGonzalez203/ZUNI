@{
    Layout = "_DashboardLayout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/psicologo-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bigfive.css" asp-append-version="true" />
}
<div class="psych-dashboard">
    @RenderBody()
    @if(ViewData["ResultadosConectados"] is not true){<partial name="_Modales" />}
</div>
@section Scripts {
    <script src="~/js/disponibilidad-rules.js" asp-append-version="true"></script>
    <script src="~/js/psicologo.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
