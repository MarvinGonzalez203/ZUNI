@{
    Layout = "_DashboardLayout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/psicologo-dashboard.css" asp-append-version="true" />
}
<div class="psych-dashboard">
    <p class="dash-notice"><span class="dash-badge">Vista previa</span> Sin datos de estudiantes. Calendario y niveles de cuestionario en demostración; la disponibilidad se reinicia al recargar. Los formularios no guardan información.</p>
    @RenderBody()
    <partial name="_Modales" />
</div>
@section Scripts {
    <script src="~/js/disponibilidad-rules.js" asp-append-version="true"></script>
    <script src="~/js/psicologo.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
