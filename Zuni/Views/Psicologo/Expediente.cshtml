@model Zuni.Models.Atencion.ExpedienteConsultaViewModel
@using Zuni.Models.Atencion
@{ ViewData["Title"] = "Expediente inicial"; Layout = "_DashboardLayout"; }
<header class="dash-profile-heading"><div><span class="dash-eyebrow">@Idioma.Texto("CONTENIDO CONFIDENCIAL · SOLO LECTURA")</span><h1>@Idioma.Texto("Expediente inicial")</h1><p>@Idioma.Texto("Esta consulta queda registrada. No compartas el contenido fuera de la atención autorizada.")</p></div></header>
<section class="dash-card" data-contenido-privado>
    <a class="dash-button mb-3" asp-controller="InformesEducativos" asp-action="Crear" asp-route-solicitudId="@Model.SolicitudId">@Idioma.Texto("Crear informe educativo")</a>
    <h2 class="h4">@Idioma.Texto("Datos básicos")</h2>
    <dl class="row">
        <dt class="col-sm-4">@Idioma.Texto("Nombre")</dt><dd class="col-sm-8">@Model.Nombre</dd>
        <dt class="col-sm-4">@Idioma.Texto("Carné")</dt><dd class="col-sm-8">@Zuni.Helpers.CarneHelper.Formatear(Model.Carne)</dd>
        <dt class="col-sm-4">@Idioma.Texto("Carrera")</dt><dd class="col-sm-8">@Model.Carrera</dd>
        <dt class="col-sm-4">@Idioma.Texto("Fecha de solicitud (UTC)")</dt><dd class="col-sm-8">@Model.FechaSolicitudUtc.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-4">@Idioma.Texto("Edad / mayoría de edad")</dt><dd class="col-sm-8">@Model.Edad @Idioma.Texto("años ·") @(Model.EsMayorEdad ? Idioma.Texto("Confirmada") : Idioma.Texto("No confirmada"))</dd>
        <dt class="col-sm-4">@Idioma.Texto("Género")</dt><dd class="col-sm-8">@(Model.Sexo ?? Idioma.Texto("No indicado"))</dd>
        <dt class="col-sm-4">@Idioma.Texto("Dirección")</dt><dd class="col-sm-8 text-break">@Model.Direccion</dd>
        <dt class="col-sm-4">@Idioma.Texto("Idioma preferido")</dt><dd class="col-sm-8">@Model.IdiomaPreferido</dd>
        <dt class="col-sm-4">@Idioma.Texto("Tipo de ingreso")</dt><dd class="col-sm-8">@(Model.TipoIngreso == TipoIngresoAtencion.Referencia ? Idioma.Texto("Referencia") : Idioma.Texto("Iniciativa propia"))</dd>
    </dl>
    <h2 class="h4">@Idioma.Texto("Motivo de consulta")</h2><p class="text-break" style="white-space: pre-line">@Model.MotivoConsulta</p>
    @if (Model.TipoIngreso == TipoIngresoAtencion.Referencia)
    {
        <h2 class="h4">@Idioma.Texto("Referencia")</h2><p class="text-break">@Model.NombreReferente</p><p class="text-break" style="white-space: pre-line">@Model.MotivoReferencia</p>
    }
    <h2 class="h4">@Idioma.Texto("Contactos de emergencia")</h2>
    <div class="table-responsive"><table class="table"><thead><tr><th scope="col">@Idioma.Texto("Nombre")</th><th scope="col">@Idioma.Texto("Relación")</th><th scope="col">@Idioma.Texto("Teléfono")</th></tr></thead><tbody>
    @foreach (var contacto in Model.Contactos)
    {
        <tr><td>@contacto.Nombre</td><td>@contacto.Relacion</td><td>@contacto.Telefono</td></tr>
    }
    </tbody></table></div>
    <h2 class="h4">@Idioma.Texto("Consideraciones de atención")</h2><p class="text-break" style="white-space: pre-line">@(Model.ConsideracionesAtencion ?? Idioma.Texto("No indicadas"))</p>
    <section class="my-4" aria-labelledby="bigfive-title">
        <h2 id="bigfive-title" class="h4">@Idioma.Texto("Big Five · apoyo opcional")</h2>
        <p>@Idioma.Texto("La atención no depende de este cuestionario. La consulta de un resumen disponible queda auditada.")</p>
        <a class="dash-button" asp-controller="BigFivePsicologo" asp-action="Resumen" asp-route-solicitudId="@ViewContext.RouteData.Values["solicitudId"]">@Idioma.Texto("Consultar resumen Big Five")</a>
    </section>
    <a class="dash-button" asp-controller="Psicologo" asp-action="Estudiantes">@Idioma.Texto("Volver a estudiantes")</a>
</section>
