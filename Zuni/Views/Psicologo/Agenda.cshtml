@{
    ViewData["Title"] = "Agenda";
}
<header class="dash-profile-heading"><div><span class="dash-eyebrow">ACOMPAÑAMIENTO ESTUDIANTIL</span><h1>Agenda</h1></div></header>
<section class="dash-card" aria-labelledby="psych-empty-title">
    <div class="psych-empty">
        <span class="dash-icon-tile" aria-hidden="true"><partial name="_DashboardIcon" model='@("calendar")' /></span>
        <h2 id="psych-empty-title">Agenda disponible próximamente.</h2>
        <p>La gestión de citas y disponibilidad todavía no está habilitada.</p>
        <a class="dash-text-link" asp-action="Index">Volver al tablero <partial name="_DashboardIcon" model='@("arrow")' /></a>
    </div>
</section>
