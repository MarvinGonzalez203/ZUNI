@model Zuni.Models.Agenda.AgendaPsicologoViewModel
@using Zuni.Models.Agenda
@using Zuni.Services.Agenda
@inject TimeProvider Reloj
@{
    ViewData["Title"] = "Agenda";
    var dias = new[] { "Domingo", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado" };
}
<header class="dash-profile-heading"><div><span class="dash-eyebrow">@Idioma.Texto("ACOMPAÑAMIENTO ESTUDIANTIL")</span><h1>@Idioma.Texto("Mi disponibilidad")</h1><p>@Idioma.Texto("Administra tus horarios y las solicitudes de cita.")</p></div></header>
<partial name="_AgendaCalendario" model="Model.Calendario" />
<partial name="_AlmuerzoPsicologo" model="Model.Almuerzo" />
<p><a asp-controller="CitasProgramadas" asp-action="Editar" class="dash-button">@Idioma.Texto("Programar cita a estudiante")</a> <a asp-controller="CitasProgramadas" asp-action="Index" class="btn btn-outline-primary">@Idioma.Texto("Programar o reprogramar citas")</a></p>
<p><a asp-controller="Atenciones" asp-action="Imprevista" class="dash-button">@Idioma.Texto("Registrar atención imprevista")</a></p>
<section class="dash-card agenda-card" aria-labelledby="horarios-title">
    <details><summary id="horarios-title">@Idioma.Texto("Disponibilidad semanal base")</summary>
    <p>@Idioma.Texto("Los horarios se repiten cada semana, en hora de Guatemala (UTC−6). Las excepciones del calendario afectan solo la fecha seleccionada.")</p>
    <details><summary>@Idioma.Texto("Agregar horario semanal")</summary>
        <form asp-action="AgregarDisponibilidad" method="post" class="row g-3 mt-1">
            <div class="col-md-4"><label zuni-required="true" for="dia" class="form-label">@Idioma.Texto("Día")</label><select name="DiaSemana" id="dia" class="form-select">@for (var i = 1; i <= 7; i++) { <option value="@(i % 7)">@Idioma.Texto(dias[i % 7])</option> }</select></div>
            <div class="col-md-4"><label zuni-required="true" for="inicio" class="form-label">@Idioma.Texto("Desde")</label><input name="HoraInicio" id="inicio" type="time" class="form-control" min="08:00" max="18:00" step="300" required /></div>
            <div class="col-md-4"><label zuni-required="true" for="fin" class="form-label">@Idioma.Texto("Hasta")</label><input name="HoraFin" id="fin" type="time" class="form-control" min="08:00" max="18:00" step="300" required /></div>
            <div class="col-md-6"><label zuni-required="true" for="duracion" class="form-label">@Idioma.Texto("Duración por cita (minutos)")</label><input name="DuracionMinutos" id="duracion" type="number" class="form-control" min="15" max="120" step="5" value="50" required /></div>
            <div class="col-md-6"><label zuni-required="true" for="modalidad" class="form-label">@Idioma.Texto("Modalidad")</label><select name="Modalidad" id="modalidad" class="form-select"><option value="Presencial">@Idioma.Texto("Presencial")</option><option value="Virtual">@Idioma.Texto("Virtual")</option><option value="Ambas">@Idioma.Texto("Ambas")</option></select></div>
            <div><button type="submit" class="dash-button">@Idioma.Texto("Guardar horario")</button></div>
        </form>
    </details>
    @if (Model.Disponibilidades.Count == 0) { <div class="agenda-empty">@Idioma.Texto("Aún no has agregado horarios.")</div> }
    else
    {
        <div class="table-responsive mt-3"><table><thead><tr><th>@Idioma.Texto("Día y horario")</th><th>@Idioma.Texto("Duración")</th><th>@Idioma.Texto("Modalidad")</th><th>@Idioma.Texto("Estado")</th><th>@Idioma.Texto("Acciones")</th></tr></thead><tbody>
        @foreach (var d in Model.Disponibilidades)
        {
            <tr><td>@Idioma.Texto(dias[(int)d.DiaSemana]) @d.HoraInicio.ToString("HH:mm") – @d.HoraFin.ToString("HH:mm")</td><td>@d.DuracionMinutos min</td><td>@Idioma.Texto(Convert.ToString(d.Modalidad))</td><td>@(d.Activo ? Idioma.Texto("Activo") : Idioma.Texto("Inactivo"))</td><td><form asp-action="CambiarDisponibilidad" method="post"><input type="hidden" name="disponibilidadId" value="@d.Id" /><input type="hidden" name="activo" value="@(!d.Activo ? "true" : "false")" /><button type="submit" class="btn btn-outline-secondary">@(d.Activo ? Idioma.Texto("Desactivar") : Idioma.Texto("Activar"))</button></form></td></tr>
        }
        </tbody></table></div>
        <p class="mt-3">@Idioma.Texto("Para reemplazar un horario, desactívalo y agrega uno nuevo. Primero debes gestionar sus citas pendientes.")</p>
    }
    </details>
</section>
<section class="dash-card agenda-card" aria-labelledby="agenda-title">
    <h2 id="agenda-title">@Idioma.Texto("Citas del mes y pendientes anteriores")</h2>
    <p>@Idioma.Texto("Hora de Guatemala (UTC−6). Confirma las solicitudes antes del inicio de la cita.")</p>
    @if (Model.Citas.Count == 0) { <div class="agenda-empty">@Idioma.Texto("No tienes citas registradas para este mes.")</div> }
    else
    {
        <div class="table-responsive mt-3"><table><thead><tr><th>@Idioma.Texto("Horario")</th><th>@Idioma.Texto("Estudiante")</th><th>@Idioma.Texto("Modalidad")</th><th>@Idioma.Texto("Estado")</th><th>@Idioma.Texto("Gestionar")</th></tr></thead><tbody>
        @foreach (var cita in Model.Citas)
        {
            <tr><td>@AgendaReglas.Local(cita.InicioUtc).ToString("dd/MM/yyyy HH:mm") – @AgendaReglas.Local(cita.FinUtc).ToString("HH:mm")</td><td>@cita.Nombre</td><td>@Idioma.Texto(Convert.ToString(cita.Modalidad))</td><td><span class="agenda-status">@(cita.Estado == EstadoCita.NoAsistio ? Idioma.Texto("No asistió") : cita.Estado.ToString())</span></td><td>
            @if (cita.Estado == EstadoCita.Solicitada)
            {
                <form asp-action="GestionarCita" method="post" class="agenda-actions">
                    <input type="hidden" name="CitaId" value="@cita.Id" />
                    <input type="hidden" name="Revision" value="@cita.Revision" />
                    @{ var propuestaSinAsignacion = cita.ProgramadorRol == "Director" && !cita.AsignadoAlProfesional; }
                    @if(cita.ProgramadorRol == "Director") { <span class="dash-badge">@Idioma.Texto("Propuesta de Dirección")</span><partial name="_MotivoPropuestaDirector" model='@("rechazo-" + cita.Id)' /> }
                    @if(propuestaSinAsignacion) { <p class="small mb-1" data-propuesta-sin-asignacion>@Idioma.Texto("Falta una asignación vigente: el estudiante debe registrar su solicitud de atención en ZUNI y Administración debe asignártela en Solicitudes de atención. Cuando eso ocurra podrás aceptarla aquí si la fecha sigue vigente; si no es posible a tiempo, recházala con un motivo de la lista.")</p> }
                    @if(cita.Modalidad==ModalidadCita.Presencial && !propuestaSinAsignacion){<label for="lugar-lista-@cita.Id">@Idioma.Texto("Dirección o lugar de atención presencial")</label><textarea id="lugar-lista-@cita.Id" name="DireccionAtencion" maxlength="500" class="form-control">@cita.DireccionAtencion</textarea>}
                    @if (cita.InicioUtc > Reloj.GetUtcNow().UtcDateTime && cita.Modalidad == ModalidadCita.Presencial && !propuestaSinAsignacion) { <button type="submit" name="Estado" value="Confirmada" class="dash-button">@Idioma.Texto("Aceptar")</button> }
                    <button type="submit" name="Estado" value="Rechazada" class="btn btn-outline-secondary">@Idioma.Texto("Rechazar")</button>
                </form>
            }
            @if (AgendaReglas.Activa(cita.Estado))
            {
                @if(cita.InicioUtc>Reloj.GetUtcNow().UtcDateTime&&!cita.EsImprevista){<a asp-controller="CitasProgramadas" asp-action="Editar" asp-route-citaId="@cita.Id" class="btn btn-outline-primary">@Idioma.Texto("Reprogramar cita")</a>}
                @if(cita.Modalidad==ModalidadCita.Presencial && cita.InicioUtc>Reloj.GetUtcNow().UtcDateTime){<a asp-controller="Ubicaciones" asp-action="Editar" asp-route-citaId="@cita.Id">@Idioma.Texto("Definir o actualizar lugar de atención")</a>}
                @if (cita.Modalidad == ModalidadCita.Virtual && cita.FinUtc > Reloj.GetUtcNow().UtcDateTime) {
                    <a asp-controller="Reuniones" asp-action="Preparar" asp-route-citaId="@cita.Id">@(cita.Estado == EstadoCita.Solicitada ? Idioma.Texto("Preparar y confirmar cita virtual") : Idioma.Texto("Actualizar enlace virtual"))</a>
                    <a asp-controller="Reuniones" asp-action="Detalle" asp-route-citaId="@cita.Id">@Idioma.Texto("Consultar acceso virtual")</a>
                }
                @if (cita.InicioUtc > Reloj.GetUtcNow().UtcDateTime)
                {
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#cancelar-cita-@cita.Id">@Idioma.Texto("Cancelar cita")</button>
                }
                else if (cita.FinUtc <= Reloj.GetUtcNow().UtcDateTime && cita.Estado is EstadoCita.Confirmada or EstadoCita.Reservada)
                {
                    <a asp-action="RegistrarAtencion" asp-route-citaId="@cita.Id" class="dash-button">@Idioma.Texto("Registrar atención")</a>
                }
                else if (cita.Estado == EstadoCita.Solicitada) { <span>Solicitud sin confirmar; revisa su rechazo.</span> }
                else { <span>@Idioma.Texto("Podrás registrar la atención desde las") @AgendaReglas.Local(cita.FinUtc).ToString("HH:mm")@Idioma.Texto(", al finalizar esta cita.")</span> }
            }
            </td></tr>
        }
        </tbody></table></div>
    }
    <p class="mt-3"><a asp-action="Historial">@Idioma.Texto("Consultar historial de citas")</a></p>
</section>
@foreach (var cita in Model.Citas.Where(c => AgendaReglas.Activa(c.Estado) && c.InicioUtc > Reloj.GetUtcNow().UtcDateTime))
{
    <partial name="_CancelarCitaModal" model="cita" />
}
@section Styles { <link rel="stylesheet" href="~/css/agenda-citas.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/agenda-dia.js" asp-append-version="true"></script> }
