<section id="estudiantes" class="dash-card" aria-labelledby="estudiantes-title">
                <h2 id="estudiantes-title" class="h4">@Idioma.Texto("Estudiantes")</h2>
                <p class="small text-secondary">@Idioma.Texto("Asignados o referidos a tu atención.")</p>
                <label for="estudiante-busqueda" class="form-label small">@Idioma.Texto("Buscar por nombre o código")</label>
                <input id="estudiante-busqueda" class="form-control" type="search" placeholder="@Idioma.Texto("Nombre o código")" />
                <p class="text-center text-secondary py-4 mb-0">@Idioma.Texto("Sin estudiantes vinculados.")</p>
                <dl class="small mb-0"><dt>@Idioma.Texto("Estudiante seleccionado")</dt><dd>—</dd><dt>@Idioma.Texto("Autorización de consulta")</dt><dd class="mb-0">@Idioma.Texto("Pendiente de verificar")</dd></dl>
            </section>
