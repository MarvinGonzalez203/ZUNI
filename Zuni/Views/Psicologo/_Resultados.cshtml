<section id="resultados" class="dash-card" aria-labelledby="resultados-title">
                <div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><h2 id="resultados-title" class="h4 mb-0">@Idioma.Texto("Resultados exploratorios")</h2><span class="badge rounded-pill bg-light text-dark border align-self-center">@Idioma.Texto("Sin resultado seleccionado")</span></div>
                <p class="small text-secondary">@Idioma.Texto("Información descriptiva para preparar la consulta. No constituye un diagnóstico.")</p>
                <div class="row g-3 mb-3">
                    <div class="col-md-6"><label for="resultado-evaluacion" class="form-label">@Idioma.Texto("Cuestionario y fecha")</label><select id="resultado-evaluacion" class="form-select" disabled><option>@Idioma.Texto("Sin cuestionarios disponibles")</option></select></div>
                    <div class="col-md-6"><label for="resultado-revision" class="form-label">@Idioma.Texto("Estado de revisión")</label><input id="resultado-revision" class="form-control" value="Sin resultado para revisar" disabled /></div>
                </div>
                <div class="table-responsive"><table class="table"><caption>@Idioma.Texto("Dimensiones y puntuaciones del cuestionario")</caption><thead><tr><th scope="col">@Idioma.Texto("Dimensión")</th><th scope="col">@Idioma.Texto("Puntuación")</th><th scope="col">@Idioma.Texto("Escala")</th><th scope="col">@Idioma.Texto("Descripción")</th></tr></thead><tbody><tr><td colspan="4" class="text-center text-secondary py-4">@Idioma.Texto("Sin dimensiones ni puntuaciones disponibles.")</td></tr></tbody></table></div>
                <details class="border rounded-3 p-3"><summary class="fw-semibold">@Idioma.Texto("Respuestas autorizadas")</summary><p class="small text-secondary mt-3">@Idioma.Texto("La consulta requiere una autorización vigente para este profesional.")</p><div class="table-responsive"><table class="table mb-0"><thead><tr><th scope="col">@Idioma.Texto("Dimensión")</th><th scope="col">@Idioma.Texto("Pregunta")</th><th scope="col">@Idioma.Texto("Respuesta")</th></tr></thead><tbody><tr><td colspan="3" class="text-secondary">@Idioma.Texto("Sin respuestas autorizadas para mostrar.")</td></tr></tbody></table></div></details>
                <div class="d-flex flex-wrap gap-2 mt-3"><button class="btn btn-zuni btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#revision-modal">@Idioma.Texto("Ver formato de revisión")</button><button class="btn btn-outline-secondary btn-sm" type="button" disabled>@Idioma.Texto("Marcar como revisado")</button></div>
            </section>
