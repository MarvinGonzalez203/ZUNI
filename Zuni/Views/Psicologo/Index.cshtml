@{
    ViewData["Title"] = "Tablero";
    var primero = (User.Identity?.Name ?? "Psicólogo").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Psicólogo";
    var nombre = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(primero.ToLower());
}
<header class="dash-welcome">
    <div class="dash-welcome-copy">
        <span class="dash-eyebrow">TU ESPACIO DE ACOMPAÑAMIENTO</span>
        <h1>Hola, @nombre<span class="dash-greeting-dot">.</span></h1>
        <p>Gestiona tu agenda, estudiantes y seguimiento de atención desde un solo lugar.</p>
        <a class="dash-button" asp-action="Agenda">Ver agenda <partial name="_DashboardIcon" model='@("arrow")' /></a>
    </div>
    <div class="dash-welcome-art" aria-hidden="true"><div class="dash-glass-orbit"></div><div class="dash-glass-orbit orbit-small"></div><img src="~/images/zuni-logo-transparent.png" alt="" /><span>Acompañar y conectar.</span></div>
</header>
