@{
    ViewData["Title"] = "Historial de atención";
}
<header class="dash-profile-heading"><div><span class="dash-eyebrow">ACOMPAÑAMIENTO ESTUDIANTIL</span><h1>Historial de atención</h1></div></header>
<section class="dash-card" aria-labelledby="psych-empty-title">
    <div class="psych-empty">
        <span class="dash-icon-tile" aria-hidden="true"><partial name="_DashboardIcon" model='@("book")' /></span>
        <h2 id="psych-empty-title">No hay sesiones clínicas registradas.</h2>
        <p>El registro de sesiones aún no está habilitado. Los accesos a expedientes no representan sesiones clínicas.</p>
        <a class="dash-text-link" asp-action="Index">Volver al tablero <partial name="_DashboardIcon" model='@("arrow")' /></a>
    </div>
</section>
