@model Zuni.Models.HistorialCitasViewModel
@using Zuni.Models
@{ViewData["Title"]="Historial de atención";ViewData["ResultadosConectados"]=true;}
<link rel="stylesheet" href="~/css/seguimiento-estudiantes.css" asp-append-version="true" />
<h1>Historial de atención</h1><p>Tus atenciones terminadas y registros de inasistencia. Estos mismos registros aparecen en la ficha individual.</p>
<section class="dash-card">
<form method="get" class="student-filters"><label>Estudiante<input type="search" name="busqueda" value="@Model.Busqueda" maxlength="80" /></label><label>Desde<input type="date" name="desde" value="@Model.Desde?.ToString("yyyy-MM-dd")" /></label><label>Hasta<input type="date" name="hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")" /></label><label>Modalidad<select name="modalidad">@foreach(var mode in new[]{"Todas","Presencial","Virtual"}){<option selected="@(Model.Modalidad==mode)">@mode</option>}</select></label><button class="dash-button">Filtrar</button><a asp-action="Historial">Limpiar filtros</a></form>
<div class="student-table-wrap mt-3"><table class="student-table"><thead><tr><th>Estudiante</th><th>Fecha y hora</th><th>Modalidad</th><th>Estado</th><th>Detalle</th></tr></thead><tbody>
@if(Model.Citas.Count==0){<tr><td colspan="5">Aún no hay atenciones con estos filtros.</td></tr>}
@foreach(var cita in Model.Citas){<tr><td><a asp-action="Estudiantes" asp-route-estudiante="@cita.PerfilEstudianteId">@cita.Estudiante</a></td><td>@cita.Fecha.ToString("dd/MM/yyyy") @cita.Inicio.ToString("HH:mm")</td><td>@cita.Modalidad</td><td>@CitaTextos.Estado(cita.Estado)</td><td><a asp-controller="Citas" asp-action="Detalle" asp-route-id="@cita.Id">Ver atención</a></td></tr>}
</tbody></table></div>
@if(Model.Paginas>1){<nav aria-label="Páginas del historial">@if(Model.Pagina>1){<a asp-route-pagina="@(Model.Pagina-1)" asp-route-busqueda="@Model.Busqueda" asp-route-desde="@Model.Desde" asp-route-hasta="@Model.Hasta" asp-route-modalidad="@Model.Modalidad">Anterior</a>}<span> @Model.Pagina de @Model.Paginas </span>@if(Model.Pagina<Model.Paginas){<a asp-route-pagina="@(Model.Pagina+1)" asp-route-busqueda="@Model.Busqueda" asp-route-desde="@Model.Desde" asp-route-hasta="@Model.Hasta" asp-route-modalidad="@Model.Modalidad">Siguiente</a>}</nav>}
</section>
