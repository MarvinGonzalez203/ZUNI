@model Zuni.Models.SeguimientoEstudiantesViewModel
@{ ViewData["Title"]="Estudiantes y seguimiento"; ViewData["ResultadosConectados"]=true; }
<link rel="stylesheet" href="~/css/seguimiento-estudiantes.css" asp-append-version="true" />
<header class="dash-profile-heading"><div><span class="dash-eyebrow">ACOMPAÑAMIENTO ESTUDIANTIL</span><h1>Mis estudiantes</h1><p>Un espacio para conocer sus resultados, consultar sus citas y dar seguimiento a cada atención.</p></div></header>
<div class="student-overview"><article class="dash-card"><span>Estudiantes vinculados</span><strong>@Model.Total</strong></article><article class="dash-card"><span>Big Five completado y disponible</span><strong>@Model.Completados</strong></article><article class="dash-card student-future"><span>Próximas citas</span><strong>—</strong><small>Reservas en preparación</small></article></div>
<section class="dash-card mt-4">
<form asp-action="Estudiantes" method="get" class="student-filters">
<label>Buscar por nombre<input type="search" name="busqueda" value="@Model.Busqueda" maxlength="80" placeholder="Nombre del estudiante" /></label>
<label>Mostrar<select name="filtro"><option value="todos" selected="@(Model.Filtro=="todos")">Todos mis estudiantes</option><option value="completado" selected="@(Model.Filtro=="completado")">Big Five completado y disponible</option><option value="sinresultado" selected="@(Model.Filtro=="sinresultado")">Sin resultado disponible</option><optgroup label="Citas · en preparación"><option disabled>Cita agendada</option><option disabled>Cita pendiente / programada</option><option disabled>Cita reprogramada</option><option disabled>Cita cancelada</option><option disabled>Cita terminada</option></optgroup></select></label>
<button class="dash-button" type="submit">Filtrar</button><a class="student-clear" asp-action="Estudiantes">Ver todos</a>
</form>
<div class="student-order"><span>Por ahora, ordenados por nombre.</span><label>Orden de citas<select disabled aria-describedby="orden-citas-aviso"><option>Próxima cita primero</option></select></label></div>
<p id="orden-citas-aviso" class="student-muted">Cuando se conecten las reservas, las citas más cercanas aparecerán primero; los estudiantes sin cita quedarán al final.</p>
<div class="student-table-wrap"><table class="student-table"><caption class="visually-hidden">Estudiantes con vínculo vigente a tu cuenta</caption><thead><tr><th>Estudiante</th><th>Big Five</th><th>Próxima cita</th><th>Seguimiento</th></tr></thead><tbody>
@if(Model.Estudiantes.Count==0){<tr><td colspan="4"><div class="student-empty"><h2 class="h5">@(Model.Total==0?"Aún no tienes estudiantes vinculados":"No hay estudiantes con este filtro")</h2><p>@(Model.Total==0?"Aquí aparecerán los estudiantes que te asigne la institución.":"Prueba otra búsqueda o vuelve a mostrar todos.")</p></div></td></tr>}
@foreach(var student in Model.Estudiantes){
<tr><td><a class="student-name" asp-action="Estudiantes" asp-route-estudiante="@student.Id" asp-route-busqueda="@Model.Busqueda" asp-route-filtro="@Model.Filtro" asp-route-pagina="@Model.Pagina"><span class="student-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(student.Nombre)?"E":student.Nombre.Trim()[..1])</span><span><strong>@student.Nombre</strong><small>@student.Carne · @(student.Carrera??"Carrera no indicada")</small></span></a></td><td><span class="student-status @(student.BigFiveCompleto?"is-ready":"")">@(student.BigFiveCompleto?"Completado":"Sin resultado disponible")</span></td><td><span class="student-muted">Por conectar</span></td><td><a class="dash-button" asp-action="Estudiantes" asp-route-estudiante="@student.Id" asp-route-busqueda="@Model.Busqueda" asp-route-filtro="@Model.Filtro" asp-route-pagina="@Model.Pagina" aria-label="Abrir ficha de @student.Nombre">Abrir ficha →</a></td></tr>
}
</tbody></table></div>
@if(Model.Paginas>1){<nav class="student-pagination" aria-label="Páginas de estudiantes">@if(Model.Pagina>1){<a class="dash-button" asp-action="Estudiantes" asp-route-pagina="@(Model.Pagina-1)" asp-route-busqueda="@Model.Busqueda" asp-route-filtro="@Model.Filtro">Anterior</a>}<span>@Model.Pagina de @Model.Paginas</span>@if(Model.Pagina<Model.Paginas){<a class="dash-button" asp-action="Estudiantes" asp-route-pagina="@(Model.Pagina+1)" asp-route-busqueda="@Model.Busqueda" asp-route-filtro="@Model.Filtro">Siguiente</a>}</nav>}
</section>
@if(Model.Seleccionado is {} selected){
<div class="modal fade student-record" id="student-record" tabindex="-1" aria-labelledby="student-record-title" aria-hidden="true">
<div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><div><span class="dash-eyebrow">FICHA DEL ESTUDIANTE</span><h2 id="student-record-title" class="modal-title fs-4">@selected.Nombre</h2><p class="student-muted mb-0">@selected.Carne · @selected.Carrera</p></div><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Cerrar ficha"></button></div>
<div class="modal-body">
<ul class="nav nav-tabs student-tabs" role="tablist"><li class="nav-item" role="presentation"><button class="nav-link active" id="tab-bigfive" data-bs-toggle="tab" data-bs-target="#record-bigfive" type="button" role="tab" aria-controls="record-bigfive" aria-selected="true">Big Five</button></li><li class="nav-item" role="presentation"><button class="nav-link" id="tab-citas" data-bs-toggle="tab" data-bs-target="#record-citas" type="button" role="tab" aria-controls="record-citas" aria-selected="false">Citas</button></li><li class="nav-item" role="presentation"><button class="nav-link" id="tab-atencion" data-bs-toggle="tab" data-bs-target="#record-atencion" type="button" role="tab" aria-controls="record-atencion" aria-selected="false">Atención e historial</button></li></ul>
<div class="tab-content pt-4"><section class="tab-pane fade show active" id="record-bigfive" role="tabpanel" aria-labelledby="tab-bigfive" tabindex="0">
@if(Model.Resultado is {} summary){<partial name="_ResumenBigFive" model="summary" />}else{<div class="student-empty"><h3 class="h5">No hay un resultado disponible</h3><p>Se mostrará cuando el estudiante finalice Big Five y mantenga su consentimiento y vínculo vigentes.</p></div>}
</section>
<section class="tab-pane fade" id="record-citas" role="tabpanel" aria-labelledby="tab-citas" tabindex="0"><span class="student-status">En preparación</span><h3 class="h5 mt-3">Citas de @selected.Nombre</h3><p>Aquí se reunirán las citas programadas, reprogramadas, canceladas y terminadas de este estudiante.</p><div class="student-appointment-preview"><div><span>Próxima cita</span><strong>Fecha y hora por conectar</strong></div><div><span>Modalidad</span><strong>Presencial / virtual</strong></div><div><span>Estado</span><strong>Pendiente de conectar</strong></div></div><div class="student-empty mt-3"><p>La agenda ya permite definir disponibilidad. El registro de reservas y sus estados aún está pendiente.</p></div></section>
<section class="tab-pane fade" id="record-atencion" role="tabpanel" aria-labelledby="tab-atencion" tabindex="0"><span class="student-status">Vista previa</span><h3 class="h5 mt-3">Detalle de una atención terminada</h3><p>Al seleccionar una cita finalizada, aquí podrás registrar su atención y consultar el historial de este estudiante.</p><fieldset disabled class="student-attention"><legend class="visually-hidden">Formato de atención pendiente de conectar</legend><label>Cita finalizada<select><option>Selecciona una cita cuando se conecten las reservas</option></select></label><label>Notas privadas del profesional<textarea rows="3" placeholder="Resumen de la sesión y seguimiento interno"></textarea></label><label>Recomendaciones para el estudiante<textarea rows="3" placeholder="Orientaciones que se mostrarán en Mis resultados"></textarea></label><button class="dash-button" type="button">Guardar atención · Próximamente</button></fieldset><p class="student-muted mt-3">Este formato todavía no guarda datos. Las notas privadas y las recomendaciones publicables tendrán accesos separados.</p><h4 class="h6 mt-4">Historial de atención</h4><p class="student-muted">Se conectará con las citas terminadas de esta ficha.</p></section>
</div></div><div class="modal-footer"><button class="dash-button" type="button" data-bs-dismiss="modal">Cerrar ficha</button></div></div></div></div>
}
@section Scripts {<script src="~/js/seguimiento-estudiantes.js" asp-append-version="true"></script>}