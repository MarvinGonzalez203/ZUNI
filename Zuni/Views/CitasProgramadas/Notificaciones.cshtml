@model IReadOnlyList<Zuni.Models.Agenda.NotificacionResumen>
@{ViewData["Title"]="Mis notificaciones";}
<header class="dash-profile-heading"><div><h1>Mis notificaciones</h1><p>Programaciones y cambios de horario dirigidos a tu cuenta.</p></div></header>@if(Model.Count==0){<section class="dash-card">Todavía no tienes notificaciones de citas.</section>}
@foreach(var n in Model){<article class="dash-card mb-3"><span class="dash-badge">@(n.Leida?"Leída":"Nueva")</span><p class="mt-3">@n.Texto</p><small>@Zuni.Services.Agenda.AgendaReglas.Local(n.FechaUtc).ToString("dd/MM/yyyy HH:mm") (Guatemala)</small><div class="mt-3">@if(User.IsInRole("Estudiante")){<a asp-controller="Estudiante" asp-action="Citas" class="dash-button">Consultar mis citas</a>}else if(User.IsInRole("Psicologo")){<a asp-controller="Psicologo" asp-action="Agenda" class="dash-button">Consultar mi agenda</a>}@if(!n.Leida){<form asp-action="Leida" method="post" class="d-inline"><input type="hidden" name="id" value="@n.Id"/><button class="btn btn-outline-secondary">Marcar como leída</button></form>}</div></article>}
