@model IReadOnlyList<Zuni.Models.Agenda.NotificacionResumen>
@{ViewData["Title"]="Mis notificaciones";}
<header class="dash-profile-heading"><div><h1>@Idioma.Texto("Mis notificaciones")</h1><p>@Idioma.Texto("Programaciones, cambios de horario y respuestas dirigidos a tu cuenta.")</p></div></header>
@if(Model.Count==0){<section class="dash-card">@Idioma.Texto("Todavía no tienes notificaciones de citas.")</section>}
@foreach(var n in Model){
<article class="dash-card mb-3"><span class="dash-badge">@(n.Leida?Idioma.Texto("Leída"):"Nueva")</span><h2 class="h4 mt-3">@n.Tipo @Idioma.Texto("de cita")</h2>
<dl class="notification-data"><div><dt>@Idioma.Texto("Estudiante")</dt><dd>@n.Estudiante</dd></div><div><dt>@Idioma.Texto("Carné")</dt><dd>@Zuni.Helpers.CarneHelper.Formatear(n.Carne)</dd></div><div><dt>@(n.AutorOriginal?"Creada por":Idioma.Texto("Programación actual creada por"))</dt><dd>@(n.Autor??Idioma.Texto("No registrado")) · @(n.AutorRol??Idioma.Texto("Profesional"))</dd></div><div><dt>@Idioma.Texto("Psicólogo responsable")</dt><dd>@n.Psicologo</dd></div><div><dt>@Idioma.Texto("Fecha actual de la cita")</dt><dd>@Zuni.Services.Agenda.AgendaReglas.Local(n.InicioUtc).ToString("dd/MM/yyyy HH:mm") · Guatemala</dd></div><div><dt>@Idioma.Texto("Modalidad")</dt><dd>@Idioma.Texto(Convert.ToString(n.Modalidad))</dd></div><div><dt>@Idioma.Texto("Estado actual")</dt><dd>@(n.EstadoActual==Zuni.Models.Agenda.EstadoCita.Solicitada?Idioma.Texto("Pendiente de revisar"):n.EstadoActual.ToString())</dd></div><div><dt>@Idioma.Texto("Aviso recibido")</dt><dd>@Zuni.Services.Agenda.AgendaReglas.Local(n.FechaUtc).ToString("dd/MM/yyyy HH:mm") · Guatemala</dd></div></dl>
<details><summary>@Idioma.Texto("Ver mensaje original del aviso")</summary><p class="notification-original">@n.Texto</p></details>
<div class="notification-actions">
@if(User.IsInRole("Estudiante")){<a asp-controller="Estudiante" asp-action="Citas" asp-route-fecha="@Zuni.Services.Agenda.AgendaReglas.Hoy(n.InicioUtc).ToString("yyyy-MM-dd")" class="dash-button">@Idioma.Texto("Consultar mis citas")</a>}
else if(User.IsInRole("Psicologo")){<a asp-controller="Psicologo" asp-action="Agenda" asp-route-citaId="@n.CitaId" class="dash-button">@Idioma.Texto("Consultar propuesta en su día")</a>}
else if(User.IsInRole("Director")){<a asp-controller="CitasProgramadas" asp-action="Index" asp-route-citaId="@n.CitaId" class="dash-button">@Idioma.Texto("Consultar cita en el calendario")</a>}
@if(!n.Leida){<form asp-action="Leida" method="post"><input type="hidden" name="id" value="@n.Id"/><button class="btn btn-outline-secondary">@Idioma.Texto("Marcar como leída")</button></form>}
</div></article>}
