@model Zuni.Models.Agenda.ProgramarCitaInput
@{ViewData["Title"]=Model.CitaId is null?"Programar cita":"Reprogramar cita";}
<section class="dash-card"><h1>@ViewData["Title"]</h1><p>@Idioma.Texto("La cita queda vinculada al estudiante y a su psicólogo actual. Se enviará una notificación dentro de ZUNI.")</p><form asp-action="Guardar" method="post" class="row g-3"><input asp-for="CitaId" type="hidden"/><input asp-for="Revision" type="hidden"/><input asp-for="OperacionId" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div>
<div class="col-12"><label asp-for="PerfilEstudianteId" class="form-label"></label><select asp-for="PerfilEstudianteId" class="form-select" required><option value="">@Idioma.Texto("Selecciona un estudiante")</option>@foreach(var p in Model.Estudiantes){<option value="@p.Id">@p.Nombre · @p.Psicologo · @(p.EdadVerificada?"Edad verificada":Idioma.Texto("Edad pendiente"))</option>}</select></div><div class="col-md-6"><label asp-for="Fecha" class="form-label"></label><input asp-for="Fecha" type="date" class="form-control" required/></div><div class="col-md-6"><label asp-for="HoraInicio" class="form-label"></label><input asp-for="HoraInicio" type="time" min="08:00" max="18:00" step="300" class="form-control" required/></div>
<div class="col-md-4"><label asp-for="DuracionMinutos" class="form-label" zuni-required="true"></label><select asp-for="DuracionMinutos" class="form-select">@foreach(var m in new[]{15,30,45,50,60,90,120}){<option value="@m">@m @Idioma.Texto("minutos")</option>}</select></div><div class="col-md-4"><label asp-for="HoraFin" class="form-label"></label><input asp-for="HoraFin" type="time" step="300" class="form-control"/><small>@Idioma.Texto("Si lo omites, se calcula con la duración.")</small></div><div class="col-md-4"><label asp-for="Modalidad" class="form-label" zuni-required="true"></label><select asp-for="Modalidad" class="form-select"><option value="Presencial">@Idioma.Texto("Presencial")</option><option value="Virtual">@Idioma.Texto("Virtual")</option></select></div><p>@Idioma.Texto("El horario es aproximado. La programación no sustituye la revisión de mayoría de edad, el consentimiento o el registro clínico. Al cambiar una cita virtual, el psicólogo debe preparar y confirmar nuevamente su enlace.")</p><div class="zuni-action-row"><button class="dash-button">@(Model.CitaId is null?Idioma.Texto("Programar y notificar"):Idioma.Texto("Guardar nueva fecha y notificar"))</button> <a asp-action="Index" class="btn btn-outline-secondary">@Idioma.Texto("Cancelar")</a></div></form></section>
