@model Zuni.Models.Agenda.ProgramacionListado
@{ViewData["Title"]="Programación de citas";}
<header class="dash-profile-heading"><div><h1>Programación de citas</h1><p>Coordina fechas con estudiantes vinculados. Hora de Guatemala.</p></div><a asp-action="Editar" class="dash-button">Programar nueva cita</a></header>
<section class="dash-card"><p>Las propuestas pendientes requieren confirmación del psicólogo. Las citas virtuales necesitan un enlace individual preparado por él.</p>@if(Model.Citas.Count==0){<p>No hay citas activas para mostrar.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Estudiante</th><th>Psicólogo</th><th>Fecha</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var c in Model.Citas){<tr><td>@c.Estudiante</td><td>@c.Psicologo</td><td>@Zuni.Services.Agenda.AgendaReglas.Local(c.InicioUtc).ToString("dd/MM/yyyy HH:mm")</td><td>@c.Estado</td><td>@if(c.PuedeReprogramar){<a asp-action="Editar" asp-route-citaId="@c.Id" class="btn btn-outline-primary">Reprogramar</a>}else{<span>Consulta el registro de atención.</span>}</td></tr>}</tbody></table></div>}</section>
