@model Zuni.Models.Institucion.EditarTarifasInput
@{ViewData["Title"]="Editar precios de ZUNI";}
<header class="dash-profile-heading"><div><h1>@Idioma.Texto("Editar precios de ZUNI")</h1><p>@Idioma.Texto("Define el precio total en quetzales de cada periodo. El equivalente mensual y el ahorro se calculan automáticamente.")</p></div></header>
<form method="post" class="dash-card"><input asp-for="Revision" type="hidden"/><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="Mensual" class="form-label"></label><input asp-for="Mensual" type="number" min="0.01" max="999999.99" step="0.01" class="form-control" required/></div><div class="col-md-6"><label asp-for="Trimestral" class="form-label"></label><input asp-for="Trimestral" type="number" min="0.01" max="999999.99" step="0.01" class="form-control" required/></div><div class="col-md-6"><label asp-for="Semestral" class="form-label"></label><input asp-for="Semestral" type="number" min="0.01" max="999999.99" step="0.01" class="form-control" required/></div><div class="col-md-6"><label asp-for="Anual" class="form-label"></label><input asp-for="Anual" type="number" min="0.01" max="999999.99" step="0.01" class="form-control" required/></div></div>
<p class="mt-3">@Idioma.Texto("Este cambio actualiza el catálogo comercial; no genera cobros ni modifica contratos existentes.")</p>
<div class="zuni-action-row"><button class="dash-button" type="submit">@Idioma.Texto("Guardar precios")</button><a asp-action="Index" class="btn btn-outline-secondary">@Idioma.Texto("Volver a tarifas")</a></div></form>
