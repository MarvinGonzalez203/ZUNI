@model IReadOnlyList<Zuni.Models.Institucion.TarifaSaas>
@{ViewData["Title"]="Tarifas y periodos";}
@section Styles { <link rel="stylesheet" href="~/css/tarifas.css" asp-append-version="true" /> }
<header class="dash-profile-heading"><div><span class="dash-eyebrow">@Idioma.Texto("ZUNI PARA TU INSTITUCIÓN")</span><h1>@Idioma.Texto("Tarifas y periodos")</h1><p>@Idioma.Texto("Tarifas en quetzales por institución. Todos los periodos incluyen las mismas funciones de ZUNI.")</p></div></header>
@if(User.IsInRole("SuperAdmin")){<p class="mb-4"><a class="dash-button" asp-action="Editar">@Idioma.Texto("Editar precios")</a></p>}
<div class="tarifa-grid">
@foreach(var tarifa in Model){
    <article class="dash-card tarifa-card"><span class="dash-badge">@tarifa.Meses @Idioma.Texto(tarifa.Meses==1?"mes":"meses")</span><h2>@Idioma.Texto(tarifa.Nombre)</h2><p class="tarifa-price"><span>Q</span> @tarifa.Total.ToString("N2")</p><p>@Idioma.Texto("Total del periodo · GTQ")</p><p>@Idioma.Texto("Equivalente mensual:") <strong>Q @tarifa.MensualEquivalente.ToString("N2")</strong></p>@if(tarifa.Ahorro>0){<p class="tarifa-saving">@Idioma.Texto("Ahorro frente al pago mensual:") <strong>Q @tarifa.Ahorro.ToString("N2")</strong></p>}else{<p>@Idioma.Texto("Periodo inicial para evaluar la herramienta.")</p>}@if(User.IsInRole("SuperAdmin")){<span class="dash-eyebrow">@Idioma.Texto("PRECIO PROPUESTO")</span>}</article>
}
</div>
<section class="mt-4" aria-labelledby="beneficios-title"><h2 id="beneficios-title">@Idioma.Texto("Funciones incluidas con ZUNI")</h2><p>@Idioma.Texto("Cada cuenta accede a las herramientas de su rol. Las funciones de atención conservan sus permisos y autorizaciones.")</p><div class="tarifa-beneficios @(User.IsInRole("SuperAdmin")?"tarifa-beneficios--proveedor":"")">@if(User.IsInRole("SuperAdmin")){<article class="dash-card tarifa-capacidades-superadmin"><span class="tarifa-feature-icon"><partial name="_DashboardIcon" model='@("shield")'/></span><h3>@Idioma.Texto("SuperAdmin")</h3><ul><li>@Idioma.Texto("Editar precios de los periodos de ZUNI")</li><li>@Idioma.Texto("Consultar el catálogo comercial")</li><li>@Idioma.Texto("Personalizar los colores del panel comercial")</li><li>@Idioma.Texto("Actualizar sus datos y contraseña")</li></ul><p>@Idioma.Texto("Gestión comercial sin acceso a alumnos ni expedientes.")</p></article>}<article class="dash-card"><span class="tarifa-feature-icon"><partial name="_DashboardIcon" model='@("settings")'/></span><h3>@Idioma.Texto("Administrador")</h3><ul><li>@Idioma.Texto("Gestión de cuentas y roles institucionales")</li><li>@Idioma.Texto("Activación de cuentas y verificación de edad")</li><li>@Idioma.Texto("Catálogo de carreras por área académica")</li><li>@Idioma.Texto("Configuración de identidad y política de correo")</li></ul></article><article class="dash-card"><span class="tarifa-feature-icon"><partial name="_DashboardIcon" model='@("results")'/></span><h3>@Idioma.Texto("Director")</h3><ul><li>@Idioma.Texto("Calendario y propuestas de citas")</li><li>@Idioma.Texto("Gestión de pruebas, preguntas y dimensiones")</li><li>@Idioma.Texto("Asignación de pruebas para inducción profesional")</li><li>@Idioma.Texto("Consulta de informes educativos autorizados")</li></ul></article><article class="dash-card"><span class="tarifa-feature-icon"><partial name="_DashboardIcon" model='@("calendar")'/></span><h3>@Idioma.Texto("Psicólogo")</h3><ul><li>@Idioma.Texto("Agenda, disponibilidad y horario de almuerzo")</li><li>@Idioma.Texto("Citas presenciales, virtuales e imprevistas")</li><li>@Idioma.Texto("Expedientes y notas privadas del profesional")</li><li>@Idioma.Texto("Inducción de pruebas y resumen de respuestas")</li><li>@Idioma.Texto("Reportes compartidos e informes educativos")</li></ul></article><article class="dash-card"><span class="tarifa-feature-icon"><partial name="_DashboardIcon" model='@("user")'/></span><h3>@Idioma.Texto("Estudiante")</h3><ul><li>@Idioma.Texto("Solicitud de atención y seguimiento")</li><li>@Idioma.Texto("Calendario y notificaciones de citas")</li><li>@Idioma.Texto("Acceso individual a citas virtuales")</li><li>@Idioma.Texto("Pruebas indicadas después de la inducción")</li><li>@Idioma.Texto("Consulta de resultados compartidos")</li></ul></article><article class="dash-card"><span class="tarifa-feature-icon"><partial name="_DashboardIcon" model='@("shield")'/></span><h3>@Idioma.Texto("Funciones compartidas")</h3><ul><li>@Idioma.Texto("Interfaz en español e inglés")</li><li>@Idioma.Texto("Tema claro y oscuro")</li><li>@Idioma.Texto("Mi cuenta y cambio de contraseña")</li><li>@Idioma.Texto("Guías de uso y orientación")</li><li>@Idioma.Texto("Privacidad y acceso según el rol")</li></ul></article></div></section>
<section class="dash-card mt-4"><h2>@Idioma.Texto("Una herramienta de apoyo educativo")</h2><p>@Idioma.Texto("Incluye gestión de usuarios y roles, agenda de citas, pruebas orientadas por el profesional, reportes compartidos e informes educativos con autorización.")</p><p>@Idioma.Texto("La tarifa contempla licencia y soporte básico. Servidor, dominio, copias de seguridad, impuestos, capacitación y servicios profesionales de psicología se cotizan por separado.")</p><p>@Idioma.Texto("Los periodos de 3, 6 y 12 meses contemplan el pago anticipado del periodo completo.")</p><p>@Idioma.Texto("La capacidad de cada instalación se acuerda después de evaluar su uso. Esta pantalla no genera cargos, facturas ni renovaciones automáticas.")</p></section>
