@{
    var c=ViewContext.RouteData.Values["controller"]?.ToString();var a=ViewContext.RouteData.Values["action"]?.ToString();
    var rolCuenta=ViewData["PreferenciaRol"] as string??Zuni.Services.Institucion.PreferenciasVistaService.Rol(User);
    bool Activa(string accion)=>c=="MiCuenta"&&a==accion;
    var privacidad=c=="Privacidad"&&a is "Index" or "Solicitar" or "Aceptar";
    var colores=c=="Preferencias"||c=="SuperAdmin"&&a=="Apariencia";
    string Act(bool valor)=>valor?"is-active":"";
}
<details class="dash-nav-group" open="@(c=="MiCuenta"||privacidad||colores||c=="MayoriaEdad"&&rolCuenta=="Estudiante")"><summary><partial name="_DashboardIcon" model='@("user")'/><span>@Idioma.Texto("Mi cuenta")</span></summary><div class="dash-nav-children">
<a class="dash-nav-link @Act(Activa("Index"))" asp-controller="MiCuenta" asp-action="Index"><span>@Idioma.Texto("Resumen")</span></a>
<a class="dash-nav-link @Act(Activa("Editar"))" asp-controller="MiCuenta" asp-action="Editar"><span>@Idioma.Texto("Editar datos")</span></a>
<a class="dash-nav-link @Act(Activa("CambiarContrasena"))" asp-controller="MiCuenta" asp-action="CambiarContrasena"><span>@Idioma.Texto("Cambiar contraseña")</span></a>
<a class="dash-nav-link @Act(colores)" asp-controller="Preferencias" asp-action="Colores" asp-route-rol="@rolCuenta"><span>@Idioma.Texto("Mis colores")</span></a>
@if(rolCuenta=="Estudiante"){<a class="dash-nav-link @Act(c=="MayoriaEdad")" asp-controller="MayoriaEdad" asp-action="Index"><span>@Idioma.Texto("Mayoría de edad")</span></a>}
<a class="dash-nav-link @Act(privacidad)" asp-controller="Privacidad" asp-action="Index"><span>@Idioma.Texto("Privacidad y mis derechos")</span></a>
</div></details>
