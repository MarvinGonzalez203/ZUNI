@model IReadOnlyList<HistorialAtencionItem>

<section id="historial" class="bg-white border rounded-4 shadow-sm p-4 h-100" aria-labelledby="historial-title">
    <h2 id="historial-title" class="h4">Historial de atención</h2>
    <p class="small text-secondary">Registro compartido de atención estudiantil.</p>
    <div class="table-responsive">
        <table class="table align-middle">
            <caption>Atenciones ordenadas de la más reciente a la más antigua</caption>
            <thead><tr><th scope="col">Fecha</th><th scope="col">Estudiante</th><th scope="col">Profesional</th><th scope="col">Modalidad</th><th scope="col">Detalle</th></tr></thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-secondary py-4">Sin atenciones registradas.</td></tr>
            }
            @foreach (var atencion in Model.OrderByDescending(item => item.Fecha))
            {
                <tr>
                    <td>@atencion.Fecha.ToOffset(TimeSpan.FromHours(-6)).ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@atencion.Estudiante <span class="d-block small text-secondary">@atencion.Codigo</span></td>
                    <td>@atencion.Profesional</td><td>@atencion.Modalidad</td>
                    <td><details><summary>Ver atención</summary><dl class="small mt-3 mb-0"><dt>Reseña de la atención</dt><dd>@atencion.Resena</dd><dt>Recomendaciones</dt><dd>@atencion.Recomendaciones</dd><dt>Acuerdos y seguimiento</dt><dd>@atencion.Seguimiento</dd></dl></details></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
