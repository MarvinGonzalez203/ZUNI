@model IReadOnlyList<Zuni.Models.CitaResumen>
@using Zuni.Models
@{var professional=User.IsInRole("Psicologo");var culture=System.Globalization.CultureInfo.GetCultureInfo("es-GT");}
@if(Model.Count==0){<p class="student-muted">Todavía no hay citas registradas.</p>}
@foreach(var cita in Model){
<article class="dash-card cita-card mb-3">
<h3 class="h5">@(professional?cita.Estudiante:cita.Psicologo)</h3>
<p><strong>@cita.Fecha.ToString("dddd dd MMMM yyyy",culture) · @cita.Inicio.ToString("HH:mm")–@cita.Fin.ToString("HH:mm")</strong> · @cita.Modalidad</p>
<p class="student-status">@CitaTextos.Estado(cita.Estado)</p>
@if(cita.Variable){<p>Duración de atención variable. El intervalo queda reservado para esta cita.</p>}
@if(cita.Estado==EstadoCita.Solicitada){<p>El horario está reservado mientras el psicólogo revisa la solicitud.</p>}
@if(professional){<a class="dash-button" asp-controller="Citas" asp-action="Detalle" asp-route-id="@cita.Id">Ver cita y registrar atención →</a>}
@if(CitaTextos.Activa(cita.Estado)&&cita.InicioUtc>DateTime.UtcNow){
    @if(professional&&cita.Estado==EstadoCita.Solicitada){
    <form asp-controller="Citas" asp-action="Gestionar" method="post" class="mt-3"><input type="hidden" name="id" value="@cita.Id" /><input type="hidden" name="revision" value="@cita.Revision" /><button class="dash-button" name="accion" value="confirmar">Aceptar cita</button></form>
    }
    @if(!professional){<a class="dash-button mt-3" asp-controller="Estudiante" asp-action="Citas" asp-route-reprogramar="@cita.Id">Reprogramar</a>}
    <details class="mt-3"><summary>Cancelar@(professional&&cita.Estado==EstadoCita.Solicitada?" o rechazar solicitud":" cita")</summary>
    <form asp-controller="Citas" asp-action="Gestionar" method="post" class="agenda-form mt-3"><input type="hidden" name="id" value="@cita.Id" /><input type="hidden" name="revision" value="@cita.Revision" /><label>Motivo breve<input name="motivo" maxlength="300" required /></label><button class="dash-button" name="accion" value="cancelar">Cancelar cita</button>@if(professional&&cita.Estado==EstadoCita.Solicitada){<button class="dash-button" name="accion" value="rechazar">Rechazar solicitud</button>}</form>
    </details>
}
@if(!professional&&cita.Estado==EstadoCita.Terminada){<a asp-controller="Estudiante" asp-action="Resultados">Ver reseña y recomendaciones</a>}
@if(professional&&cita.Estado==EstadoCita.Solicitada&&cita.InicioUtc<=DateTime.UtcNow){<p>Esta solicitud pasó su horario sin confirmación. Recházala y coordina una nueva fecha.</p><form asp-controller="Citas" asp-action="Gestionar" method="post" class="agenda-form"><input type="hidden" name="id" value="@cita.Id" /><input type="hidden" name="revision" value="@cita.Revision" /><label>Motivo<input name="motivo" maxlength="300" required /></label><button class="dash-button" name="accion" value="rechazar">Rechazar solicitud vencida</button></form>}
@if(!professional&&cita.Estado==EstadoCita.NoAsistio&&!string.IsNullOrWhiteSpace(cita.Resena)){<p>@cita.Resena</p>}
</article>
}
