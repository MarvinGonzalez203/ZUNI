<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ZUNI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Zuni.styles.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light zuni-navbar py-3">
            <div class="container">
                <a class="navbar-brand brand" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/images/zuni-logo-transparent.png" alt="" />ZUNI<span>.</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var fullName = User.Identity.Name?.Trim() ?? string.Empty;
                            var firstName = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Usuario";
                            var displayName = firstName.Length == 0
                                ? "Usuario"
                                : char.ToUpper(firstName[0], System.Globalization.CultureInfo.CurrentCulture) + firstName[1..].ToLower(System.Globalization.CultureInfo.CurrentCulture);
                            <span class="text-secondary small me-2">Hola, <strong class="text-dark">@displayName</strong></span>
                            <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post"><button class="btn btn-outline-secondary" type="submit">Cerrar sesión</button></form>
                        }
                        else
                        {
                            <a class="btn btn-link text-dark text-decoration-none" asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a>
                            <a class="btn btn-zuni" asp-controller="Cuenta" asp-action="Registro">Crear cuenta</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container page-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year ZUNI. Todos los derechos reservados.
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
