<div class="zuni-view-controls">
    @if(User.Identity?.IsAuthenticated==true && ViewData["MostrarNovedadesSistema"] is true){@await Component.InvokeAsync("Actualizaciones")}
    <partial name="_SelectorIdioma" />
    <button type="button" class="zuni-square-control zuni-theme-toggle" aria-label="@(Idioma.EsIngles ? "Switch to dark theme" : "Cambiar a tema oscuro")" title="@(Idioma.EsIngles ? "Switch theme" : "Cambiar tema")">
        <svg class="theme-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"/></svg>
        <svg class="theme-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
    </button>
</div>
