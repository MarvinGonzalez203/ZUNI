@model Zuni.Models.Agenda.AlmuerzoInput
<section class="dash-card agenda-card"><details><summary>@Idioma.Texto("Horario de almuerzo ·") @(Model.Habilitado?$"{Model.Inicio:HH:mm}–{Model.Fin:HH:mm}":Idioma.Texto("Sin bloqueo configurado"))</summary><p>@Idioma.Texto("El bloqueo se aplica todos los días a las nuevas citas, incluidas las propuestas del Director. Reprograma las citas existentes que se crucen antes de cambiarlo.")</p>
<form asp-controller="Psicologo" asp-action="GuardarAlmuerzo" method="post" class="row g-3"><input asp-for="Revision" type="hidden"/><div class="col-12"><label><input asp-for="Habilitado"/> @Idioma.Texto("Bloquear el horario de almuerzo")</label></div><div class="col-md-5"><label asp-for="Inicio" class="form-label">@Idioma.Texto("Inicio del almuerzo")</label><input asp-for="Inicio" type="time" min="08:00" max="18:00" step="300" required class="form-control"/></div><div class="col-md-5"><label asp-for="Fin" class="form-label">@Idioma.Texto("Fin del almuerzo")</label><input asp-for="Fin" type="time" min="08:00" max="18:00" step="300" required class="form-control"/></div><div class="col-12"><button class="dash-button">@Idioma.Texto("Guardar almuerzo")</button></div></form></details></section>
