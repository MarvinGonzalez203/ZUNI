<aside class="dash-card mb-3 virtual-advice" aria-label="@Idioma.Texto("Antes de tu cita virtual")"><h2 class="h5">@Idioma.Texto("Antes de tu cita virtual")</h2><div class="virtual-advice-grid"><div><partial name="_DashboardIcon" model='@("shield")' /><strong>@Idioma.Texto("Busca privacidad")</strong><p>@Idioma.Texto("Procura estar a solas en un lugar donde puedas hablar sin que otras personas escuchen.")</p></div><div><partial name="_DashboardIcon" model='@("phone")' /><strong>@Idioma.Texto("Reduce las interrupciones")</strong><p>@Idioma.Texto("Elige un espacio sin ruido, usa audífonos si puedes y comprueba tu conexión y micrófono.")</p></div><div><partial name="_DashboardIcon" model='@("calendar")' /><strong>@Idioma.Texto("Entra desde tu propia cita")</strong><p>@Idioma.Texto("No compartas el enlace ni grabes la sesión. Si alguien puede escucharte o no tienes privacidad, coméntalo al psicólogo antes de empezar.")</p></div></div></aside>
