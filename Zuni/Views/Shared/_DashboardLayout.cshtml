@inject Zuni.Data.ApplicationDbContext DbInstitucion
@{
    var esProveedor = User.IsInRole("SuperAdmin");
    var identidadInstitucion = esProveedor ? new Zuni.Models.Institucion.ConfiguracionInstitucion() : await Zuni.Services.Institucion.ConfiguracionInstitucionService.ObtenerAsync(DbInstitucion);
    if(esProveedor) identidadInstitucion.ColorPrincipal = (await Zuni.Services.Institucion.TarifasService.Apariencia(DbInstitucion,Context.RequestAborted)).ColorPrincipal;
    var rolActivo=Zuni.Services.Institucion.PreferenciasVistaService.Rol(User,ViewData["PreferenciaRol"] as string??ViewData["DashboardController"] as string);
    ViewData["PreferenciaRol"]=rolActivo;
    if(rolActivo is not null && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value is string usuarioVista){
        identidadInstitucion.ColorPrincipal=(await Zuni.Services.Institucion.PreferenciasVistaService.Obtener(DbInstitucion,usuarioVista,rolActivo,identidadInstitucion.ColorPrincipal,Context.RequestAborted)).ColorPrincipal;
    }
    Layout = null;
    var nombre = ViewData["DashboardName"] as string ?? User.Identity?.Name ?? "Usuario";
    var primero = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Usuario";
    var corto = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(primero.ToLower());
    var rol = ViewData["DashboardRole"] as string ?? string.Empty;
    var inicio = esProveedor ? "SuperAdmin" : ViewData["DashboardController"] as string ?? "Home";
    var panel = esProveedor ? "SuperAdmin" : ViewData["PanelController"] as string ?? new[]{"Administrador","Director","Psicologo","Estudiante"}.FirstOrDefault(User.IsInRole) ?? inicio;
    var navegacion = rolActivo is not null ? $"~/Views/{rolActivo}/_Navegacion.cshtml" : ViewData["DashboardNavigation"] as string;
}
<!DOCTYPE html>
<html lang="@Idioma.Codigo">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["TituloEsDato"] is true ? ViewData["Title"]?.ToString() : Idioma.Texto(ViewData["Title"]?.ToString())) · ZUNI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/campos-obligatorios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modales.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/agenda-contexto.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <partial name="_IdentidadInstitucion" model="identidadInstitucion" />
    <link rel="stylesheet" href="~/css/idioma.css" asp-append-version="true" />
    <partial name="_TemaHead" />
</head>
<body class="dashboard-app">
    <a href="#dashboard-main" class="dash-skip">@Idioma.Texto("Saltar al contenido")</a>
    <aside class="dashboard-sidebar offcanvas offcanvas-start" tabindex="-1" id="dashboard-sidebar" aria-labelledby="sidebar-title" data-nav-key="@navegacion">
        <div class="dash-brand-row">
            <a class="dash-brand" asp-controller="@inicio" asp-action="Index" id="sidebar-title"><span class="dash-logo-mark" aria-hidden="true"><i class="dash-logo-glass"></i><i class="dash-logo-glass dash-logo-glass-second"></i><img src="~/images/zuni-logo-transparent.png" alt="" /></span> @Idioma.Texto("ZUNI")<span>.</span></a>
            <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" aria-label="@Idioma.Texto("Cerrar menú")"></button>
        </div>
        <p class="dash-sidebar-caption">@(esProveedor?"ZUNI":identidadInstitucion.Nombre)<br />@(esProveedor?Idioma.Texto("Servicios para instituciones educativas"):identidadInstitucion.Lema)</p>
        @if (identidadInstitucion.LogotipoPng is not null) { <img src="@Url.Action("Logotipo", "Institucion")" alt="@Idioma.Texto("Logo de {0}", identidadInstitucion.Nombre)" style="max-width:160px;max-height:80px;object-fit:contain;margin-bottom:16px" /> }
        @if (navegacion is not null)
        {
            @await Html.PartialAsync(navegacion)
        }
        <div class="dash-sidebar-bottom">
            <div class="dash-support-note"><partial name="_DashboardIcon" model='@("spark")' /><p>@Idioma.Texto("Tu bienestar también")<br />@Idioma.Texto("forma parte del camino.")</p></div>
            <div class="dash-bottom-controls">
            @if(ViewData["DashboardAccountUnavailable"] is not true){
                <a class="dash-bottom-action dash-account" asp-controller="MiCuenta" asp-action="Index" title="@Idioma.Texto("Ver mi cuenta: {0}",nombre)">
                    <span class="dash-round-control" aria-hidden="true"><span class="dash-avatar">@corto[..1]</span></span>
                    <span class="dash-bottom-label"><strong>@corto</strong><small>@Idioma.Roles(rol)</small></span>
                </a>
            }
            <a class="dash-bottom-action" asp-controller="Home" asp-action="Index">
                <span class="dash-round-control" aria-hidden="true"><partial name="_DashboardIcon" model='@("home")'/></span><span class="dash-bottom-label">@Idioma.Texto("Inicio")</span>
            </a>
            <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post"><button class="dash-bottom-action dash-logout" type="submit">
                <span class="dash-round-control" aria-hidden="true"><partial name="_DashboardIcon" model='@("logout")'/></span><span class="dash-bottom-label">@Idioma.Texto("Cerrar sesión")</span>
            </button></form>
            </div>
        </div>
    </aside>
    <div class="dashboard-workspace">
        <header class="dashboard-topbar">
            <div class="dash-top-title"><button type="button" class="dash-menu d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#dashboard-sidebar" aria-controls="dashboard-sidebar" aria-label="@Idioma.Texto("Abrir menú")"><partial name="_DashboardIcon" model='@("menu")' /></button><span><a class="dash-space-link" asp-controller="@panel" asp-action="Index">@Idioma.Texto("Mi espacio")</a> <span class="dash-slash">/</span> <strong>@(ViewData["TituloEsDato"] is true ? ViewData["Title"]?.ToString() : Idioma.Texto(ViewData["Title"]?.ToString()))</strong></span></div>
            <div class="dash-top-account">@if(!esProveedor){@await Component.InvokeAsync("AvisoEdad")@await Component.InvokeAsync("AvisoCitas")}<span class="dash-session"><partial name="_DashboardIcon" model='@("shield")' />@Idioma.Texto("Sesión activa")</span><a class="dash-top-profile" asp-controller="MiCuenta" asp-action="Index" aria-label="@Idioma.Texto("Ver mi cuenta: {0}", corto)"><span class="dash-avatar dash-avatar-small" aria-hidden="true">@corto[..1]</span><span>@corto</span></a><partial name="_ControlesVista" /></div>
        </header>
        <main id="dashboard-main" class="dashboard-main" tabindex="-1">
            @if (TempData["Success"] is string mensaje)
            {
                <div class="dash-notice" role="status">@Idioma.Texto(mensaje)</div>
            }
            @RenderBody()
            <footer class="dash-footer"><span>@Idioma.Texto("ZUNI · Bienestar y acompañamiento estudiantil")</span><span>@Idioma.Texto("Tu espacio. Tu ritmo.")</span></footer>
        </main>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_IdiomaScripts" />
    <script src="~/js/modales.js" asp-append-version="true"></script>
    <script src="~/js/campos-obligatorios.js" asp-append-version="true"></script>
    <button class="dashboard-scroll-cue" type="button" hidden aria-controls="dashboard-main" aria-label="@Idioma.Texto("Ver más contenido")"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 9 7 7 7-7"/></svg></button>
    <script src="~/js/panel-desplazamiento.js" asp-append-version="true"></script>
    <script src="~/js/agenda-contexto.js" asp-append-version="true"></script>
    <script>
        window.addEventListener('resize', () => {
            if (window.innerWidth >= 992) {
                bootstrap.Offcanvas.getInstance(document.getElementById('dashboard-sidebar'))?.hide();
            }
        });
    </script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/sesion-activa.js" asp-append-version="true" data-url="@Url.Action("MantenerSesion", "Cuenta")"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
