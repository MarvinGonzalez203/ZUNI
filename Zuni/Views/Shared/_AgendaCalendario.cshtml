@model Zuni.Models.Agenda.CalendarioAgendaViewModel
@using Zuni.Models.Agenda
@using Zuni.Services.Agenda
@{
    var cultura = System.Globalization.CultureInfo.GetCultureInfo("es-GT");
    var minimo = new DateOnly(Model.Hoy.Year, Model.Hoy.Month, 1);
    var offset = ((int)Model.Mes.DayOfWeek + 6) % 7;
}
<section class="dash-card agenda-card agenda-mensual" aria-label="Calendario mensual">
    <nav class="agenda-month" aria-label="Mes del calendario">
        @if (Model.Mes > minimo) { <a class="dash-button" href="?fecha=@Model.Mes.AddMonths(-1).ToString("yyyy-MM-dd")">← Anterior</a> }
        else { <span></span> }
        <h2>@Model.Mes.ToString("MMMM yyyy", cultura)</h2>
        @if (Model.Mes < minimo.AddMonths(12)) { <a class="dash-button" href="?fecha=@Model.Mes.AddMonths(1).ToString("yyyy-MM-dd")">Siguiente →</a> }
        else { <span></span> }
    </nav>
    <p class="agenda-legend"><span class="is-free">Disponible</span><span class="is-busy">Ocupado</span><span>Sin horarios</span></p>
    <p class="agenda-hint">@(Model.Editor ? "Selecciona un día para consultar o configurar sus horarios." : "Selecciona un día para consultar las franjas de tu psicólogo asignado.") Hora de Guatemala (UTC−6).</p>
    <div class="agenda-grid">
        @foreach (var nombre in new[] { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" }) { <span class="agenda-weekday">@nombre</span> }
        @for (var i = 0; i < offset; i++) { <span aria-hidden="true"></span> }
        @foreach (var dia in Model.Dias)
        {
            var estado = dia.Estado == "Disponible" ? "is-free" : dia.Estado == "Ocupado" ? "is-busy" : "";
            <button type="button" class="agenda-day @estado" disabled="@(!dia.Editable)" data-bs-toggle="modal" data-bs-target="#dia-@dia.Fecha.ToString("yyyy-MM-dd")" aria-label="@dia.Fecha.ToString("dd MMMM yyyy", cultura): @dia.Estado"><strong>@dia.Fecha.Day</strong><span>@dia.Estado</span></button>
        }
    </div>
</section>
@foreach (var dia in Model.Dias.Where(d => d.Editable))
{
    var clave = "dia-" + dia.Fecha.ToString("yyyy-MM-dd");
    <div class="modal fade agenda-modal" id="@clave" tabindex="-1" aria-labelledby="@clave-titulo" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
            <div class="modal-header"><h2 class="modal-title fs-5" id="@clave-titulo">@dia.Fecha.ToString("dddd dd MMMM yyyy", cultura)</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
            <div class="modal-body">
                <p class="agenda-hint">Hora de Guatemala (UTC−6)</p><h3 class="h5">Horarios de este día</h3>
                @if (dia.Bloqueado) { <p class="agenda-notice">Día bloqueado. La configuración se conserva y no admite solicitudes.</p> }
                @if (Model.Editor)
                {
                    <p class="agenda-hint">@(dia.UsaBaseSemanal ? "Se utiliza la disponibilidad semanal como base." : "Configuración exclusiva de esta fecha.")</p>
                    @if (dia.Intervalos.Count == 0) { <p>Sin horarios para esta fecha.</p> }
                    @foreach (var h in dia.Intervalos)
                    {
                        <div class="agenda-slot">
                            <p><strong>@h.Inicio.ToString("HH:mm")–@h.Fin.ToString("HH:mm")</strong> · @h.Modalidad · @(h.DuracionMinutos == 0 ? "Sin duración establecida (cada cita elige su duración)" : $"{h.DuracionMinutos} minutos")</p>
                            <p>@(h.TieneCitasActivas ? "Con citas activas" : dia.Bloqueado ? "Bloqueado" : "Configurado")</p>
                            <form asp-controller="Psicologo" asp-action="CambiarDia" method="post">
                                <input type="hidden" name="fecha" value="@dia.Fecha.ToString("yyyy-MM-dd")" /><input type="hidden" name="operacion" value="quitar" /><input type="hidden" name="horarioId" value="@h.Id" />
                                <button class="btn btn-outline-secondary" type="submit" disabled="@h.TieneCitasActivas">Quitar horario</button>
                            </form>
                        </div>
                    }
                    @if (!dia.Bloqueado)
                    {
                        <h3 class="h5 mt-4">Añadir horario disponible</h3>
                        <p class="agenda-hint">De 08:00 a 18:00, en múltiplos de 5 minutos y sin superposiciones.</p>
                        <form asp-controller="Psicologo" asp-action="AgregarHorarioDia" method="post" class="agenda-form">
                            <input type="hidden" name="Fecha" value="@dia.Fecha.ToString("yyyy-MM-dd")" />
                            <label for="@clave-inicio">Inicio<input id="@clave-inicio" type="time" name="HoraInicio" min="08:00" max="18:00" step="300" value="08:00" required /></label>
                            <label for="@clave-fin">Fin<input id="@clave-fin" type="time" name="HoraFin" min="08:00" max="18:00" step="300" value="12:00" required /></label>
                            <label zuni-required="true" for="@clave-duracion">Duración de cada cita<select id="@clave-duracion" name="DuracionMinutos"><option value="15">15 minutos</option><option value="30">30 minutos</option><option value="50" selected>50 minutos</option><option value="0">Sin duración establecida</option></select></label>
                            <label zuni-required="true" for="@clave-modalidad">Modalidad<select id="@clave-modalidad" name="Modalidad"><option value="Presencial">Presencial</option><option value="Virtual">Virtual</option><option value="Ambas">Ambas</option></select></label>
                            <button class="dash-button" type="submit">Guardar horario</button>
                        </form>
                    }
                    <h3 class="h5 mt-4">Disponibilidad del día</h3>
                    <form asp-controller="Psicologo" asp-action="CambiarDia" method="post" class="agenda-actions">
                        <input type="hidden" name="fecha" value="@dia.Fecha.ToString("yyyy-MM-dd")" />
                        <button class="dash-button" type="submit" name="operacion" value="@(dia.Bloqueado ? "habilitar" : "bloquear")" disabled="@(!dia.Bloqueado && dia.TieneCitasActivas)">@(dia.Bloqueado ? "Habilitar día" : "Marcar día ocupado")</button>
                        <button class="btn btn-outline-secondary" type="submit" name="operacion" value="limpiar" disabled="@dia.TieneCitasActivas">Quitar configuración del día</button>
                    </form>
                    <p class="agenda-hint mt-2">Bloquear conserva los horarios. Quitar la configuración deja solo esta fecha sin horarios; no elimina citas ni cambia otras fechas.</p>
                    @if (dia.TieneCitasActivas) { <p>Este día tiene citas activas. Debes gestionarlas antes de modificar sus horarios.</p> }
                }
                else if (!dia.Bloqueado)
                {
                    @if (dia.CitaPropiaActiva) { <p class="agenda-notice">Ya tienes una cita activa para esta fecha.</p> }
                    @if (dia.Franjas.Count == 0) { <p>No hay franjas futuras disponibles para esta fecha.</p> }
                    @foreach (var h in dia.Franjas)
                    {
                        var campo = clave + "-modalidad-" + h.InicioUtc.Ticks;
                        <div class="agenda-slot @(h.Ocupada ? "is-busy" : "")">
                            <p><strong>@AgendaReglas.Local(h.InicioUtc).ToString("HH:mm")–@AgendaReglas.Local(h.FinUtc).ToString("HH:mm")</strong> · @h.Modalidad · @((h.FinUtc - h.InicioUtc).TotalMinutes) minutos</p>
                            @if (h.Ocupada) { <p>Reservado / ocupado</p> }
                            else
                            {
                                <p>Disponible</p>
                                @if (!dia.CitaPropiaActiva)
                                {
                                    <form asp-controller="Estudiante" asp-action="ReservarCita" method="post" class="agenda-form">
                                        @if (h.Variable)
                                        {
                                            // Sin duración establecida: la cita ocupa solo [inicio, inicio + duración].
                                            var maximo = (int)(h.FinUtc - h.InicioUtc).TotalMinutes;
                                            <label for="@(campo)-inicio">Hora de inicio<select id="@(campo)-inicio" name="Inicio" required>
                                                @for (var inicioOpcion = h.InicioUtc; inicioOpcion.AddMinutes(AgendaReglas.DuracionesVariables[0]) <= h.FinUtc; inicioOpcion = inicioOpcion.AddMinutes(AgendaReglas.PasoVariableMinutos))
                                                {
                                                    <option value="@inicioOpcion.ToString("O")">@AgendaReglas.Local(inicioOpcion).ToString("HH:mm")</option>
                                                }
                                            </select></label>
                                            <label for="@(campo)-duracion">Duración<select id="@(campo)-duracion" name="DuracionMinutos" required>
                                                @foreach (var minutosOpcion in AgendaReglas.DuracionesVariables.Where(m => m <= maximo))
                                                {
                                                    <option value="@minutosOpcion">@minutosOpcion minutos</option>
                                                }
                                            </select></label>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="Inicio" value="@h.InicioUtc.ToString("O")" />
                                        }
                                        <label for="@campo">Modalidad<select id="@campo" name="Modalidad" required>
                                            @if (h.Modalidad is ModalidadDisponibilidad.Presencial or ModalidadDisponibilidad.Ambas) { <option value="Presencial">Presencial</option> }
                                            @if (h.Modalidad is ModalidadDisponibilidad.Virtual or ModalidadDisponibilidad.Ambas) { <option value="Virtual">Virtual</option> }
                                        </select></label><button class="dash-button" type="submit">Solicitar cita</button>
                                    </form>
                                }
                            }
                            @if (h.Variable && !h.Ocupada) { <p class="agenda-hint">Horario sin duración fija: elige la hora de inicio y la duración de tu cita. Debe terminar antes de las @AgendaReglas.Local(h.FinUtc).ToString("HH:mm").</p> }
                        </div>
                    }
                }
            </div>
            <div class="modal-footer"><button type="button" class="dash-button" data-bs-dismiss="modal">Cerrar</button></div>
        </div></div>
    </div>
}
