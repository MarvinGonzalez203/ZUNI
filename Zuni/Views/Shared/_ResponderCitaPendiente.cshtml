@model Zuni.Models.Agenda.CitaCalendarioResumen
@inject TimeProvider Reloj
@if(Model.Estado==Zuni.Models.Agenda.EstadoCita.Solicitada){
var deDireccion = Model.ProgramadorRol == "Director"; var sinAsignacion = deDireccion && !Model.AsignadoAlProfesional; var futura = Model.InicioUtc > Reloj.GetUtcNow().UtcDateTime;
<div class="agenda-pending-review"><strong>@Idioma.Texto("Pendiente de revisar") @(deDireccion?Idioma.Texto("· Propuesta de Dirección"):"")</strong>
<form asp-controller="Psicologo" asp-action="GestionarCita" method="post" class="agenda-response-form"><input type="hidden" name="CitaId" value="@Model.Id"/><input type="hidden" name="Revision" value="@Model.Revision"/>
@if(deDireccion){<partial name="_MotivoPropuestaDirector" model='@("respuesta-" + Model.Id)' />}
else{<label for="respuesta-@Model.Id">@Idioma.Texto("Motivo administrativo si no puedes atender") @Idioma.Texto("(opcional)")</label><textarea id="respuesta-@Model.Id" name="MotivoCancelacion" maxlength="300" rows="2" class="form-control" placeholder="@Idioma.Texto("Ej.: conflicto de horario. Evita incluir datos clínicos.")"></textarea>}
@if(sinAsignacion){<p class="small mb-1" data-propuesta-sin-asignacion>@Idioma.Texto("Para aceptarla, el estudiante debe tener una solicitud de atención asignada a ti. Puedes reprogramarla después de la asignación o rechazarla con un motivo de la lista.")</p>}
@if(Model.Modalidad==Zuni.Models.Agenda.ModalidadCita.Presencial&&!sinAsignacion){<label for="lugar-@Model.Id">@Idioma.Texto("Dirección o lugar de atención presencial")</label><textarea id="lugar-@Model.Id" name="DireccionAtencion" maxlength="500" rows="2" class="form-control">@Model.DireccionAtencion</textarea>}
<div class="agenda-actions">@if(Model.Modalidad==Zuni.Models.Agenda.ModalidadCita.Presencial&&futura&&!sinAsignacion){<button class="dash-button" name="Estado" value="Confirmada">@Idioma.Texto("Aceptar cita")</button>}<button class="btn btn-outline-secondary" name="Estado" value="Rechazada">@(deDireccion?Idioma.Texto("Rechazar propuesta"):Idioma.Texto("No puedo atender / responder"))</button></div></form>
@if(Model.Modalidad==Zuni.Models.Agenda.ModalidadCita.Virtual&&futura&&!sinAsignacion){<a asp-controller="Reuniones" asp-action="Preparar" asp-route-citaId="@Model.Id" class="dash-button">@Idioma.Texto("Preparar enlace y confirmar cita virtual")</a>}
</div>}
