<nav class="test-navigation dash-card" aria-label="@Idioma.Texto("Navegación de preguntas")" hidden>
    <p data-test-status role="status" aria-live="polite"></p>
    <progress data-test-progress value="0" max="100" aria-label="@Idioma.Texto("Avance de respuestas")"></progress>
    <div class="zuni-action-row mt-3"><button type="button" class="btn btn-outline-secondary" data-test-back>@Idioma.Texto("Anterior")</button><span data-test-page></span><button type="button" class="dash-button" data-test-next>@Idioma.Texto("Siguiente")</button></div>
    <p class="text-danger mb-0 mt-2" data-test-error role="alert" hidden>@Idioma.Texto("Responde las preguntas de esta pantalla para continuar.")</p>
</nav>
