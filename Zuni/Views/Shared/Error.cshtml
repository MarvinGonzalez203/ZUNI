@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">@Idioma.Texto("Error.")</h1>
<h2 class="text-danger">@Idioma.Texto("Ocurrió un error al procesar tu solicitud.")</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Idioma.Texto("Identificador de solicitud:")</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@Idioma.Texto("Modo de desarrollo")</h3>
<p>
    @Idioma.Texto("El entorno de desarrollo muestra más información sobre los errores.")
</p>
<p>
    <strong>@Idioma.Texto("No habilites el entorno de desarrollo en aplicaciones publicadas.")</strong>
    @Idioma.Texto("Solo para depuración local, configura ASPNETCORE_ENVIRONMENT con el valor Development y reinicia la aplicación.")
</p>
