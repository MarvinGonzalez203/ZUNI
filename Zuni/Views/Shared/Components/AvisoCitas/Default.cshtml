@model int
<a asp-controller="CitasProgramadas" asp-action="Notificaciones" class="dash-text-link dash-notification" data-avisos-citas data-cantidad="@Model" data-url="@Url.Action("Pendientes","CitasProgramadas")" aria-label="@Idioma.Texto("Notificaciones") (@Model)"><partial name="_DashboardIcon" model='@("calendar")' /><span class="notification-label">@Idioma.Texto("Notificaciones")</span><strong data-avisos-cantidad hidden="@(Model==0)">(@Model)</strong></a>
<span class="visually-hidden" data-avisos-estado role="status" aria-live="polite"></span>
