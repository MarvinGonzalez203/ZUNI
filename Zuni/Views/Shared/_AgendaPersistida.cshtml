@model Zuni.Models.AgendaCalendario
@using Zuni.Services
@{
    var now=AgendaService.Ahora;var today=DateOnly.FromDateTime(now);var currentTime=TimeOnly.FromDateTime(now);
    var first=Model.Mes;var offset=((int)first.DayOfWeek+6)%7;var count=DateTime.DaysInMonth(first.Year,first.Month);
    var min=new DateOnly(today.Year,today.Month,1);var culture=System.Globalization.CultureInfo.GetCultureInfo("es-GT");
    var selected=DateOnly.TryParse(Context.Request.Query["fecha"],out var requested)&&requested>=today&&requested<=today.AddMonths(12)?requested:first<today?today:first;
    TimeOnly? AvailableStart(HorarioAgendaPsicologo h,DateOnly date)=>AgendaService.InicioDisponible(h,date,now);
    bool Available(HorarioAgendaPsicologo h,DateOnly date)=>AvailableStart(h,date)!=null;
}
<section class="dash-card agenda-persistida">
<nav class="agenda-month" aria-label="Mes del calendario">
@if(first>min){<a class="dash-button" href="?mes=@first.AddMonths(-1).ToString("yyyy-MM-dd")">← Anterior</a>}
<h2>@first.ToString("MMMM yyyy",culture)</h2>
@if(first<min.AddMonths(12)){<a class="dash-button" href="?mes=@first.AddMonths(1).ToString("yyyy-MM-dd")">Siguiente →</a>}
</nav>
<p>🟢 Disponible · 🔴 Ocupado · ⚪ Sin horarios definidos</p>
<div class="agenda-grid" aria-label="Calendario mensual">
@foreach(var weekday in new[]{"Lun","Mar","Mié","Jue","Vie","Sáb","Dom"}){<span class="agenda-weekday">@weekday</span>}
@for(var blank=0;blank<offset;blank++){<span aria-hidden="true"></span>}
@for(var n=1;n<=count;n++){
    var date=first.AddDays(n-1);var day=Model.Dias.SingleOrDefault(d=>d.Fecha==date);
    var free=day is {Ocupado:false} && day.Horarios.Any(h=>Available(h,date));
    var label=date<today ? "Pasado" : day?.Ocupado==true ? "Ocupado" : free ? "Disponible" : "Sin horarios";
    if(Model.Editor && date>=today&&date<=today.AddMonths(12)){
    <a class="agenda-day @(free?"is-free":day?.Ocupado==true?"is-busy":"")" href="?mes=@first.ToString("yyyy-MM-dd")&amp;fecha=@date.ToString("yyyy-MM-dd")#editar-horario" aria-label="Configurar @date.ToString("dd MMMM",culture): @label"><strong>@n</strong><span>@label</span></a>
    } else if(day is not null && date>=today){
    <a class="agenda-day @(free?"is-free":day.Ocupado?"is-busy":"")" href="#dia-@date.ToString("yyyy-MM-dd")" aria-label="@date.ToString("dd MMMM",culture): @label"><strong>@n</strong><span>@label</span></a>
    } else {<span class="agenda-day" aria-label="@date.ToString("dd MMMM",culture): @label"><strong>@n</strong><span>@label</span></span>}
}
</div>
</section>
@if(Model.Editor){
<section class="dash-card mt-4 agenda-detail" id="editar-horario"><h2>Añadir horario disponible</h2><p>Selecciona un día del calendario o escribe su fecha. De 08:00 a 18:00. Los cambios se guardan y se reflejan al volver a cargar el calendario del estudiante.</p>
<form asp-controller="Psicologo" asp-action="Disponibilidad" method="post" class="agenda-form">
<input type="hidden" name="operacion" value="agregar" />
<label>Fecha<input type="date" name="Fecha" min="@today.ToString("yyyy-MM-dd")" max="@today.AddMonths(12).ToString("yyyy-MM-dd")" value="@selected.ToString("yyyy-MM-dd")" required /></label>
<label>Inicio<input type="time" name="Inicio" min="08:00" max="18:00" step="300" value="08:00" required /></label>
<label>Fin<input type="time" name="Fin" min="08:00" max="18:00" step="300" value="12:00" required /></label>
<label>Duración de cada cita<select name="DuracionMinutos">@foreach(var duration in new[]{15,30,45,50,60}){<option value="@duration">@duration minutos</option>}</select></label>
<label>Modalidad<select name="Modalidad"><option>Presencial</option><option>Virtual</option></select></label>
<button class="dash-button" type="submit">Guardar horario</button>
</form>
<h3 class="mt-4">Marcar un día ocupado</h3><form asp-controller="Psicologo" asp-action="Disponibilidad" method="post" class="agenda-form"><input type="hidden" name="operacion" value="bloquear" /><label>Fecha<input type="date" name="Fecha" min="@today.ToString("yyyy-MM-dd")" max="@today.AddMonths(12).ToString("yyyy-MM-dd")" value="@selected.ToString("yyyy-MM-dd")" required /></label><button class="dash-button" type="submit">Guardar día ocupado</button></form>
</section>
}
<section class="dash-card mt-4"><h2>Horarios del mes</h2>
@if(!Model.Dias.Any(d=>d.Fecha>=today)){<p>@(Model.Editor?"Aún no has definido disponibilidad para este mes.":"Tu psicólogo aún no ha definido disponibilidad para este mes.")</p>}
@foreach(var day in Model.Dias.Where(d=>d.Fecha>=today)){
<article class="agenda-detail" id="dia-@day.Fecha.ToString("yyyy-MM-dd")"><h3>@day.Fecha.ToString("dddd dd MMMM",culture)</h3>
@if(day.Ocupado){<p>Día ocupado. No hay horarios disponibles.</p>}
else {
    var horarios=day.Horarios.OrderBy(h=>h.Inicio).Where(h=>Model.Editor || Available(h,day.Fecha)).ToArray();
    if(horarios.Length==0){<p>Sin horarios disponibles.</p>}
    foreach(var h in horarios){
    <p><strong>@(Model.Editor?h.Inicio.ToString("HH:mm"):AvailableStart(h,day.Fecha)?.ToString("HH:mm"))–@h.Fin.ToString("HH:mm")</strong> · @h.Modalidad · citas de @h.DuracionMinutos minutos</p>
    if(Model.Editor){<form asp-controller="Psicologo" asp-action="Disponibilidad" method="post"><input type="hidden" name="Fecha" value="@day.Fecha.ToString("yyyy-MM-dd")" /><input type="hidden" name="operacion" value="quitar" /><input type="hidden" name="horario" value="@h.Id" /><button class="dash-button" type="submit">Quitar horario</button></form>}
    }
}
@if(Model.Editor){
<form asp-controller="Psicologo" asp-action="Disponibilidad" method="post" class="agenda-actions"><input type="hidden" name="Fecha" value="@day.Fecha.ToString("yyyy-MM-dd")" />
<button class="dash-button" type="submit" name="operacion" value="@(day.Ocupado?"habilitar":"bloquear")">@(day.Ocupado?"Habilitar día":"Marcar ocupado")</button>
<button class="dash-button" type="submit" name="operacion" value="limpiar">Quitar configuración del día</button></form>
<p><small>Marcar ocupado conserva los horarios, pero los oculta al estudiante hasta habilitar el día. Quitar la configuración elimina sus horarios.</small></p>
}
</article>
}
</section>
