@{
    ViewData["Title"] = "Estudiantes";
}

<section class="dash-card p-4 p-md-5"
         aria-labelledby="estudiantes-titulo">

    <div class="dash-section-heading">
        <div>
            <h1 id="estudiantes-titulo" class="h2 mb-2">
                @Idioma.Texto("Estudiantes")
            </h1>

            <p>
                @Idioma.Texto("Aquí podrás consultar información académica de los estudiantes que tengas autorizados.")
            </p>
        </div>

        <span class="dash-badge">@Idioma.Texto("Próximamente")</span>
    </div>

    <div class="table-responsive mt-4">
        <table class="table align-middle">
            <caption>
                @Idioma.Texto("La consulta estará disponible cuando se integren las asignaciones académicas.")
            </caption>

            <thead>
                <tr>
                    <th scope="col">@Idioma.Texto("Carné")</th>
                    <th scope="col">@Idioma.Texto("Estudiante")</th>
                    <th scope="col">@Idioma.Texto("Curso")</th>
                    <th scope="col">@Idioma.Texto("Sección")</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td colspan="4" class="text-center py-5">
                        <span class="dash-icon-tile mx-auto mb-3">
                            <partial name="_DashboardIcon"
                                     model='@("user")' />
                        </span>

                        <strong class="d-block mb-2">
                            @Idioma.Texto("Información aún no disponible")
                        </strong>

                        <p class="text-secondary mb-0">
                            @Idioma.Texto("Aquí aparecerán únicamente los estudiantes vinculados a tus asignaciones autorizadas.")
                        </p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <p class="small text-secondary mt-3">
        @Idioma.Texto("Esta sección no permite buscar estudiantes ni consultar expedientes clínicos.")
    </p>

    <a class="dash-button mt-3"
       asp-controller="Catedratico"
       asp-action="Index">
        @Idioma.Texto("Volver al tablero")
        <partial name="_DashboardIcon" model='@("arrow")' />
    </a>
</section>