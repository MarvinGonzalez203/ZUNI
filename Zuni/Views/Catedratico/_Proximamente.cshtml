<section class="dash-card p-4 p-md-5"
         aria-labelledby="seccion-titulo">

    <span class="dash-badge mb-3">Próximamente</span>

    <h1 id="seccion-titulo" class="h2 mb-3">
        @ViewData["Title"]
    </h1>

    <p class="text-secondary mb-4">
        @ViewData["Descripcion"]
    </p>

    <p class="small text-secondary">
        Se habilitará al integrar el módulo correspondiente.
    </p>

    <a class="dash-button"
       asp-controller="Catedratico"
       asp-action="Index">
        Volver al tablero
        <partial name="_DashboardIcon" model='@("arrow")' />
    </a>
</section>