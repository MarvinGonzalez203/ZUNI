@{
    ViewData["Title"] = "Mis cursos";
}

<section class="dash-card p-4 p-md-5"
         aria-labelledby="cursos-titulo">

    <div class="dash-section-heading">
        <div>
            <h1 id="cursos-titulo" class="h2 mb-2">Mis cursos</h1>
            <p>
                Aquí podrás consultar los cursos y las secciones
                que tengas asignados.
            </p>
        </div>

        <span class="dash-badge">Próximamente</span>
    </div>

    <div class="table-responsive mt-4">
        <table class="table align-middle">
            <caption>
                La consulta de asignaciones todavía no está disponible.
            </caption>

            <thead>
                <tr>
                    <th scope="col">Curso</th>
                    <th scope="col">Sección</th>
                    <th scope="col">Período académico</th>
                    <th scope="col">Estudiantes inscritos</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td colspan="4" class="text-center py-5">
                        <span class="dash-icon-tile mx-auto mb-3">
                            <partial name="_DashboardIcon"
                                     model='@("book")' />
                        </span>

                        <strong class="d-block mb-2">
                            Información aún no disponible
                        </strong>

                        <p class="text-secondary mb-0">
                            Tus asignaciones aparecerán cuando
                            se habilite el módulo académico.
                        </p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <a class="dash-button mt-3"
       asp-controller="Catedratico"
       asp-action="Index">
        Volver al tablero
        <partial name="_DashboardIcon" model='@("arrow")' />
    </a>
</section>