@{
    ViewData["Title"] = "Mi cuenta";
    var nombre = User.Identity?.Name ?? "Catedrático";
}

<section class="dash-card p-4 p-md-5"
         aria-labelledby="cuenta-titulo">

    <div class="dash-section-heading">
        <div>
            <h1 id="cuenta-titulo" class="h2 mb-2">
                Mi cuenta
            </h1>

            <p>
                Información básica de tu sesión en ZUNI.
            </p>
        </div>
    </div>

    <dl class="row mt-4">
        <dt class="col-sm-4">Nombre</dt>
        <dd class="col-sm-8">@nombre</dd>

        <dt class="col-sm-4">Rol de este panel</dt>
        <dd class="col-sm-8">Catedrático</dd>
    </dl>

    <div class="border-top pt-4 mt-4">
        <span class="dash-badge mb-3">Próximamente</span>

        <h2 class="mb-3">Gestión de mi cuenta</h2>

        <p class="text-secondary">
            Las opciones para actualizar tus datos se habilitarán
            cuando se integre la gestión de cuenta correspondiente.
        </p>
    </div>

    <a class="dash-button mt-3"
       asp-controller="Catedratico"
       asp-action="Index">
        Volver al tablero
        <partial name="_DashboardIcon" model='@("arrow")' />
    </a>
</section> 