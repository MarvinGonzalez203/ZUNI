@{
    ViewData["Title"] = "Avance de evaluaciones";
}

<section class="dash-card p-4 p-md-5"
         aria-labelledby="avance-titulo">

    <div class="dash-section-heading">
        <div>
            <h1 id="avance-titulo" class="h2 mb-2">
                Avance de evaluaciones
            </h1>

            <p>
                Aquí podrás consultar la participación en evaluaciones
                de los estudiantes que tengas autorizados.
            </p>
        </div>

        <span class="dash-badge">Próximamente</span>
    </div>

    <div class="table-responsive mt-4">
        <table class="table align-middle">
            <caption>
                El resumen de participación todavía no está disponible.
            </caption>

            <thead>
                <tr>
                    <th scope="col">Curso / Sección</th>
                    <th scope="col">Evaluación</th>
                    <th scope="col">Completadas</th>
                    <th scope="col">Pendientes</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td colspan="4" class="text-center py-5">
                        <span class="dash-icon-tile mx-auto mb-3">
                            <partial name="_DashboardIcon"
                                     model='@("clipboard")' />
                        </span>

                        <strong class="d-block mb-2">
                            Información aún no disponible
                        </strong>

                        <p class="text-secondary mb-0">
                            El avance aparecerá cuando se integren
                            las evaluaciones y las asignaciones
                            académicas autorizadas.
                        </p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <p class="small text-secondary mt-3">
        Esta sección estará destinada al seguimiento de participación.
        No mostrará respuestas individuales ni información clínica.
    </p>

    <a class="dash-button mt-3"
       asp-controller="Catedratico"
       asp-action="Index">
        Volver al tablero
        <partial name="_DashboardIcon" model='@("arrow")' />
    </a>
</section>
