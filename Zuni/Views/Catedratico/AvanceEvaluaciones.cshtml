@{
    ViewData["Title"] = "Avance de evaluaciones";
}

<section class="dash-card p-4 p-md-5"
         aria-labelledby="avance-titulo">

    <div class="dash-section-heading">
        <div>
            <h1 id="avance-titulo" class="h2 mb-2">
                @Idioma.Texto("Avance de evaluaciones")
            </h1>

            <p>
                @Idioma.Texto("Aquí podrás consultar la participación en evaluaciones de los estudiantes que tengas autorizados.")
            </p>
        </div>

        <span class="dash-badge">@Idioma.Texto("Próximamente")</span>
    </div>

    <div class="table-responsive mt-4">
        <table class="table align-middle">
            <caption>
                @Idioma.Texto("El resumen de participación todavía no está disponible.")
            </caption>

            <thead>
                <tr>
                    <th scope="col">@Idioma.Texto("Curso / Sección")</th>
                    <th scope="col">@Idioma.Texto("Evaluación")</th>
                    <th scope="col">@Idioma.Texto("Completadas")</th>
                    <th scope="col">@Idioma.Texto("Pendientes")</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td colspan="4" class="text-center py-5">
                        <span class="dash-icon-tile mx-auto mb-3">
                            <partial name="_DashboardIcon"
                                     model='@("clipboard")' />
                        </span>

                        <strong class="d-block mb-2">
                            @Idioma.Texto("Información aún no disponible")
                        </strong>

                        <p class="text-secondary mb-0">
                            @Idioma.Texto("El avance aparecerá cuando se integren las evaluaciones y las asignaciones académicas autorizadas.")
                        </p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <p class="small text-secondary mt-3">
        @Idioma.Texto("Esta sección estará destinada al seguimiento de participación. No mostrará respuestas individuales ni información clínica.")
    </p>

    <a class="dash-button mt-3"
       asp-controller="Catedratico"
       asp-action="Index">
        @Idioma.Texto("Volver al tablero")
        <partial name="_DashboardIcon" model='@("arrow")' />
    </a>
</section>
