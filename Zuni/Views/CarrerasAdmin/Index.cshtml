@model IReadOnlyList<Zuni.Models.CarreraInstitucional>
@{ViewData["Title"]="Catálogo de carreras";}
<header class="dash-profile-heading"><div><span class="dash-eyebrow">@Idioma.Texto("CONFIGURACIÓN ACADÉMICA")</span><h1>@Idioma.Texto("Catálogo de carreras")</h1><p>@Idioma.Texto("Los estudiantes seleccionan su carrera de este listado. Deshabilitarla conserva los registros anteriores.")</p></div></header>
@if(TempData["Error"] is string error){<div class="dash-notice" role="alert">@Idioma.Texto(error)</div>}
<section class="dash-card mb-4"><h2>@Idioma.Texto("Subir listado")</h2><p>@Idioma.Texto("Usa TXT o CSV en UTF-8. Puedes escribir un área terminada en «:» y una carrera por línea, o usar «Área;Carrera». Las repetidas se omiten.")</p>
<form asp-action="Importar" method="post" enctype="multipart/form-data"><label for="Listado" class="form-label">@Idioma.Texto("Pegar carreras")</label><textarea id="Listado" name="Listado" rows="6" class="form-control mb-3" maxlength="100000" placeholder="@Idioma.Texto("CIENCIAS DE LA SALUD: - Licenciatura en Enfermería")"></textarea><label for="Archivo" class="form-label">@Idioma.Texto("O seleccionar TXT / CSV (máximo 100 KB)")</label><input id="Archivo" name="Archivo" type="file" accept=".txt,.csv" class="form-control mb-3"/><button class="dash-button">@Idioma.Texto("Agregar al catálogo")</button></form></section>
@foreach(var grupo in Model.GroupBy(c=>c.Area)){<section class="dash-card mb-3"><h2>@grupo.Key</h2><div class="table-responsive"><table class="table"><thead><tr><th>@Idioma.Texto("Carrera")</th><th>@Idioma.Texto("Estado")</th><th>@Idioma.Texto("Acción")</th></tr></thead><tbody>@foreach(var c in grupo){<tr><td>@c.Nombre</td><td>@(c.Activa?Idioma.Texto("Disponible"):"Inactiva")</td><td><form asp-action="Estado" method="post"><input type="hidden" name="id" value="@c.Id"/><input type="hidden" name="revision" value="@c.Revision"/><input type="hidden" name="activa" value="@(!c.Activa?"true":"false")"/><button class="btn btn-outline-secondary">@(c.Activa?Idioma.Texto("Deshabilitar"):Idioma.Texto("Habilitar"))</button></form></td></tr>}</tbody></table></div></section>}
