@model Zuni.Models.AsignacionesPruebaViewModel
@{
    ViewData["Title"] = "Asignaciones de cuestionarios";
}
<link rel="stylesheet" href="~/css/director.css" asp-append-version="true" />

<section class="director-dashboard py-4 py-lg-5" aria-labelledby="asignaciones-title">
    <div class="director-hero mb-4">
        <div>
            <div class="director-access-pill">Administración de evaluaciones</div>
            <h1 id="asignaciones-title">Asignaciones</h1>
            <p>Entrega cuestionarios exploratorios a estudiantes. Esta gestión no registra respuestas ni genera interpretaciones.</p>
        </div>
        <div class="director-hero-mark" aria-hidden="true">↗</div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="director-eyebrow mb-1">Seguimiento administrativo</p>
            <h2 class="h3 mb-0">Cuestionarios asignados <span class="text-secondary">(@Model.Asignaciones.Count)</span></h2>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Volver al panel</a>
            <a asp-action="AsignarPrueba" class="btn btn-zuni">Asignar cuestionario</a>
        </div>
    </div>

    <div class="alert alert-info" role="note">Las modalidades indican únicamente la cantidad de preguntas. Los cuestionarios deben mantenerse exploratorios y no sustituyen la entrevista ni el criterio de la psicóloga.</div>

    <div class="director-feature-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0 director-users-table">
                <thead><tr><th>Estudiante</th><th>Cuestionario</th><th>Modalidad</th><th>Fecha</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                @foreach (var asignacion in Model.Asignaciones)
                {
                    <tr>
                        <td><strong class="d-block">@asignacion.EstudianteNombre</strong><span class="small text-secondary">@asignacion.EstudianteCorreo</span></td>
                        <td>@asignacion.PruebaNombre</td>
                        <td>@Html.DisplayFor(_ => asignacion.Modalidad)</td>
                        <td class="small text-secondary">@asignacion.FechaAsignacionUtc.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td><span class="badge @(asignacion.Cancelada ? "text-bg-secondary" : "text-bg-success")">@(asignacion.Cancelada ? "Cancelada" : "Asignada")</span></td>
                        <td class="text-end">
                            @if (!asignacion.Cancelada)
                            {
                                <form asp-action="CancelarAsignacionPrueba" asp-route-id="@asignacion.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar asignación</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Asignaciones.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-secondary py-5">Todavía no hay cuestionarios asignados.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
