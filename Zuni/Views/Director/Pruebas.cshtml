@model Zuni.Models.PruebasViewModel

@{
    ViewData["Title"] = "Pruebas";
}

<link rel="stylesheet" href="~/css/director.css" asp-append-version="true" />

<section class="director-dashboard py-4 py-lg-5" aria-labelledby="pruebas-title">
    <div class="director-hero mb-4">
        <div>
            <div class="director-access-pill"><span aria-hidden="true">◆</span> Administración de evaluaciones</div>
            <h1 id="pruebas-title">Cuestionarios exploratorios</h1>
            <p>Crea y administra cuestionarios de gustos, preferencias e intereses. Habilitarlos permite asignarlos; no genera resultados.</p>
        </div>
        <div class="director-hero-mark" aria-hidden="true">P</div>
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <p class="director-eyebrow mb-1">Catálogo</p>
            <h2 class="h3 mb-0">Instrumentos registrados <span class="text-secondary">(@Model.Pruebas.Count)</span></h2>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Volver al panel</a>
            <a asp-action="CrearPrueba" class="btn btn-zuni">Nueva prueba</a>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <form asp-action="Pruebas" method="get" class="director-search-form mb-3">
        <label class="visually-hidden" for="buscar-prueba">Buscar pruebas</label>
        <input id="buscar-prueba" name="buscar" value="@Model.Buscar" class="form-control" maxlength="120" placeholder="Buscar por nombre o descripción" />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(Model.Buscar))
        {
            <a asp-action="Pruebas" class="btn btn-link">Limpiar</a>
        }
    </form>

    <div class="director-feature-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0 director-users-table">
                <thead><tr><th>Prueba</th><th>Estado</th><th>Última actualización</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var prueba in Model.Pruebas)
                    {
                        <tr>
                            <td>
                                <strong class="d-block">@prueba.Nombre</strong>
                                <span class="small text-secondary">@(string.IsNullOrWhiteSpace(prueba.Descripcion) ? "Sin descripción" : prueba.Descripcion)</span>
                            </td>
                            <td><span class="badge @(prueba.Activa ? "text-bg-success" : "text-bg-secondary")">@(prueba.Activa ? "Habilitado para asignar" : "Borrador / archivado")</span></td>
                            <td class="small text-secondary">@(prueba.FechaActualizacionUtc ?? prueba.FechaCreacionUtc).ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="director-prueba-actions justify-content-end">
                                    <a asp-action="Dimensiones" asp-route-pruebaId="@prueba.Id" class="btn btn-sm btn-zuni">Contenido</a>
                                    <a asp-action="EditarPrueba" asp-route-id="@prueba.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                    <form asp-action="CambiarEstadoPrueba" asp-route-id="@prueba.Id" method="post">
                                        <button type="submit" class="btn btn-sm @(prueba.Activa ? "btn-outline-danger" : "btn-outline-success")">@(prueba.Activa ? "Retirar de asignaciones" : "Habilitar para asignar")</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (Model.Pruebas.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-secondary py-5">@(string.IsNullOrWhiteSpace(Model.Buscar) ? "Aún no hay pruebas. Crea la primera para iniciar el catálogo." : "No se encontraron pruebas para esa búsqueda.")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="small text-secondary mt-3 mb-0">ZUNI solo organiza información exploratoria para apoyar la conversación profesional. No diagnostica, detecta riesgos ni reemplaza la entrevista o el criterio de la psicóloga.</p>
</section>
