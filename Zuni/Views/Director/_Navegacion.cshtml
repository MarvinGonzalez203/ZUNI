@{
    var ctrl=ViewContext.RouteData.Values["controller"]?.ToString();
    var act=ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string name)=>ctrl==name?"is-active":"";
    var accion = ViewContext.RouteData.Values["controller"]?.ToString() == "Director"
        ? ViewContext.RouteData.Values["action"]?.ToString() : null;
}
<nav class="dash-nav" aria-label="@Idioma.Texto("Navegación del Director")">
    <a class="dash-nav-link @(accion == "Index" ? "is-active" : "")" asp-controller="Director" asp-action="Index" aria-current="@(accion == "Index" ? "page" : null)"><partial name="_DashboardIcon" model='@("grid")' /><span>@Idioma.Texto("Tablero")</span></a>
<details class="dash-nav-group" open="@(ctrl=="PruebasDirector"||accion is "AvanceEvaluaciones" or "Estadisticas")"><summary><partial name="_DashboardIcon" model='@("clipboard")'/><span>@Idioma.Texto("Cuestionarios y evaluaciones")</span></summary><div class="dash-nav-children">
    <a class="dash-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PruebasDirector" ? "is-active" : "")" asp-controller="PruebasDirector" asp-action="Index"><partial name="_DashboardIcon" model='@("clipboard")' /><span>@Idioma.Texto("Gestión de cuestionarios")</span></a>
    <a class="dash-nav-link @(accion == "AvanceEvaluaciones" ? "is-active" : "")" asp-controller="Director" asp-action="AvanceEvaluaciones" aria-current="@(accion == "AvanceEvaluaciones" ? "page" : null)"><partial name="_DashboardIcon" model='@("clipboard")' /><span>@Idioma.Texto("Avance de evaluaciones")</span></a>
    <a class="dash-nav-link @(accion == "Estadisticas" ? "is-active" : "")" asp-controller="Director" asp-action="Estadisticas" aria-current="@(accion == "Estadisticas" ? "page" : null)"><partial name="_DashboardIcon" model='@("grid")' /><span>@Idioma.Texto("Estadísticas")</span></a>
</div></details>
<details class="dash-nav-group" open="@(ctrl=="CitasProgramadas"||accion=="Calendario")"><summary><partial name="_DashboardIcon" model='@("calendar")'/><span>@Idioma.Texto("Agenda y citas")</span></summary><div class="dash-nav-children">
    <a class="dash-nav-link @(accion == "Calendario" || (ctrl == "CitasProgramadas" && act is "Index" or "Editar" or "Guardar") ? "is-active" : "")" asp-controller="CitasProgramadas" asp-action="Index"><partial name="_DashboardIcon" model='@("calendar")' /><span>@Idioma.Texto("Programación de citas")<small>@Idioma.Texto("Calendario y seguimiento")</small></span></a>
    <a class="dash-nav-link @(ctrl=="CitasProgramadas" && act is "Notificaciones" or "Leida" ? "is-active":"")" asp-controller="CitasProgramadas" asp-action="Notificaciones"><partial name="_DashboardIcon" model='@("calendar")' /><span>@Idioma.Texto("Notificaciones")</span></a>
</div></details>
<details class="dash-nav-group" open="@(ctrl=="InformesEducativos"||accion is "Carreras" or "ResultadosInstitucionales")"><summary><partial name="_DashboardIcon" model='@("results")'/><span>@Idioma.Texto("Información institucional")</span></summary><div class="dash-nav-children">
    <a class="dash-nav-link @Active("InformesEducativos")" asp-controller="InformesEducativos" asp-action="Index"><partial name="_DashboardIcon" model='@("results")' /><span>@Idioma.Texto("Informes autorizados")</span></a>
    <a class="dash-nav-link @(accion == "Carreras" ? "is-active" : "")" asp-controller="Director" asp-action="Carreras" aria-current="@(accion == "Carreras" ? "page" : null)"><partial name="_DashboardIcon" model='@("book")' /><span>@Idioma.Texto("Carreras")</span></a>
    <a class="dash-nav-link @(accion == "ResultadosInstitucionales" ? "is-active" : "")" asp-controller="Director" asp-action="ResultadosInstitucionales" aria-current="@(accion == "ResultadosInstitucionales" ? "page" : null)"><partial name="_DashboardIcon" model='@("results")' /><span>@Idioma.Texto("Resultados institucionales")</span></a>
</div></details>
<partial name="_CuentaSubmenu"/>
</nav>
