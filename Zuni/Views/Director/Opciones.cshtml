@model Zuni.Models.OpcionesPreguntaViewModel
@{ ViewData["Title"] = "Opciones de respuesta"; }
<link rel="stylesheet" href="~/css/director.css" asp-append-version="true" />
<section class="director-dashboard py-4 py-lg-5" aria-labelledby="opciones-title">
    <div class="director-hero mb-4"><div><div class="director-access-pill">@Model.PruebaNombre · @Model.DimensionNombre</div><h1 id="opciones-title">Opciones de respuesta</h1><p class="director-question-preview">@Model.PreguntaTexto</p></div><div class="director-hero-mark" aria-hidden="true">☷</div></div>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4"><div><p class="director-eyebrow mb-1">Respuestas disponibles</p><h2 class="h3 mb-0">Opciones <span class="text-secondary">(@Model.Opciones.Count)</span></h2></div><div class="d-flex flex-wrap gap-2"><a asp-action="Preguntas" asp-route-dimensionId="@Model.DimensionId" class="btn btn-outline-secondary">Volver a preguntas</a><a asp-action="CrearOpcion" asp-route-preguntaId="@Model.PreguntaId" class="btn btn-zuni">Nueva opción</a></div></div>
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    <div class="director-option-guidance mb-3"><strong>@Model.OpcionesActivas opciones activas.</strong> Se necesitan al menos dos para activar la pregunta. Las respuestas se conservan sin puntajes ni interpretaciones automáticas.</div>
    <div class="director-feature-card p-0 overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0 director-users-table">
        <thead><tr><th>Opción</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var opcion in Model.Opciones)
        {
            <tr><td><span class="small text-secondary">Orden @opcion.Orden</span><strong class="d-block">@opcion.Texto</strong></td><td><span class="badge @(opcion.Activa ? "text-bg-success" : "text-bg-secondary")">@(opcion.Activa ? "Activa" : "Inactiva")</span></td><td><div class="director-prueba-actions justify-content-end">
                <a asp-action="EditarOpcion" asp-route-id="@opcion.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                <form asp-action="CambiarEstadoOpcion" asp-route-id="@opcion.Id" method="post"><button type="submit" class="btn btn-sm @(opcion.Activa ? "btn-outline-danger" : "btn-outline-success")">@(opcion.Activa ? "Desactivar" : "Activar")</button></form>
            </div></td></tr>
        }
        @if (Model.Opciones.Count == 0) { <tr><td colspan="3" class="text-center text-secondary py-5">Añade opciones de respuesta para completar esta pregunta.</td></tr> }
        </tbody>
    </table></div></div>
</section>
