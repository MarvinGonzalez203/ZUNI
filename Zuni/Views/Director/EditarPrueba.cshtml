@model Zuni.Models.PruebaFormViewModel

@{
    ViewData["Title"] = "Editar prueba";
}

<link rel="stylesheet" href="~/css/director.css" asp-append-version="true" />

<section class="director-dashboard py-4 py-lg-5" aria-labelledby="form-title">
    <div class="director-hero mb-4">
        <div>
            <div class="director-access-pill"><span aria-hidden="true">◆</span> Banco de cuestionarios exploratorios</div>
            <h1 id="form-title">Editar prueba</h1>
            <p>Actualiza la información de un cuestionario de gustos, preferencias o intereses.</p>
        </div>
        <div class="director-hero-mark" aria-hidden="true">✎</div>
    </div>
    <div class="director-form-card">
        <form asp-action="EditarPrueba" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <div class="alert alert-info" role="note">El cuestionario apoya la conversación profesional; no diagnostica, evalúa riesgos ni reemplaza el criterio de la psicóloga.</div>
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" maxlength="120" autocomplete="off" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="5" maxlength="1000"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger small"></span>
            </div>
            <div class="d-flex flex-wrap justify-content-end gap-2">
                <a asp-action="Pruebas" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-zuni">Guardar cambios</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
