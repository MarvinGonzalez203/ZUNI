@{
    ViewData["Title"] = "Resultados institucionales";
}
<header class="dash-profile-heading">
    <div><span class="dash-eyebrow">@Idioma.Texto("PANEL INSTITUCIONAL")</span><h1>@Idioma.Texto("Resultados institucionales")</h1><p>@Idioma.Texto("Consulta futura de información institucional agregada.")</p></div>
    <span class="dash-badge">@Idioma.Texto("Próximamente")</span>
</header>
<section class="dash-card" aria-label="@Idioma.Texto("Resultados institucionales: próximamente")">
    <div class="dash-chart-placeholder">
        <div class="dash-empty-symbol" aria-hidden="true"><span></span><span></span><partial name="_DashboardIcon" model='@("results")' /></div>
        <h2>@Idioma.Texto("Próximamente")</h2>
        <p>@Idioma.Texto("Los resultados institucionales estarán disponibles cuando se integre el módulo de evaluaciones.")</p>
    </div>
</section>
