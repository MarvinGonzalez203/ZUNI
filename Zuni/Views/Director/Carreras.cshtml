@{
    ViewData["Title"] = "Carreras";
}
<header class="dash-profile-heading">
    <div><span class="dash-eyebrow">@Idioma.Texto("PANEL INSTITUCIONAL")</span><h1>@Idioma.Texto("Carreras")</h1><p>@Idioma.Texto("Aquí podrás consultar la participación y cobertura de las carreras.")</p></div>
    <span class="dash-badge">@Idioma.Texto("Próximamente")</span>
</header>
<section class="dash-card" aria-label="@Idioma.Texto("Carreras: sin datos disponibles")">
    <div class="dash-chart-placeholder">
        <div class="dash-empty-symbol" aria-hidden="true"><span></span><span></span><partial name="_DashboardIcon" model='@("book")' /></div>
        <h2>@Idioma.Texto("Próximamente")</h2>
        <p>@Idioma.Texto("Sin datos disponibles.")</p>
    </div>
</section>
