@model Zuni.Models.OpcionPreguntaFormViewModel
@{ ViewData["Title"] = "Nueva opción"; }
<link rel="stylesheet" href="~/css/director.css" asp-append-version="true" />
<section class="director-dashboard py-4 py-lg-5" aria-labelledby="form-title">
    <div class="director-hero mb-4"><div><div class="director-access-pill">Opciones de respuesta</div><h1 id="form-title">Nueva opción</h1><p>Agrega una respuesta posible. Las opciones no reciben puntajes automáticos.</p></div><div class="director-hero-mark" aria-hidden="true">+</div></div>
    <div class="director-form-card"><form asp-action="CrearOpcion" method="post">
        <input asp-for="PreguntaId" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
        <div class="mb-3"><label asp-for="Texto" class="form-label"></label><input asp-for="Texto" class="form-control" maxlength="200" autocomplete="off" /><span asp-validation-for="Texto" class="text-danger small"></span></div>
        <div class="mb-4"><label asp-for="Orden" class="form-label"></label><input asp-for="Orden" class="form-control" min="1" max="999" /><span asp-validation-for="Orden" class="text-danger small"></span></div>
        <div class="d-flex justify-content-end gap-2"><a asp-action="Opciones" asp-route-preguntaId="@Model.PreguntaId" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-zuni" type="submit">Crear opción</button></div>
    </form></div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
