@{
    ViewData["Title"] = "Estadísticas";
}
<header class="dash-profile-heading">
    <div><span class="dash-eyebrow">@Idioma.Texto("PANEL INSTITUCIONAL")</span><h1>@Idioma.Texto("Estadísticas")</h1><p>@Idioma.Texto("Espacios preparados para futuros indicadores institucionales.")</p></div>
    <span class="dash-badge">@Idioma.Texto("Próximamente")</span>
</header>
<section class="dash-summary-grid" aria-label="@Idioma.Texto("Indicadores futuros")">
    @foreach (var indicador in new[] { "Cobertura por carrera", "Participación general", "Evolución por período" })
    {
        <article class="dash-card dash-summary">
            <div class="dash-summary-top"><span class="dash-icon-tile"><partial name="_DashboardIcon" model='@("grid")' /></span></div>
            <h2>@indicador</h2>
            <p>@Idioma.Texto("El indicador aparecerá cuando existan datos disponibles.")</p>
            <span class="dash-module-label">@Idioma.Texto("Sin datos disponibles")</span>
        </article>
    }
</section>
