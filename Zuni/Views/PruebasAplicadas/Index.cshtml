@model IReadOnlyList<Zuni.Models.Pruebas.PruebaAplicacionResumen>
@{ViewData["Title"]="Pruebas indicadas";}
<header class="dash-profile-heading"><div><span class="dash-eyebrow">@Idioma.Texto("ACOMPAÑAMIENTO")</span><h1>@Idioma.Texto("Pruebas indicadas por mi psicólogo")</h1><p>@Idioma.Texto("Después de tu primera cita, el profesional explica el cuestionario y habilita tu participación. No hay respuestas buenas ni malas.")</p></div></header>
@if(Model.Count==0){<section class="dash-card">@Idioma.Texto("Aún no tienes pruebas indicadas. Tu psicólogo te orientará en la consulta.")</section>}
@foreach(var a in Model){<article class="dash-card mb-3"><h2>@a.Nombre</h2><small>@a.Subtitulo</small><p>@a.Preguntas @Idioma.Texto("preguntas · Escala del 1 al 10")</p>
@if(a.RetiradaUtc is not null){<p>@Idioma.Texto("Participación retirada.")</p>}else if(a.InduccionUtc is null){<p>@Idioma.Texto("Pendiente de inducción y habilitación del psicólogo. Todavía no se puede responder.")</p>}else{<p>@(a.FinalizadaUtc is null?Idioma.Texto("Disponible después de la inducción"):"Cuestionario finalizado")</p><a asp-action="Contestar" asp-route-id="@a.Id" class="dash-button">@(a.FinalizadaUtc is null?Idioma.Texto("Responder / continuar"):Idioma.Texto("Ver mis respuestas"))</a><form asp-action="Retirar" method="post" class="mt-3"><input type="hidden" name="id" value="@a.Id"/><button class="btn btn-outline-secondary">@Idioma.Texto("Retirar mi participación")</button></form>}</article>}
