@model Zuni.Models.Pruebas.ResumenAplicado
@section Styles { <style>meter::-webkit-meter-bar{background:#ede8d0;border:0;border-radius:12px}meter::-webkit-meter-optimum-value{background:#cea2fd;border-radius:12px}meter::-moz-meter-bar{background:#cea2fd}</style> }
@{ViewData["Title"]="Resumen exploratorio";}
<div data-contenido-privado>
<header class="dash-profile-heading"><div><h1>@Idioma.Texto("Resumen exploratorio ·") @Model.Estudiante</h1><p>@Model.Prueba.Nombre</p><small>@Model.Prueba.Subtitulo</small></div></header>
<section class="dash-card mb-4"><h2>@Idioma.Texto("Lectura de las respuestas")</h2><p>@Idioma.Texto("Promedio aritmético de respuestas por tema, en escala de 1 a 10. Expresa identificación con estas afirmaciones: no equivale a un rasgo estandarizado, percentil, diagnóstico, precisión psicométrica o bandera automática. Cada dimensión reúne aspectos distintos que se deben explorar en conversación.")</p></section>
@foreach(var d in Model.Dimensiones){<section class="dash-card mb-3"><h2>@d.Nombre</h2><p><strong>@d.Media / 10</strong> · @d.Respondidas @Idioma.Texto("de") @d.Total @Idioma.Texto("respuestas")</p><meter min="1" max="10" value="@(d.Media??1)" aria-label="Promedio de @d.Nombre" style="width:100%;height:24px;accent-color:var(--zuni-violet,#cea2fd)"></meter></section>}
<section class="dash-card"><h2>@Idioma.Texto("Respuestas por afirmación")</h2><div class="table-responsive"><table class="table"><thead><tr><th>@Idioma.Texto("Afirmación")</th><th>@Idioma.Texto("Respuesta (1–10)")</th></tr></thead><tbody>@foreach(var r in Model.Respuestas){<tr><td>@r.Pregunta</td><td>@r.Valor</td></tr>}</tbody></table></div></section>
</div>
