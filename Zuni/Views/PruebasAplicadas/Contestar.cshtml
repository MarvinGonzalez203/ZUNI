@model Zuni.Models.Pruebas.CuestionarioAplicado
@{ViewData["Title"]="Responder prueba";var terminada=Model.Asignacion.FinalizadaUtc is not null;var qs=Model.Prueba.Preguntas.OrderBy(q=>q.Orden).ToList();}
<header class="dash-profile-heading"><div><h1>@Model.Prueba.Nombre</h1><small>@Model.Prueba.Subtitulo</small><p>@qs.Count @Idioma.Texto("preguntas · Escala del 1 al 10")</p></div></header>
<section class="dash-card mb-4"><h2>@Idioma.Texto("Antes de responder")</h2><p>@Model.Prueba.Instrucciones</p><p>@Idioma.Texto("Responde con calma, según tu experiencia habitual. El resultado describe tus respuestas y será revisado por tu psicólogo; no entrega un diagnóstico automático.")</p></section>
<form method="post"><input type="hidden" name="Id" value="@Model.Asignacion.Id"/><input type="hidden" name="Revision" value="@Model.Asignacion.Revision"/>
@for(int i=0;i<qs.Count;i++){var q=qs[i];var selected=Model.Respuestas.SingleOrDefault(r=>r.PreguntaPruebaId==q.Id)?.OpcionPruebaId;
<section class="dash-card mb-3"><span class="dash-eyebrow">@Idioma.Texto("Pregunta") @(i+1) @Idioma.Texto("de") @qs.Count</span><h2 class="h5 mt-2">@q.Texto</h2><input type="hidden" name="Respuestas[@i].PreguntaId" value="@q.Id"/><label for="respuesta-@i" class="form-label">@Idioma.Texto("Grado de identificación")</label><select id="respuesta-@i" name="Respuestas[@i].OpcionId" class="form-select" disabled="@terminada"><option value="">@Idioma.Texto("Sin responder")</option>@foreach(var o in q.Opciones.OrderBy(o=>o.Valor)){<option value="@o.Id" selected="@(o.Id==selected)">@o.Texto</option>}</select></section>}
@if(!terminada){<section class="dash-card"><label class="d-block mb-3"><input type="checkbox" name="Consentimiento" value="true" required/> @Idioma.Texto("Comprendí las instrucciones y participo voluntariamente. Mis respuestas estarán disponibles para mi psicólogo vinculado.")</label><div class="zuni-action-row"><button class="btn btn-outline-secondary" name="Finalizar" value="false">@Idioma.Texto("Guardar avance")</button> <button class="dash-button" name="Finalizar" value="true">@Idioma.Texto("Finalizar respuestas")</button></div></section>}else{<p>@Idioma.Texto("Finalizado. Se conservan tus respuestas.")</p>}
</form>
