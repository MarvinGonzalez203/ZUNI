@model string
@{
    var titulo = Model switch { "cita" => "Tu próxima cita, paso a paso", "seguimiento" => "Tu acompañamiento tiene un recorrido", "bienestar" => "Herramientas para conocerte y organizarte", _ => "Decide cómo se utiliza tu información" };
    ViewData["Title"] = titulo; ViewData["BodyClass"] = "home-page";
    var intro = Model switch { "cita" => "Desde tu cuenta hasta una reunión virtual: descubre qué preparar, dónde solicitar un horario y cómo reconocer una cita confirmada.", "seguimiento" => "ZUNI conecta tu solicitud, las citas y las recomendaciones compartidas. Aprende a interpretar cada estado y a encontrar el documento que necesitas.", "bienestar" => "El bienestar también requiere organización, espacios para conversar y herramientas de reflexión. Conoce las funciones que acompañan tu recorrido educativo.", _ => "Cuenta, expediente profesional e informes compartidos cumplen funciones diferentes. Conoce quién puede consultarlos, qué puedes autorizar y cómo ejercer tus derechos." };
    var cards = Model switch {
        "cita" => new[] {
            ("user","Prepara tu cuenta","Crea tu cuenta cuando la institución permita el registro público. Administración debe activarla. Si recibes una contraseña temporal, cámbiala al ingresar y completa tu perfil y contactos de emergencia.","Tus datos ayudan a organizar el acompañamiento. Si la institución permite únicamente altas administradas, solicita la cuenta al responsable institucional.","Inicio → Crear cuenta; después Mi cuenta → Editar"),
            ("shield","Revisión y consentimiento","Declara tu fecha de nacimiento y consulta el estado de revisión de mayoría de edad. La institución debe revisar tu documento. Después presenta la solicitud de atención y lee las condiciones antes de aceptarlas.","La revisión documental y el consentimiento son pasos distintos. La solicitud no significa todavía que una cita esté confirmada ni que una atención haya ocurrido.","Mayoría de edad → Mi solicitud de atención"),
            ("calendar","Elige una fecha disponible","Con un psicólogo asignado, abre el calendario y pulsa un día disponible. Revisa modalidad y franja. En horarios sin duración fija también eliges la duración. Solicita la cita y consulta su estado.","Solicitada requiere confirmación del profesional. ZUNI impide reservar en el pasado o sobre otro horario ocupado. El profesional también puede proponerte una cita; revisa la notificación.","Citas → día disponible → Solicitar cita"),
            ("phone","Prepárate para asistir","Comprueba fecha, hora de Guatemala y modalidad. Para una cita virtual, el psicólogo prepara un enlace individual y debes entrar desde la opción de acceso de tu propia cita.","El acceso se habilita 15 minutos antes. Busca privacidad y un lugar sin ruido. Si cambia el horario, revisa Notificaciones. Para cancelar una cita futura, utiliza su botón e indica el motivo.","Citas → Consultar acceso virtual o Cancelar cita") },
        "seguimiento" => new[] {
            ("clipboard","Consulta tu solicitud","El estado indica si tu solicitud sigue pendiente o si ya existe un profesional vinculado. Revisa la información que presentaste y contacta a tu institución cuando una asignación necesite revisión.","Asignación de psicólogo, asignación de prueba y cita programada son registros distintos. Ninguno significa por sí solo que ya existe una atención realizada o un resultado calculado.","Mi solicitud de atención"),
            ("calendar","Reconoce cada estado de cita","Solicitada requiere confirmación; Confirmada indica aceptación. Completada registra una atención cerrada con asistencia. No asistió es una inasistencia; Cancelada y Rechazada son estados diferentes.","Una programación o reprogramación aparece en tu cuenta y en Notificaciones. Revisa la fecha actual antes de asistir. El psicólogo consulta sus atenciones pasadas desde la ventana de cada día del calendario.","Citas y Notificaciones"),
            ("book","Conserva las recomendaciones","Después de una atención, el profesional registra un resultado breve y recomendaciones para compartir contigo. Puedes releerlos y descargar el reporte compartido en PDF para conservar o reimprimir ese contenido.","Las notas profesionales privadas no forman parte del PDF. Recomendar otra cita no crea una automáticamente: consulta el calendario o la programación que el profesional te comunique.","Resultados → Ver reporte compartido y reimprimir"),
            ("shield","Revisa los informes educativos","Un informe educativo permite coordinar apoyos con un Director destinatario. Revisa contenido, versión y persona destinataria antes de autorizar. El profesional emite esa versión después de tu decisión.","Cada nueva versión necesita una autorización propia. Revocar limita nuevas descargas desde ZUNI; no recupera copias que un destinatario ya haya descargado.","Informes educativos → versión y autorización") },
        "bienestar" => new[] {
            ("spark","Una herramienta de reflexión","Big Five es un cuestionario opcional con un resumen descriptivo de cinco dimensiones de personalidad. Lee las instrucciones y decide si deseas participar como apoyo a una conversación con tu profesional.","El resultado no es una calificación ni un diagnóstico. ZUNI no lo utiliza para decidir automáticamente sobre tu rendimiento ni para reemplazar la valoración del psicólogo.","Evaluaciones → Big Five"),
            ("user","Explica qué apoyo necesitas","La solicitud de atención permite describir tu motivo de consulta, idioma preferido y datos iniciales. Preparar lo que quieres conversar ayuda a explicar las dificultades de tu entorno educativo.","Anota situaciones concretas: qué tarea resulta difícil, desde cuándo y qué has intentado. Preséntalas en la solicitud o en la conversación autorizada, sin exponerlas en mensajes públicos.","Mi solicitud de atención → información inicial"),
            ("calendar","Organiza el acompañamiento","El calendario reúne horarios, modalidad y estado de tus citas. Tu psicólogo puede proponerte una atención y cambiar el horario cuando sea necesario. La nueva fecha queda vinculada a tu cuenta.","Revisa la notificación antes de asistir. Para una cita virtual, prepara conexión y privacidad y entra desde ZUNI. La aplicación organiza la atención; el acompañamiento lo realiza el profesional.","Citas → calendario; Notificaciones → programación"),
            ("clipboard","Lleva los acuerdos a tu jornada","En Resultados puedes volver a leer lo compartido por el profesional. Usa el resumen para recordar acuerdos y preparar preguntas de seguimiento, sin depender únicamente de lo que recuerdas de la conversación.","Organiza una recomendación en pequeños pasos: qué harás, cuándo y qué debes consultar. El PDF conserva las recomendaciones compartidas y la fecha de la atención, sin las notas privadas.","Resultados → recomendaciones y reporte PDF"),
            ("book","Pruebas de la institución","El Director prepara pruebas y puede asignarlas a estudiantes. Una asignación indica a quién se destina el instrumento; no significa que esté contestado ni que se haya calculado un resultado.","Big Five tiene un flujo propio disponible. El catálogo institucional no implica que todos sus instrumentos tengan un cuestionario de respuesta publicado. Sigue las instrucciones de tu institución para cada prueba.","Evaluaciones y las indicaciones institucionales"),
            ("shield","Apoyo educativo con límites claros","Para coordinar acciones con autoridades, el psicólogo puede elaborar un informe educativo separado del expediente. Su finalidad es comunicar necesidades de apoyo y recomendaciones pertinentes al destinatario autorizado.","Revisa versión y destinatario antes de autorizar. Las notas privadas no se incorporan automáticamente. ZUNI facilita el trámite y conserva tu decisión para esa versión concreta.","Informes educativos → revisar antes de autorizar") },
        _ => new[] {
            ("user","Cuenta y atención son espacios distintos","La cuenta guarda correo, carné y datos de contacto necesarios para organizar los servicios. El expediente y los registros profesionales pertenecen al flujo de atención y tienen permisos específicos.","Administrar una cuenta no concede acceso a notas clínicas. ZUNI comprueba el rol vigente y la asignación al profesional. Cuando recibes una contraseña temporal debes cambiarla antes de acceder al panel.","Mi cuenta → datos personales; Mi solicitud de atención → datos iniciales"),
            ("shield","Qué se comparte y qué queda privado","El psicólogo registra notas privadas en un espacio separado del resumen y las recomendaciones para el estudiante. El reporte compartido se construye únicamente con estos últimos campos.","El estudiante consulta su propio reporte. Director y Administración no acceden por sus roles. Las consultas y descargas autorizadas quedan registradas; tener el enlace no concede acceso a otra cuenta.","Resultados → reporte compartido"),
            ("clipboard","Autoriza una versión y un destinatario","Antes de emitir un informe educativo puedes revisar el contenido y el Director destinatario. Tu autorización se vincula a esa versión y persona, no a todos los informes futuros.","Puedes rechazar o revocar. Una versión corregida requiere una decisión nueva. Revocar restringe las siguientes descargas dentro de ZUNI, pero no elimina documentos ya recibidos fuera del sistema.","Informes educativos → versión, destinatario y autorización"),
            ("book","Lee la política institucional","La institución publica su política, identifica al responsable y establece los procedimientos. ZUNI conserva la versión que aceptaste y permite consultar la política vigente antes de continuar.","Revisa qué información se utiliza, para qué y cómo solicitar atención sobre tus datos. La aplicación registra decisiones y respuestas; la responsabilidad del tratamiento corresponde a la institución.","Pie de página → Política institucional"),
            ("user","Presenta una solicitud sobre tus datos","El centro de derechos permite solicitar acceso, corrección, supresión o retiro del consentimiento y consultar la respuesta institucional. Explica claramente la información o situación que deseas revisar.","La solicitud queda pendiente hasta que el responsable la tramite. No se borran expedientes automáticamente: la institución revisa el alcance y los criterios de conservación aplicables.","Privacidad y mis derechos → nueva solicitud → respuesta"),
            ("calendar","Protege el acceso cotidiano","Usa tu propia cuenta y consulta las citas virtuales desde ZUNI. Los enlaces son individuales y se entregan a participantes autorizados dentro del horario habilitado. Las notificaciones de citas no contienen notas clínicas.","No compartas contraseñas ni enlaces y cierra sesión en equipos compartidos. El anfitrión configura los controles en Google Meet: los permisos de ZUNI no modifican por sí solos la reunión externa.","Citas → acceso virtual; menú de cuenta → Cerrar sesión") }
    };
}
<div class="guide-page"><header class="guide-hero"><div><span class="guide-eyebrow">GUÍAS ZUNI · @Model.ToUpperInvariant()</span><h1>@titulo</h1><p>@intro</p><a href="#guia-contenido" class="btn btn-zuni">Explorar esta guía ↓</a></div><div aria-label="Funciones destacadas">@foreach(var c in cards.Take(3)) { <div class="guide-mini"><span class="guide-icon"><partial name="_DashboardIcon" model="c.Item1" /></span><div><strong>@c.Item2</strong><small>@c.Item5.Split('→')[0]</small></div></div> }</div></header>
<nav class="guide-tabs" aria-label="Guías de ZUNI">@foreach(var link in new[]{("cita","Citas"),("seguimiento","Seguimiento"),("bienestar","Bienestar"),("privacidad","Privacidad")}) { <a asp-action="Guia" asp-route-tema="@link.Item1" aria-current="@(Model==link.Item1 ? "page" : null)">@link.Item2</a> }</nav>
<section id="guia-contenido" class="guide-grid" aria-label="Explicaciones y funciones">@for(var i=0;i<cards.Length;i++) { var c=cards[i]; <article class="guide-card"><header><span class="guide-icon"><partial name="_DashboardIcon" model="c.Item1" /></span><div><span class="guide-eyebrow">@((i+1).ToString("00")) · EN ZUNI</span><h2>@c.Item2</h2></div></header><p>@c.Item3</p><p>@c.Item4</p><div class="guide-place"><strong>DÓNDE PULSAR</strong>@c.Item5</div></article> }</section>
<aside class="guide-callout"><div><strong>Conoce el recorrido antes de ingresar.</strong><p>Estas guías son públicas. Para consultar tus datos o realizar una acción, entra con tu propia cuenta.</p></div><a asp-controller="Cuenta" asp-action="IniciarSesion" class="btn btn-zuni">Ingresar a mi cuenta</a></aside></div>
