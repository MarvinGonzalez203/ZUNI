@{ Layout = "_DenisCorpLayout"; ViewData["Title"] = "Inicio"; }
<section class="corp-hero" aria-labelledby="corp-title">
    <p class="eyebrow">IDEAS QUE TOMAN FORMA</p>
    <h1 id="corp-title">Un mundo de ideas.<br /><span>Una misma casa.</span></h1>
    <p class="intro">Somos Denis Corp, la empresa matriz de ZUNI, Denis Academy y Fulleo. Creamos programas con identidad propia, reunidos aquí para que encuentres el que necesitas.</p>
    <a class="corp-button" href="#programas">Explorar nuestros programas <span aria-hidden="true">↓</span></a>
    <div class="corp-orbit" aria-hidden="true"><span>D<span class="orbit-dot">.</span></span></div>
</section>
<section class="programs" id="programas" aria-labelledby="programs-title">
    <p class="eyebrow">NUESTRO ECOSISTEMA</p><h2 id="programs-title">Cada programa, su propio propósito.</h2>
    <div class="product-grid">
        <article class="product-card zuni-card"><div class="product-mark" aria-hidden="true"><img src="/images/zuni-logo-transparent.png" width="48" height="48" alt="" /></div><p class="product-status">Bienestar y acompañamiento</p><h3>ZUNI</h3><p>Un espacio de acompañamiento estudiantil que conecta a estudiantes, psicólogos e instituciones.</p><a class="corp-button" href="/deniscorp/zuni/">Conocer ZUNI <span aria-hidden="true">↗</span></a><a class="product-login" asp-controller="Cuenta" asp-action="IniciarSesion">Ya tengo cuenta en ZUNI</a></article>
        <article class="product-card academy-card"><div class="product-mark" aria-hidden="true">A</div><p class="product-status">Aprendizaje de idiomas</p><h3>Denis Academy</h3><p>Aprende inglés y español con lecciones y actividades interactivas, a tu ritmo.</p><a class="corp-button" href="/deniscorp/academy/">Conocer Academy <span aria-hidden="true">↗</span></a><span class="availability">Acceso público en preparación</span></article>
        <article class="product-card fulleo-card"><div class="product-mark" aria-hidden="true">F</div><p class="product-status">Precios de combustibles</p><h3>Fulleo</h3><p>Consulta precios de gasolina y conoce su propuesta para informarte antes de llenar el tanque.</p><a class="corp-button" href="/deniscorp/fulleo/">Conocer Fulleo <span aria-hidden="true">↗</span></a><span class="availability">Acceso público en preparación</span></article>
    </div>
</section>
