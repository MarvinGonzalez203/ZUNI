@model string
@{ViewData["BodyClass"]="home-page";ViewData["Title"]=Zuni.Resources.GuiasUso.TemasPublicos.Single(t=>t.Tema==Model).Titulo;}
@section Scripts{<script src="~/js/guias.js" asp-append-version="true"></script>}
<div class="guide-page"><header class="guide-hero"><div><span class="guide-eyebrow">@Idioma.Texto("GUÍAS ZUNI ·")</span><h1>@Idioma.Texto(ViewData["Title"]?.ToString())</h1><p>@Idioma.Texto("Aprende qué hace cada control y dónde encontrarlo. ZUNI acompaña el trabajo profesional de psicología educativa.")</p><a href="#guia-contenido" class="btn btn-zuni">@Idioma.Texto("Explorar esta guía ↓")</a></div></header><partial name="_TemasGuia" model="Model"/><section id="guia-contenido" class="guide-grid">@foreach(var guia in Zuni.Resources.GuiasUso.Todas.Where(g=>g.Tema==Model)){<article class="guide-card commercial-help"><header><span class="guide-icon"><partial name="_DashboardIcon" model="guia.Icono"/></span><h2>@Idioma.Texto(guia.Titulo)</h2></header><p>@Idioma.Texto(guia.Resumen)</p><ol>@foreach(var paso in guia.Pasos){<li>@Idioma.Texto(paso)</li>}</ol><div class="guide-place"><strong>@Idioma.Texto("DÓNDE PULSAR")</strong>@Idioma.Texto(guia.Donde)</div></article>}</section></div>
