@using Zuni.Resources
@using static Zuni.Resources.PortalDenisCorp
@{ Layout="_DenisCorpLayout";ViewData["Title"]=T("Contáctanos","Contact us");var programa=ViewData["ProgramaContacto"] as string??"general";var tema=ViewData["TemaContacto"] as string??"consulta"; }
<section class="editorial-heading"><p class="eyebrow">@T("CONTÁCTANOS","CONTACT US")</p><h1>@T("¿Cómo te ayudamos hoy?","How can we help you today?")</h1><p>@T("Muchas respuestas están a un clic. Si prefieres hablar con una persona, prepara tu consulta y elige WhatsApp o correo.","Many answers are one click away. If you prefer talking to someone, prepare your question and choose WhatsApp or email.")</p></section>
<section class="contact-quick"><h2>@T("Resuélvelo al instante","Find a quick answer")</h2><div class="quick-grid"><a href="/deniscorp/blog/"><strong>@T("Blog y guías de uso","Blog and guides")</strong><span>@T("Pasos prácticos y ayuda por programa.","Practical steps and help by program.")</span></a><a href="/#programas"><strong>@T("Nuestros programas","Our programs")</strong><span>@T("Conoce las soluciones y sus avances.","Explore our solutions and their progress.")</span></a><a href="/Cuenta/IniciarSesion"><strong>@T("Entrar a ZUNI","Sign in to ZUNI")</strong><span>@T("Accede a tu cuenta de acompañamiento estudiantil.","Access your student support account.")</span></a></div></section>
<section class="contact-layout" id="escribenos"><div class="contact-card"><h2>@T("Escríbenos","Write to us")</h2>
    <form data-corp-contact data-phone="@ContactoDenisCorp.WhatsApp" data-email="@ContactoDenisCorp.Correo" action="#escribenos" method="get">
        <div class="contact-fields"><label for="contact-program">@T("Programa de interés","Program of interest")<select id="contact-program"><option value="general" selected="@(programa=="general")">@T("Consulta general","General question")</option>@foreach(var p in Productos){<option value="@p.Id" selected="@(p.Id==programa)">@p.Nombre</option>}</select></label>
        <label for="contact-topic">@T("¿Sobre qué quieres hablar?","What would you like to discuss?")<select id="contact-topic"><option value="consulta" selected="@(tema=="consulta")">@T("Conocer el programa","Explore the program")</option><option value="contratacion" selected="@(tema=="contratacion")">@T("Contratación y disponibilidad","Subscriptions and availability")</option><option value="ayuda">@T("Ayuda con mi cuenta","Help with my account")</option><option value="colaboracion">@T("Proyecto o colaboración","Project or collaboration")</option><option value="otro">@T("Otro tema","Another topic")</option></select></label>
        <label for="contact-name">@T("Tu nombre","Your name")<input id="contact-name" type="text" required maxlength="120" autocomplete="name"/></label><label for="contact-organization">@T("Negocio o institución (opcional)","Business or institution (optional)")<input id="contact-organization" type="text" maxlength="180" autocomplete="organization"/></label></div>
        <label for="contact-message">@T("Mensaje","Message")<textarea id="contact-message" rows="6" required maxlength="1500" placeholder="@T("Cuéntanos qué necesitas. Si ya usas un programa, indica en qué sección ocurre.","Tell us what you need. If you already use a program, mention which section is involved.")"></textarea></label>
        <p class="contact-note">@T("Se abrirá WhatsApp o tu aplicación de correo para revisar y enviar el mensaje.","WhatsApp or your email app will open so you can review and send the message.")</p>
        <div class="contact-actions"><a class="corp-button" data-contact-channel="whatsapp" href="https://wa.me/@ContactoDenisCorp.WhatsApp" target="_blank" rel="noopener noreferrer">@T("Enviar por WhatsApp","Send via WhatsApp") ↗</a><a class="corp-button button-outline" data-contact-channel="email" href="mailto:@ContactoDenisCorp.Correo">@T("Enviar por correo","Send by email") ↗</a></div><span class="contact-status" role="status" aria-live="polite"></span>
        <noscript><p>@T("Usa los canales directos para escribir tu consulta.","Use the direct channels to write your question.")</p></noscript>
    </form></div>
    <aside class="contact-card direct-channels"><h2>@T("Canales directos","Direct channels")</h2><a href="https://wa.me/@ContactoDenisCorp.WhatsApp" target="_blank" rel="noopener noreferrer"><strong>WhatsApp</strong><span>@ContactoDenisCorp.Telefono</span></a><a href="mailto:@ContactoDenisCorp.Correo"><strong>@T("Correo","Email")</strong><span>@ContactoDenisCorp.Correo</span></a><p>@T("Respondemos lo antes posible en horario laboral de Guatemala.","We respond as soon as possible during business hours in Guatemala.")</p><p>@T("Guatemala · atención en línea","Guatemala · online support")</p></aside>
</section>
<section class="contact-faq"><h2>@T("Preguntas frecuentes","Frequently asked questions")</h2><div>
    <details><summary>@T("¿Cómo elijo un programa?","How do I choose a program?")</summary><p>@T("Explora las fichas y sus avances. Si necesitas orientación, indica en tu consulta qué actividad quieres organizar.","Explore the product pages and their progress. If you need guidance, tell us which activity you want to organize.")</p></details>
    <details><summary>@T("¿Todos los programas usan la misma cuenta?","Do all programs use the same account?")</summary><p>@T("Cada programa mantiene su propio acceso. La cuenta de ZUNI corresponde al servicio de acompañamiento estudiantil.","Each program has its own access. A ZUNI account belongs to the student support service.")</p></details>
    <details><summary>@T("¿Puedo consultar por un servicio para mi colegio?","Can I ask about a service for my school?")</summary><p>@T("Sí. Selecciona Denis Corp Colegios y consulta la disponibilidad, condiciones y puesta en marcha para tu institución.","Yes. Select Denis Corp Colegios and ask about availability, terms and onboarding for your institution.")</p></details>
    <details><summary>@T("¿Las funciones en preparación ya están disponibles?","Are features in preparation already available?")</summary><p>@T("Las fichas distinguen avances y pendientes. Confirma la disponibilidad antes de contratar un servicio o planificar su uso.","The product pages distinguish progress from pending work. Confirm availability before subscribing to a service or planning its use.")</p></details>
</div></section>
<script src="~/js/contacto-denis-corp.js" asp-append-version="true" defer></script>
