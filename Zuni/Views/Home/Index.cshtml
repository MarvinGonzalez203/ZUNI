@model HomeViewModel
@{
    ViewData["Title"] = "Inicio";
    ViewData["BodyClass"] = "home-page";
}
@if (TempData["Success"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">@message<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
}

<section class="landing-hero" aria-labelledby="hero-title">
    <div class="liquid liquid-b" aria-hidden="true"></div>

    <div class="hero-content">
        <div class="hero-kicker"><span></span> BIENESTAR Y ACOMPAÑAMIENTO ESTUDIANTIL</div>
        <h1 id="hero-title">Bienvenido a <em>ZUNI</em></h1>
        <p class="hero-lead">Un espacio de apoyo, conexión y bienestar para tu desarrollo estudiantil.</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="session-pill"><span>✓</span><div><small>Sesión activa</small><strong>Qué gusto verte, @Model.PrimerNombre</strong></div></div>

            @if (Model.MostrarAvisoCompletarPerfil)
            {
                <aside class="profile-welcome-card" aria-labelledby="profile-welcome-title">
                    <span class="profile-welcome-icon" aria-hidden="true">✦</span>
                    <div class="profile-welcome-copy">
                        <strong id="profile-welcome-title">¡Te damos la bienvenida a ZUNI, @Model.PrimerNombre!</strong>
                        <p>Tu cuenta ya está lista. Completa algunos datos académicos y de contacto para aprovechar todas las funciones de ZUNI.</p>
                    </div>
                    <a asp-controller="Perfil" asp-action="Completar" class="btn btn-zuni">
                        Completar mi perfil <span aria-hidden="true">→</span>
                    </a>
                </aside>
            }
        }
        else
        {
            <div class="hero-cta"><a asp-controller="Cuenta" asp-action="Registro" class="btn btn-zuni btn-lg">Crear mi cuenta <span>→</span></a><a asp-controller="Cuenta" asp-action="IniciarSesion" class="btn btn-crystal btn-lg">Iniciar sesión</a></div>
        }
    </div>

    <svg class="crystal-trail" viewBox="0 0 720 430" aria-hidden="true">
        <path d="M26 366C156 350 177 249 286 239c103-10 139 74 232 10 62-43 86-116 176-178" />
        <circle cx="27" cy="366" r="5"/><circle cx="286" cy="239" r="5"/><circle cx="518" cy="249" r="5"/><circle cx="694" cy="71" r="7"/>
    </svg>
    <div class="hero-symbol" aria-hidden="true"><img src="~/images/zuni-logo-transparent.png" alt="" /></div>

    <div class="quick-panel" aria-label="Accesos principales de ZUNI">
        <div class="quick-intro"><span class="quick-spark">✦</span><div><small>Tu espacio ZUNI</small><strong>¿Qué necesitas hoy?</strong></div></div>
        <div class="quick-actions">
            <a asp-controller="Cuenta" asp-action="IniciarSesion"><span class="quick-icon">⌁</span><span><strong>Solicitar cita</strong><small>Encuentra acompañamiento</small></span></a>
            <a asp-controller="Cuenta" asp-action="IniciarSesion"><span class="quick-icon">↗</span><span><strong>Ver seguimiento</strong><small>Conoce tu avance</small></span></a>
            <a asp-controller="Cuenta" asp-action="IniciarSesion"><span class="quick-icon">◌</span><span><strong>Bienestar</strong><small>Recursos para ti</small></span></a>
            <a asp-controller="Cuenta" asp-action="IniciarSesion"><span class="quick-icon">⬡</span><span><strong>Privacidad</strong><small>Entorno protegido</small></span></a>
        </div>
    </div>

    <div class="hero-foot"><span><i></i> Privado y confidencial</span><span>Diseñado para la comunidad universitaria</span><span>Bienestar · Conexión · Confianza</span></div>
</section>
