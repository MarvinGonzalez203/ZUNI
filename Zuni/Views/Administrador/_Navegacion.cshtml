@{
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var enAdministrador = controlador == "Administrador";
    var enSolicitudes = controlador == "AdministradorSolicitudes";
    var roles = new[]
    {
        ("Administradores", "Administradores", "shield"),
        ("Directores", "Directores", "results"),
        ("Psicologos", "Psicólogos", "spark"),
        ("Estudiantes", "Estudiantes", "user")
    };
    string Activo(bool activo) => activo ? "is-active" : "";
    string? Actual(bool activo) => activo ? "page" : null;
}
<nav class="dash-nav" aria-label="Navegación del administrador">
    <span class="dash-nav-label">PANEL ADMINISTRATIVO</span>
    <a class="dash-nav-link @Activo(enAdministrador && accion == "Index")" asp-controller="Administrador" asp-action="Index" aria-current="@Actual(enAdministrador && accion == "Index")"><partial name="_DashboardIcon" model='@("grid")' /><span>Tablero</span></a>
    <a class="dash-nav-link @Activo(enAdministrador && accion == "AgregarUsuario")" asp-controller="Administrador" asp-action="AgregarUsuario" aria-current="@Actual(enAdministrador && accion == "AgregarUsuario")"><partial name="_DashboardIcon" model='@("user")' /><span>Agregar usuario</span></a>
    <span class="dash-nav-label dash-nav-label-spaced">USUARIOS POR ROL</span>
    @foreach (var (accionRol, texto, icono) in roles)
    {
        <a class="dash-nav-link @Activo(enAdministrador && accion == accionRol)" asp-controller="Administrador" asp-action="@accionRol" aria-current="@Actual(enAdministrador && accion == accionRol)"><partial name="_DashboardIcon" model="icono" /><span>@texto</span></a>
    }
    <span class="dash-nav-label dash-nav-label-spaced">GESTIÓN</span>
    <a class="dash-nav-link @Activo(controlador == "CarrerasAdmin")" asp-controller="CarrerasAdmin" asp-action="Index"><partial name="_DashboardIcon" model='@("book")' /><span>Catálogo de carreras</span></a>
    <a class="dash-nav-link" asp-controller="Administrador" asp-action="Catedraticos"><partial name="_DashboardIcon" model='@("book")' /><span>Revisar roles retirados</span></a>
    <a class="dash-nav-link @Activo(controlador == "Privacidad" && accion == "Configurar")" asp-controller="Privacidad" asp-action="Configurar"><partial name="_DashboardIcon" model='@("shield")' /><span>Política de privacidad</span></a>
    <a class="dash-nav-link @Activo(controlador == "Privacidad" && accion == "Solicitudes")" asp-controller="Privacidad" asp-action="Solicitudes"><partial name="_DashboardIcon" model='@("clipboard")' /><span>Solicitudes sobre datos</span></a>
    <a class="dash-nav-link @Activo(controlador == "MayoriaEdad")" asp-controller="MayoriaEdad" asp-action="Revisiones"><partial name="_DashboardIcon" model='@("shield")' /><span>Verificar mayoría de edad</span></a>
    <a class="dash-nav-link @Activo(controlador == "Institucion")" asp-controller="Institucion" asp-action="Index" aria-current="@Actual(controlador == "Institucion")"><partial name="_DashboardIcon" model='@("book")' /><span>Configuración de la institución</span></a>
    <a class="dash-nav-link @Activo(enSolicitudes)" asp-controller="AdministradorSolicitudes" asp-action="Index" aria-current="@Actual(enSolicitudes)"><partial name="_DashboardIcon" model='@("clipboard")' /><span>Solicitudes de atención</span></a>
    <span class="dash-nav-label dash-nav-label-spaced">CUENTA</span>
    <a class="dash-nav-link @Activo(controlador == "MiCuenta")" asp-controller="MiCuenta" asp-action="Index"><partial name="_DashboardIcon" model='@("user")' /><span>Mi cuenta</span></a>
</nav>
