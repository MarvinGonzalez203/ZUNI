@{
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var enUsuarios = controlador == "Administrador";
    var enSolicitudes = controlador == "AdministradorSolicitudes";
}
<nav class="dash-nav" aria-label="Navegación del administrador">
    <span class="dash-nav-label">PANEL ADMINISTRATIVO</span>
    <a class="dash-nav-link @(enUsuarios && accion == "Index" ? "is-active" : "")" asp-controller="Administrador" asp-action="Index" aria-current="@(enUsuarios && accion == "Index" ? "page" : null)"><partial name="_DashboardIcon" model='@("grid")' /><span>Tablero / Usuarios</span></a>
    <a class="dash-nav-link @(enUsuarios && accion == "AgregarUsuario" ? "is-active" : "")" asp-controller="Administrador" asp-action="AgregarUsuario" aria-current="@(enUsuarios && accion == "AgregarUsuario" ? "page" : null)"><partial name="_DashboardIcon" model='@("user")' /><span>Agregar usuario</span></a>
    <a class="dash-nav-link @(enSolicitudes ? "is-active" : "")" asp-controller="AdministradorSolicitudes" asp-action="Index" aria-current="@(enSolicitudes ? "page" : null)"><partial name="_DashboardIcon" model='@("clipboard")' /><span>Solicitudes de atención</span></a>
    <span class="dash-nav-label dash-nav-label-spaced">CUENTA</span>
    <a class="dash-nav-link" asp-controller="MiCuenta" asp-action="Index"><partial name="_DashboardIcon" model='@("user")' /><span>Mi cuenta</span></a>
</nav>
