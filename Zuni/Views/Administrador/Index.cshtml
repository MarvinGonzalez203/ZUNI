@model Zuni.Models.Administrador.PanelAdministradorViewModel
@{
    ViewData["Title"] = "Panel Administrador · Tablero";
    var primero = (User.Identity?.Name ?? "Administrador").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Administrador";
    var nombre = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(primero.ToLower());
    var tarjetas = new[]
    {
        ("Administradores", "Administrador", "Administradores", "shield"),
        ("Directores", "Director", "Directores", "results"),
        ("Psicólogos", "Psicologo", "Psicologos", "spark"),
        ("Estudiantes", "Estudiante", "Estudiantes", "user")
    };
}

<header class="dash-welcome">
    <div class="dash-welcome-copy"><span class="dash-eyebrow">@Idioma.Texto("ESPACIO ADMINISTRATIVO")</span>
        <h1>@Idioma.Texto("Hola,") @nombre<span class="dash-greeting-dot">.</span></h1>
        <p>@Idioma.Texto("Administra las cuentas, roles y accesos de ZUNI desde un solo lugar.")</p>
        <a class="dash-button" asp-action="AgregarUsuario">@Idioma.Texto("Agregar usuario") <partial name="_DashboardIcon" model='@("arrow")' /></a>
    </div>
    <div class="dash-welcome-art" aria-hidden="true"><div class="dash-glass-orbit"></div><div class="dash-glass-orbit orbit-small"></div><img src="~/images/zuni-logo-transparent.png" alt="" /><span>@Idioma.Texto("Conexión y confianza.")</span></div>
</header>

@foreach (var tipo in new[] { "Info", "Error" })
{
    if (TempData[tipo] is string mensaje)
    {
        <div class="alert @(tipo == "Error" ? "alert-danger" : "alert-light") border" role="status">@Idioma.Texto(mensaje)</div>
    }
}

<div class="dash-section-heading">
    <h2>@Idioma.Texto("Usuarios por rol")</h2>
    <span>@Idioma.Texto("Una cuenta con varios roles se cuenta en cada rol.")</span>
</div>
<section class="dash-summary-grid" aria-label="@Idioma.Texto("Usuarios por rol")">
    @foreach (var (titulo, rol, accion, icono) in tarjetas)
    {
        <a class="dash-card dash-summary dash-summary-link" asp-action="@accion" data-rol="@rol">
            <div class="dash-summary-top"><span class="dash-icon-tile"><partial name="_DashboardIcon" model="icono" /></span><span class="dash-eyebrow">@Idioma.Texto("ROL")</span></div>
            <h3>@Idioma.Texto(titulo)</h3>
            <p class="fs-3 fw-bold mb-2">@Model.UsuariosPorRol.GetValueOrDefault(rol)</p>
            <span class="dash-text-link">@Idioma.Texto("Ver usuarios") <partial name="_DashboardIcon" model='@("arrow")' /></span>
        </a>
    }
    @if (Model.SinRol > 0)
    {
        <a class="dash-card dash-summary dash-summary-link" asp-action="SinRol" data-rol="SinRol">
            <div class="dash-summary-top"><span class="dash-icon-tile"><partial name="_DashboardIcon" model='@("user")' /></span><span class="dash-eyebrow">@Idioma.Texto("REVISAR")</span></div>
            <h3>@Idioma.Texto("Sin rol")</h3>
            <p class="fs-3 fw-bold mb-2">@Model.SinRol</p>
            <span class="dash-text-link">@Idioma.Texto("Ver usuarios") <partial name="_DashboardIcon" model='@("arrow")' /></span>
        </a>
    }
</section>
@if (Model.UsuariosPorRol.GetValueOrDefault("Catedratico") > 0)
{
    <section class="dash-card p-4 my-3"><h2 class="h5">@Idioma.Texto("Cuentas con rol retirado")</h2><p>@Idioma.Texto("Hay") @Model.UsuariosPorRol.GetValueOrDefault("Catedratico") cuentas que conservan Catedrático como registro histórico. El módulo está cerrado. Revisa cada cuenta antes de cambiar sus permisos; no hay conversión automática.</p><a asp-action="Catedraticos">@Idioma.Texto("Revisar cuentas con rol retirado")</a></section>
}

<div class="dash-section-heading">
    <h2>@Idioma.Texto("Resumen de cuentas")</h2>
    <span>@Idioma.Texto("Información administrativa; no incluye datos clínicos.")</span>
</div>
<section class="dash-summary-grid" aria-label="@Idioma.Texto("Resumen de cuentas")">
    <article class="dash-card dash-summary"><h3>@Idioma.Texto("Total de usuarios")</h3><p class="fs-3 fw-bold mb-0">@Model.Total</p><p class="small mb-0">@Model.Activos @Idioma.Texto("activos ·") @Model.Inactivos @Idioma.Texto("inactivos")</p></article>
    <a class="dash-card dash-summary dash-summary-link" asp-action="Estudiantes" asp-route-estado="Pendientes">
        <h3>@Idioma.Texto("Pendientes de activación")</h3><p class="fs-3 fw-bold mb-2">@Model.PendientesActivacion</p>
        <span class="dash-text-link">@Idioma.Texto("Revisar autorregistros") <partial name="_DashboardIcon" model='@("arrow")' /></span>
    </a>
    <a class="dash-card dash-summary dash-summary-link" asp-controller="AdministradorSolicitudes" asp-action="Index" asp-route-estado="Pendiente">
        <h3>@Idioma.Texto("Solicitudes pendientes")</h3><p class="fs-3 fw-bold mb-2">@Model.SolicitudesPendientes</p>
        <span class="dash-text-link">@Idioma.Texto("Ver solicitudes") <partial name="_DashboardIcon" model='@("arrow")' /></span>
    </a>
</section>
