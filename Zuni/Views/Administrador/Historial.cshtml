@model Zuni.Models.Administrador.HistorialUsuarioViewModel
@{
    ViewData["Title"] = "Historial del usuario";
}

<section class="container py-4 py-md-5" aria-labelledby="historial-title">
    <div class="zuni-admin-surface rounded-4 border shadow-sm p-3 p-md-4 p-lg-5">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
            <div>
                <p class="small fw-semibold mb-2">@Idioma.Texto("Panel Administrador")</p>
                <h1 id="historial-title" class="display-6 fw-bold mb-3">@Idioma.Texto("Historial del usuario")</h1>
                <dl class="mb-0">
                    <dt>@Idioma.Texto("Nombre")</dt>
                    <dd class="text-break">@Model.NombreUsuario</dd>
                    <dt>@Idioma.Texto("Correo")</dt>
                    <dd class="text-break">@(Model.Email ?? Idioma.Texto("Sin correo"))</dd>
                </dl>
            </div>
            <a asp-controller="Administrador" asp-action="Gestionar" asp-route-id="@Model.UsuarioId" class="btn btn-outline-dark">@Idioma.Texto("Volver al usuario")</a>
        </div>

        @if (Model.Eventos.Count == 0)
        {
            <div class="rounded-3 border p-4" style="background: rgba(206,162,253,.12);">
                @Idioma.Texto("No hay cambios registrados para este usuario.")
            </div>
        }
        else
        {
            <p class="small">@Idioma.Texto("Eventos del más reciente al más antiguo. Fechas expresadas en UTC.")</p>
            <div class="table-responsive rounded-3 border" tabindex="0" role="region" aria-label="@Idioma.Texto("Eventos de auditoría del usuario")">
                <table class="table align-middle mb-0" style="--bs-table-bg: transparent;">
                    <caption class="visually-hidden">@Idioma.Texto("Historial de cambios del usuario, ordenado por fecha descendente.")</caption>
                    <thead style="background: rgba(206,162,253,.18);">
                        <tr>
                            <th scope="col" class="p-3">@Idioma.Texto("Fecha (UTC)")</th>
                            <th scope="col" class="p-3">@Idioma.Texto("Acción")</th>
                            <th scope="col" class="p-3">@Idioma.Texto("Estado anterior")</th>
                            <th scope="col" class="p-3">@Idioma.Texto("Estado nuevo")</th>
                            <th scope="col" class="p-3">@Idioma.Texto("Motivo")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var evento in Model.Eventos)
                        {
                            <tr>
                                <td class="p-3 text-nowrap">@evento.FechaUtc.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <th scope="row" class="p-3 fw-semibold">@evento.AccionVisible</th>
                                <td class="p-3 text-break">@evento.EstadoAnterior</td>
                                <td class="p-3 text-break">@evento.EstadoNuevo</td>
                                <td class="p-3 text-break" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(evento.Motivo) ? Idioma.Texto("Sin motivo registrado") : evento.Motivo)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
