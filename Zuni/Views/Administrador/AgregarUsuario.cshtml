@model Zuni.Models.Administrador.AgregarUsuarioViewModel
@{
    ViewData["Title"] = "Agregar usuario";
}

<section class="container py-4 py-md-5" aria-labelledby="alta-title">
    <div class="mx-auto rounded-4 border shadow-sm p-4 p-md-5"
         style="max-width: 820px; background: linear-gradient(145deg, rgba(255,255,255,.92), rgba(237,232,208,.82)); color: #111111;">
        <h1 id="alta-title" class="h2 fw-bold mb-2">@Idioma.Texto("Agregar usuario")</h1>
        <p class="mb-4">@Idioma.Texto("La cuenta estará activa. El usuario deberá cambiar su contraseña temporal al iniciar sesión.")</p>
        <form asp-action="AgregarUsuario" method="post" autocomplete="off">
            <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
            <div class="mb-3">
                <label asp-for="NombreCompleto" class="form-label"></label>
                <input asp-for="NombreCompleto" class="form-control" maxlength="100" />
                <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Correo" class="form-label">@Idioma.Texto("Correo electrónico")</label>
                <input asp-for="Correo" type="email" class="form-control" placeholder="nombre@correo.com" />
                <span asp-validation-for="Correo" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Rol" class="form-label"></label>
                <select asp-for="Rol" class="form-select" required>
                    <option value="">@Idioma.Texto("Selecciona un rol...")</option>
                    @foreach (var rol in Zuni.Models.Administrador.AgregarUsuarioViewModel.RolesPermitidos)
                    {
                        <option value="@rol">@(rol == "Psicologo" ? Idioma.Texto("Psicólogo") : rol == "Catedratico" ? Idioma.Texto("Catedrático") : Idioma.Texto(rol))</option>
                    }
                </select>
                <span asp-validation-for="Rol" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MayorEdadDeclarada" class="form-label"></label>
                <select asp-for="MayorEdadDeclarada" class="form-select" required><option value="">@Idioma.Texto("Selecciona...")</option><option value="true">@Idioma.Texto("Mayor de edad (18 años o más)")</option><option value="false">@Idioma.Texto("Menor de edad")</option></select>
                <span asp-validation-for="MayorEdadDeclarada" class="text-danger small"></span>
                <p class="form-text">@Idioma.Texto("Clasificación administrativa. No sustituye la verificación de edad ni habilita la atención a menores.")</p>
            </div>
            <fieldset id="carne-estudiante" class="mb-3">
                <legend class="fs-6" zuni-required="@(Model.Rol == "Estudiante")" data-required-conditional>@Idioma.Texto("Carné institucional (solo Estudiante)")</legend>
                <p class="small">@Idioma.Texto("Último bloque de 2 a 6 dígitos: 1590-18-25 o 7490-26-125678.")</p>
                <div class="d-flex align-items-center gap-2">
                    <input asp-for="CarneParte1" class="form-control" aria-label="@Idioma.Texto("Primer bloque del carné")" placeholder="0000" inputmode="numeric" maxlength="4" pattern="[0-9]{4}" />
                    <span aria-hidden="true">−</span>
                    <input asp-for="CarneParte2" class="form-control" aria-label="@Idioma.Texto("Segundo bloque del carné")" placeholder="00" inputmode="numeric" maxlength="2" pattern="[0-9]{2}" />
                    <span aria-hidden="true">−</span>
                    <input asp-for="CarneParte3" class="form-control" aria-label="@Idioma.Texto("Tercer bloque del carné")" placeholder="0000" inputmode="numeric" minlength="2" maxlength="6" pattern="[0-9]{2,6}" />
                </div>
                <span asp-validation-for="CarneParte1" class="text-danger small"></span>
            </fieldset>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="ContrasenaTemporal" class="form-label"></label>
                    <input asp-for="ContrasenaTemporal" class="form-control" autocomplete="new-password" minlength="8" maxlength="100" />
                    <span asp-validation-for="ContrasenaTemporal" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmarContrasenaTemporal" class="form-label"></label>
                    <input asp-for="ConfirmarContrasenaTemporal" class="form-control" autocomplete="new-password" minlength="8" maxlength="100" />
                    <span asp-validation-for="ConfirmarContrasenaTemporal" class="text-danger small"></span>
                </div>
            </div>
            <p class="small">@Idioma.Texto("La contraseña temporal no volverá a mostrarse después de crear la cuenta.")</p>
            <div class="mb-4">
                <label asp-for="Motivo" class="form-label">@Idioma.Texto("Motivo (opcional)")</label>
                <textarea asp-for="Motivo" class="form-control" rows="3" maxlength="500" aria-describedby="motivo-ayuda"></textarea>
                <div id="motivo-ayuda" class="form-text">@Idioma.Texto("No incluyas contraseñas ni información sensible. Máximo 500 caracteres.")</div>
                <span asp-validation-for="Motivo" class="text-danger small"></span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="dash-button px-4">@Idioma.Texto("Crear usuario")</button>
                <a asp-action="Index" class="btn btn-outline-dark px-4">@Idioma.Texto("Cancelar")</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const rol = document.getElementById('Rol');
            const carne = document.getElementById('carne-estudiante');
            const actualizar = () => {
                const estudiante = rol.value === 'Estudiante';
                carne.hidden = !estudiante;
                carne.disabled = !estudiante;
                carne.querySelectorAll('input').forEach(input => input.required = estudiante);
            };
            carne.querySelectorAll('input').forEach(input => {
                input.addEventListener('input', () => input.value = input.value.replace(/[^0-9]/g, ''));
            });
            rol.addEventListener('change', actualizar);
            actualizar();
        })();
    </script>
}
