@model IReadOnlyList<Zuni.Models.MayoriaEdad.RevisionEdadResumen>
@{ ViewData["Title"] = "Verificar mayoría de edad"; var pagina = (int)ViewData["Pagina"]!; var paginas = (int)ViewData["Paginas"]!; }
<header class="dash-profile-heading"><div><h1>Verificar mayoría de edad</h1><p>Revisa identidad y edad sin acceder al expediente psicológico.</p></div></header>
@foreach (var tipo in new[] { "Success", "Error" }) { if (TempData[tipo] is string mensaje) { <p class="dash-notice" role="status">@mensaje</p> } }
<section class="dash-card p-4">
    @if (Model.Count == 0) { <p>No hay declaraciones para revisar. Cada estudiante inicia el trámite desde Mayoría de edad.</p> }
    else
    {
        <div class="table-responsive"><table class="table"><thead><tr><th>Estudiante</th><th>Correo</th><th>Estado</th><th>Acción</th></tr></thead><tbody>
        @foreach (var item in Model) { <tr><td>@item.Estudiante</td><td>@item.Correo</td><td>@(item.Estado == Zuni.Models.MayoriaEdad.EstadoMayoriaEdad.Pendiente ? "Declarada, pendiente de verificación" : item.Estado == Zuni.Models.MayoriaEdad.EstadoMayoriaEdad.Verificada ? "Verificada" : "No verificada")</td><td><a asp-action="Revisar" asp-route-id="@item.PerfilEstudianteId">Revisar documento</a></td></tr> }
        </tbody></table></div>
        <p>Página @pagina de @paginas</p>
        @if (pagina > 1) { <a asp-action="Revisiones" asp-route-pagina="@(pagina - 1)">Anterior</a> }
        @if (pagina < paginas) { <a asp-action="Revisiones" asp-route-pagina="@(pagina + 1)">Siguiente</a> }
    }
</section>
