@model IReadOnlyList<Zuni.Models.Informes.InformeResumen>
@{ ViewData["Title"] = "Informes educativos"; }
<header class="dash-profile-heading"><div><h1>Informes educativos</h1><p>Recomendaciones para el apoyo educativo con autorización por versión y destinatario.</p></div></header>
@if (TempData["Error"] is string m) { <p class="dash-notice" role="alert">@m</p> }
<section class="dash-card p-4">
@if (ViewData["PuedeCrear"] is true) { <p>Para preparar un informe, abre el expediente de un estudiante asignado y selecciona Crear informe educativo.</p><a asp-controller="Psicologo" asp-action="Estudiantes">Ver estudiantes asignados</a> }
@if (Model.Count == 0) { <p>No hay informes disponibles para tu cuenta.</p> }
<div class="table-responsive"><table class="table"><thead><tr><th>Estudiante</th><th>Versión</th><th>Estado</th><th>Acción</th></tr></thead><tbody>
@foreach (var v in Model) { <tr><td>@v.Estudiante</td><td>@v.Numero</td><td>@v.Estado</td><td><a asp-action="Detalle" asp-route-id="@v.Id">Ver informe</a></td></tr> }
</tbody></table></div></section>
